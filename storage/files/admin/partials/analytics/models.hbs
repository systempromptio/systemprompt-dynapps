{{!--
  Models tab. One row per model the gateway served, plus the `unrouted` bucket
  for requests rejected before a route was chosen — never dropped.
--}}
<section aria-label="Model usage">
    {{> analytics/kpi-row tiles=models.kpis}}

    {{#> components/section title="Models" count=models.model_count note=models.total_display}}
      {{#*inline "actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/gateway">Gateway routes</a>
      {{/inline}}
    {{/components/section}}

    {{#if models.has_rows}}
    {{#> components/table caption="Gateway requests, tokens, cost and latency by model"}}
        <thead><tr>
            <th scope="col">Model</th>
            <th scope="col">Provider</th>
            <th scope="col" class="sp-table__cell--num" aria-sort="descending">Requests</th>
            <th scope="col" class="sp-table__cell--spark">Share</th>
            <th scope="col" class="sp-table__cell--num">In</th>
            <th scope="col" class="sp-table__cell--num">Out</th>
            <th scope="col" class="sp-table__cell--num">Cache</th>
            <th scope="col" class="sp-table__cell--num">Reasoning</th>
            <th scope="col" class="sp-table__cell--num">Cost</th>
            <th scope="col" class="sp-table__cell--num">p50</th>
            <th scope="col" class="sp-table__cell--num">p95</th>
            <th scope="col" class="sp-table__cell--num">Errors</th>
            <th scope="col" class="sp-table__cell--num" title="Requests whose requested model differed from the one that served them">Redirects</th>
        </tr></thead>
        <tbody>
        {{#each models.rows}}
        <tr>
            <td class="sp-table__cell--mono">
                <a href="{{this.drill_url}}">{{this.model}}</a>
                {{#if this.is_unrouted}} {{> components/badge tone="err" text="REJECTED"}}{{/if}}
            </td>
            <td>{{this.provider_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.requests}}</td>
            <td class="sp-table__cell--spark"><span class="sp-share-bar" style="--v:{{this.share_pct}}%"></span></td>
            <td class="sp-table__cell--num sp-u-num">{{this.input_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.output_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.cache_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.reasoning_display}}</td>
            <td class="sp-table__cell--num sp-u-mono">{{this.cost_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.p50_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.p95_display}}</td>
            <td class="sp-table__cell--num">{{> components/badge tone=this.error_tone text=this.error_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.redirected_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No model traffic"
        message="No gateway requests in this window. Widen the time range or clear the scope."}}
    {{/if}}

    {{#> components/section title="Route redirects" count=models.redirect_count
        note="Requests whose requested model differed from the model that served them."}}{{/components/section}}
    {{#if models.has_redirects}}
    {{#> components/table caption="Requested model versus served model"}}
        <thead><tr>
            <th scope="col">Requested</th>
            <th scope="col">Served</th>
            <th scope="col" class="sp-table__cell--num" aria-sort="descending">Requests</th>
        </tr></thead>
        <tbody>
        {{#each models.redirects}}
        <tr>
            <td class="sp-table__cell--mono">{{this.requested_model}}</td>
            <td class="sp-table__cell--mono"><a href="{{this.drill_url}}">{{this.served_model}}</a></td>
            <td class="sp-table__cell--num sp-u-num">{{this.requests}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="No route rewrote a model in this window."}}
    {{/if}}
</section>
