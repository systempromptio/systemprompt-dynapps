{{!--
  Sessions tab. Every number is the client's own statusline total, not a
  gateway measurement, and the header says so rather than hiding it in a note.
--}}
<section aria-label="Session cost and quality">
    {{> analytics/kpi-row tiles=sessions.kpis}}

    {{#> components/section title="Sessions"
        sub="Client-reported cost and context-window totals, most expensive first."}}
      {{#*inline "actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/sessions">Session log</a>
      {{/inline}}
    {{/components/section}}

    {{#if sessions.has_rows}}
    {{#> components/table caption="Client-reported session cost, tokens and rating"
         pagination=sessions.pagination}}
        <thead><tr>
            <th scope="col" aria-sort="none">Session</th>
            <th scope="col">User</th>
            <th scope="col">Model</th>
            <th scope="col" class="sp-table__cell--num" aria-sort="descending">Cost</th>
            <th scope="col" class="sp-table__cell--spark">Share</th>
            <th scope="col" class="sp-table__cell--num">Context</th>
            <th scope="col" class="sp-table__cell--num">In</th>
            <th scope="col" class="sp-table__cell--num">Out</th>
            <th scope="col" class="sp-table__cell--num">Cache read</th>
            <th scope="col" class="sp-table__cell--num">Rating</th>
            <th scope="col">Outcome</th>
            <th scope="col" class="sp-table__cell--date">Updated</th>
        </tr></thead>
        <tbody>
        {{#each sessions.rows}}
        <tr>
            <td class="sp-table__cell--mono"><a href="{{this.detail_url}}">{{this.session_short}}</a></td>
            <td><a href="{{this.user_url}}">{{this.user_id}}</a></td>
            <td class="sp-table__cell--mono">{{this.model_display}}</td>
            <td class="sp-table__cell--num sp-u-mono">{{this.cost_display}}</td>
            <td class="sp-table__cell--spark"><span class="sp-share-bar" style="--v:{{this.share_pct}}%"></span></td>
            <td class="sp-table__cell--num sp-u-num">{{this.context_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.input_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.output_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.cache_display}}</td>
            <td class="sp-table__cell--num sp-u-num">{{this.rating_display}}</td>
            <td>{{this.outcome_display}}</td>
            <td class="sp-table__cell--date">{{this.updated_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No session snapshots"
        message="No client reported a session cost in this window. The statusline hook writes these, so an instance with no Claude Code clients attached has none."}}
    {{/if}}
</section>
