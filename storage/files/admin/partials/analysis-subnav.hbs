{{!--
  The analysis section strip. Reads `page` from the rendering context, so a
  page includes it with no parameters: {{> analysis-subnav}}
--}}
<nav class="sp-breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin/analysis/resources">Analysis</a>
    <span class="sp-breadcrumbs__sep" aria-hidden="true">›</span>
    <span aria-current="page">{{#if (eq page "analysis-portfolio")}}Skills{{else}}{{#if (eq page "analysis-skills")}}Conversations{{else}}{{#if (eq page "analysis-versions")}}{{#if marketplace_id}}<a href="/admin/analysis/versions">Versions</a> <span class="sp-breadcrumbs__sep" aria-hidden="true">›</span> {{name}}{{else}}Versions{{/if}}{{else}}{{#if (eq page "analysis-revision")}}Revision{{else}}{{#if (eq page "analysis-evaluation")}}Evaluation{{else}}{{#if (eq page "analysis-evaluation-runs")}}Judge runs{{else}}{{#if (eq page "analysis-evaluation-run")}}Judge run{{else}}Analysis{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}</span>
</nav>
<div class="sp-analysis-strip">
<nav class="sp-tabs" role="tablist" aria-label="Analysis views">
    <a class="sp-tab{{#if (eq page "analysis-portfolio")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-portfolio")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-portfolio")}} aria-current="page"{{/if}} href="/admin/analysis/resources">Skills</a>
    <a class="sp-tab{{#if (eq page "analysis-skills")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-skills")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-skills")}} aria-current="page"{{/if}} href="/admin/analysis/skills">Conversations</a>
    <a class="sp-tab{{#if (eq page "analysis-versions")}} sp-tab--active{{else}}{{#if (eq page "analysis-revision")}} sp-tab--active{{/if}}{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-versions")}}true{{else}}{{#if (eq page "analysis-revision")}}true{{else}}false{{/if}}{{/if}}"{{#if (eq page "analysis-versions")}} aria-current="page"{{/if}} href="/admin/analysis/versions">Versions</a>
    <a class="sp-tab{{#if (eq page "analysis-evaluation")}} sp-tab--active{{else}}{{#if (eq page "analysis-evaluation-runs")}} sp-tab--active{{else}}{{#if (eq page "analysis-evaluation-run")}} sp-tab--active{{/if}}{{/if}}{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-evaluation")}}true{{else}}{{#if (eq page "analysis-evaluation-runs")}}true{{else}}{{#if (eq page "analysis-evaluation-run")}}true{{else}}false{{/if}}{{/if}}{{/if}}"{{#if (eq page "analysis-evaluation")}} aria-current="page"{{/if}} href="/admin/analysis/evaluation">Evaluation</a>
</nav>
<a class="sp-btn sp-btn--xs sp-btn--outline sp-analysis-strip__guide" href="/documentation/analysis" target="_blank" rel="noopener" title="Open the Analysis guide in a new tab">Guide</a>
</div>
