{{!--
  The analysis section strip. Reads `page` from the rendering context, so a
  page includes it with no parameters: {{> analysis-subnav}}
--}}
<nav class="sp-breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin/analysis/resources">Analysis</a>
    <span class="sp-breadcrumbs__sep" aria-hidden="true">›</span>
    <span aria-current="page">{{#if (eq page "analysis-portfolio")}}Skills{{else}}{{#if (eq page "analysis-skills")}}Conversations{{else}}{{#if (eq page "analysis-versions")}}Versions{{else}}{{#if (eq page "analysis-campaigns")}}Campaigns{{else}}{{#if (eq page "analysis-evaluations")}}Experiments{{else}}{{#if (eq page "analysis-impact")}}Impact{{else}}{{#if (eq page "analysis-publications")}}Publication{{else}}{{#if (eq page "analysis-comparison")}}Comparison{{else}}{{#if (eq page "analysis-revisions")}}Revisions{{else}}{{#if (eq page "analysis-revision")}}Revision{{else}}{{#if (eq page "analysis-experiment")}}Experiment{{else}}{{#if (eq page "analysis-candidate")}}Candidate{{else}}{{#if (eq page "analysis-holdout")}}Holdout{{else}}{{#if (eq page "analysis-generation-compare")}}Generation compare{{else}}{{#if (eq page "analysis-evaluation-preflight")}}Preflight{{else}}Analysis{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}</span>
</nav>
<nav class="sp-tabs" role="tablist" aria-label="Analysis views">
    <a class="sp-tab{{#if (eq page "analysis-portfolio")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-portfolio")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-portfolio")}} aria-current="page"{{/if}} href="/admin/analysis/resources">Skills</a>
    <a class="sp-tab{{#if (eq page "analysis-skills")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-skills")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-skills")}} aria-current="page"{{/if}} href="/admin/analysis/skills">Conversations</a>
    <a class="sp-tab{{#if (eq page "analysis-versions")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-versions")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-versions")}} aria-current="page"{{/if}} href="/admin/analysis/versions">Versions</a>
    <a class="sp-tab{{#if (eq page "analysis-campaigns")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-campaigns")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-campaigns")}} aria-current="page"{{/if}} href="/admin/analysis/campaigns">Campaigns</a>
    <a class="sp-tab{{#if (eq page "analysis-evaluations")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-evaluations")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-evaluations")}} aria-current="page"{{/if}} href="/admin/analysis/evaluations">Experiments</a>
    <a class="sp-tab{{#if (eq page "analysis-impact")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-impact")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-impact")}} aria-current="page"{{/if}} href="/admin/analysis/impact">Impact</a>
    <a class="sp-tab{{#if (eq page "analysis-publications")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-publications")}}true{{else}}false{{/if}}"{{#if (eq page "analysis-publications")}} aria-current="page"{{/if}} href="/admin/analysis/publications">Publication</a>
</nav>
