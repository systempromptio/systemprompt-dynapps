{{!--
  The analysis section strip. Reads `page` from the rendering context, so a
  page includes it with no parameters: {{> analysis-subnav}}
--}}
<nav class="sp-tabs" role="tablist" aria-label="Analysis views">
    <a class="sp-tab{{#if (eq page "analysis-portfolio")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-portfolio")}}true{{else}}false{{/if}}" href="/admin/analysis/resources">Resource effectiveness</a>
    <a class="sp-tab{{#if (eq page "analysis-skills")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-skills")}}true{{else}}false{{/if}}" href="/admin/analysis/skills">Skill conversations</a>
    <a class="sp-tab{{#if (eq page "analysis-campaigns")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-campaigns")}}true{{else}}false{{/if}}" href="/admin/analysis/campaigns">Campaigns</a>
    <a class="sp-tab{{#if (eq page "analysis-versions")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-versions")}}true{{else}}false{{/if}}" href="/admin/analysis/versions">Baselines</a>
    <a class="sp-tab{{#if (eq page "analysis-evaluations")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-evaluations")}}true{{else}}false{{/if}}" href="/admin/analysis/evaluations">Experiments</a>
    <a class="sp-tab{{#if (eq page "analysis-impact")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-impact")}}true{{else}}false{{/if}}" href="/admin/analysis/impact">Version impact</a>
    <a class="sp-tab{{#if (eq page "analysis-publications")}} sp-tab--active{{/if}}" role="tab" aria-selected="{{#if (eq page "analysis-publications")}}true{{else}}false{{/if}}" href="/admin/analysis/publications">Publication</a>
</nav>
