{{!--
  The document export every conversation reader carries: the whole record —
  message bodies, tool calls with input and result, governance decisions,
  scanner findings, hook events — as JSON or as a Markdown transcript, and for
  a list or a session the same as JSON Lines, one conversation per line.

  Invoke as: {{> components/export-document document_export}}
  The partial's root context is the page's `document_export` view.
--}}
{{#if jsonl_href}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{jsonl_href}}" title="Every conversation in this set with its message bodies, tool calls, decisions, findings and hook events — one JSON object per line">{{label}} (JSONL)</a>{{else}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{json_href}}" title="This conversation with its message bodies, tool calls, decisions, findings and hook events">{{label}} (JSON)</a> <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{markdown_href}}" title="The same record laid out as a readable transcript">Markdown</a>{{/if}}
