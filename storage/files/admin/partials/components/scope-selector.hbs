{{!--
  The AI-activity scope bar: who the rows are about, and over what window.

  Rendered by `layout.hbs` on any page the shell flags with `scope_selector`
  (derived from the page id in `handlers/ssr/context.rs`), so a page opts in by
  being an AI-activity listing rather than by setting a field.

  Reads the page's own `scope_filter` context — the same one
  `components/scope-filter` reads, so a page that already builds it gets the
  bar for free and one that does not still gets the time range.

  Without JS every control is a plain form or link and works, losing only the
  other query parameters. `js/services/scope.js` preserves them and carries the
  choice on to the other AI-activity pages.
--}}
<form class="sp-scope-filter" method="get" action="{{scope_filter.base_url}}"
      data-scope-selector aria-label="Scope and time range">
    {{#each scope_filter.hidden}}
    <input type="hidden" name="{{this.name}}" value="{{this.value}}">
    {{/each}}

    {{#if scope_filter.show}}
    <label class="sp-scope-filter__field">
        <span class="sp-scope-filter__label">Group</span>
        <select name="group" class="sp-scope-filter__select" data-scope-key="group">
            {{#each scope_filter.groups}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </label>
    <label class="sp-scope-filter__field">
        <span class="sp-scope-filter__label">Project</span>
        <select name="project" class="sp-scope-filter__select" data-scope-key="project">
            {{#each scope_filter.projects}}
            <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </label>
    {{/if}}

    <div class="sp-scope-filter__ranges" role="group" aria-label="Time range">
        <a class="sp-scope-filter__range" data-scope-range="24h" href="?preset=24h">24h</a>
        <a class="sp-scope-filter__range" data-scope-range="7d" href="?preset=7d">7d</a>
        <a class="sp-scope-filter__range" data-scope-range="30d" href="?preset=30d">30d</a>
    </div>

    <button type="submit" class="sp-scope-filter__apply">Apply</button>
</form>
