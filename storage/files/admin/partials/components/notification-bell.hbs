<div class="sp-bell" data-notification-bell data-inbox-api="/api/v1/notifications" data-live-stream="/api/v1/stream/agui">
    <button class="sp-bell__button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="sp-bell-panel" aria-label="Notifications" data-action="bell-toggle">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="sp-bell__count" data-slot="bell-count" hidden></span>
    </button>
    <div class="sp-bell__panel" id="sp-bell-panel" role="dialog" aria-label="Notifications" hidden>
        <div class="sp-bell__head">
            <h2 class="sp-bell__title">Notifications</h2>
            <button class="sp-btn sp-btn--xs sp-btn--ghost" type="button" data-action="bell-read-all">Mark all read</button>
        </div>
        <ol class="sp-bell__list" data-slot="bell-list"></ol>
        <p class="sp-bell__empty" data-slot="bell-empty">Nothing yet.</p>
    </div>
    <template data-template="bell-item">
        <li class="sp-bell__item">
            <a class="sp-bell__link" data-field="link">
                <span class="sp-bell__text" data-field="text"></span>
                <span class="sp-bell__excerpt" data-field="excerpt"></span>
                <span class="sp-bell__meta"><span class="sp-bell__attention" data-field="attention"></span><span class="sp-bell__time" data-field="time"></span></span>
            </a>
        </li>
    </template>
</div>
