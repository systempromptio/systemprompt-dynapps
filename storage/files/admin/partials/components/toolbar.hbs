{{!--
  Toolbar row above a table. Fill the slots you need:

    {{#> components/toolbar count="1,204 requests"}}
      {{#*inline "toolbar_filters"}}…selects…{{/inline}}
      {{#*inline "toolbar_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{csv_url}}">Export CSV</a>{{/inline}}
    {{/components/toolbar}}
--}}
<div class="sp-toolbar">
  {{#if count}}<span class="sp-toolbar__count">{{count}}</span>{{/if}}
  {{#> toolbar_filters}}{{/toolbar_filters}}
  <div class="sp-toolbar__actions">{{#> toolbar_actions}}{{/toolbar_actions}}</div>
</div>
