{{!--
  One KPI tile. Pass `href` to make the tile the filter its number describes;
  `active` marks that filter as applied. `tone` is ok | warn | err | accent and
  paints the inline-start bar only.

    {{> components/kpi label="Denied" value=denied tone="err"
        unit="calls" sub="of 1,204 in window" href=denied_url}}
--}}
{{#if href}}
<a class="sp-kpi sp-kpi--link{{#if tone}} sp-kpi--{{tone}}{{/if}}{{#if active}} is-active{{/if}}"
   href="{{href}}"{{#if hint}} title="{{hint}}"{{/if}}>
{{else}}
<div class="sp-kpi{{#if tone}} sp-kpi--{{tone}}{{/if}}"{{#if hint}} title="{{hint}}"{{/if}}>
{{/if}}
    <span class="sp-kpi__label">{{label}}</span>
    <span class="sp-kpi__value"{{#if testid}} data-testid="{{testid}}"{{/if}}>{{value}}{{#if unit}}<span class="sp-kpi__unit">{{unit}}</span>{{/if}}</span>
    {{#if sub}}<span class="sp-kpi__sub">{{sub}}</span>{{/if}}
    {{#if subtitle}}<span class="sp-kpi__sub">{{subtitle}}</span>{{/if}}
    {{#if delta}}<span class="sp-delta{{#if delta_dir}} sp-delta--{{delta_dir}}{{/if}}">{{delta}}</span>{{/if}}
{{#if href}}</a>{{else}}</div>{{/if}}
