{{!-- One farm run row. Usage: {{#each rows}}{{> farm/run-row this}}{{/each}} inside a sp-table tbody.
     Pass cancel=true to add an eleventh cell holding the Cancel form (the overview's running board). --}}
<tr class="sp-table__row sp-farm-run-row" data-run-id="{{run_id}}" data-run-status="{{status.key}}">
  <td title="{{started_local}}">{{started_relative}}</td>
  <td class="sp-table__cell--mono"><a class="sp-link" href="{{detail_url}}">{{run_id_short}}</a></td>
  <td><a class="sp-link" href="{{farm_url}}">{{farm_id}}</a> › <a class="sp-link" href="{{agent_url}}">{{agent_id}}</a></td>
  <td><a class="sp-link" href="{{user_url}}">{{user_id}}</a></td>
  <td>{{> components/badge tone=trigger.tone text=trigger.text}}</td>
  <td>{{> components/badge tone=status.tone text=status.text}}</td>
  <td class="sp-table__cell--num">{{turns}}</td>
  <td class="sp-table__cell--num">{{tokens_display}}</td>
  <td class="sp-table__cell--num">{{cost_display}}</td>
  <td class="sp-table__cell--num">{{duration_display}}</td>
  {{#if cancel}}<td>{{#if is_live}}<form method="post" action="/admin/farm/runs/{{run_id}}/cancel" class="sp-farm-run-row__cancel"><button class="sp-btn sp-btn--xs sp-btn--outline" type="submit" title="Ask the runner to stop this run">Cancel</button></form>{{/if}}</td>{{/if}}
</tr>
