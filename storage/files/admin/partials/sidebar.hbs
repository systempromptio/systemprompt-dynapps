{{!--
  Admin navigation: six groups, in the order an operator moves through them —
  what happened (Overview), who it happened to (People & access), what the AI
  did (AI activity), what the policy said (Governance), what is installed
  (Platform), and the signed-in person themselves (Account).

  Active state: `{{navActive page "id" "id"}}` emits the active attributes when
  the current page id is one of the listed ones. `/admin` and `/admin/analytics`
  render the same page id, so `services/sidebar.js` corrects the pair from the
  exact pathname once JS is up.
--}}
<aside class="sp-admin-sidebar" id="sp-admin-sidebar">
    <button class="sp-sidebar-close-btn" type="button" aria-label="Close menu">&times;</button>
    <a href="/admin" class="sp-admin-sidebar-brand" aria-label="{{default branding.domain "astounddigital.com"}} - Go to admin">
        <img src="{{default branding.logo_light "/files/images/logo.svg"}}" alt="{{default branding.domain "astounddigital.com"}}" class="sp-admin-logo sp-admin-logo--light" />
        <img src="{{default branding.logo_dark "/files/images/logo-white.svg"}}" alt="{{default branding.domain "astounddigital.com"}}" class="sp-admin-logo sp-admin-logo--dark" />
    </a>
    <nav aria-label="Admin navigation" data-nav>

        {{#if current_user.is_console}}
        <h2 class="sp-nav-label">Overview</h2>
        <a href="/admin"{{navActive page "overview"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
            Overview
        </a>

        {{!-- PEOPLE & ACCESS — the accounts, the groups that carry their
             entitlement, and the rules that bind the two together. --}}
        <h2 class="sp-nav-label">People &amp; access</h2>
        <a href="/admin/users"{{navActive page "users" "user-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="5" r="2.5"/><path d="M1.5 13.5c0-2.5 2-4.5 4.5-4.5s4.5 2 4.5 4.5"/><path d="M11 3.2a2.5 2.5 0 010 4.6M12.5 13.5c0-1.6-.5-3-1.4-4" stroke-linecap="round"/></svg>
            Users
            {{#if marketplace.unassigned_count}}<span class="sp-nav-badge" title="Unassigned users">{{marketplace.unassigned_count}}</span>{{/if}}
        </a>
        <a href="/admin/groups"{{navActive page "groups" "group-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5" cy="6" r="2"/><circle cx="11" cy="6" r="2"/><path d="M1.5 13c0-2 1.6-3.5 3.5-3.5S8.5 11 8.5 13M7.5 13c0-2 1.6-3.5 3.5-3.5s3.5 1.5 3.5 3.5"/></svg>
            Groups
        </a>
        <a href="/admin/projects"{{navActive page "projects" "project-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4.5h4l1.2 1.5H14v6.5H2z" stroke-linejoin="round"/></svg>
            Projects
        </a>
        <a href="/admin/roles"{{navActive page "roles" "role-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1.5l5 2v4c0 3-2 5.4-5 7-3-1.6-5-4-5-7v-4z" stroke-linejoin="round"/></svg>
            Roles &amp; permissions
        </a>
        <a href="/admin/access-control"{{navActive page "access-control"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="7" width="10" height="7" rx="1"/><path d="M5.5 7V4.5a2.5 2.5 0 015 0V7" stroke-linecap="round"/></svg>
            Access control
        </a>
        <a href="/admin/devices"{{navActive page "devices" "device-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="8" rx="1"/><path d="M5.5 13.5h5" stroke-linecap="round"/></svg>
            Devices &amp; enrolments
        </a>

        {{!-- AI ACTIVITY — what the models actually did. Every page in this
             group honours the same `?scope=`/`?range=` contract, which is why
             they are one group rather than filed by entity. --}}
        <h2 class="sp-nav-label">AI activity</h2>
        <a href="/admin/analytics" data-scope-nav{{navActive page "analytics-dashboard" "analytics-user"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 13h12M3.5 13V8.5M7 13V4.5M10.5 13V6.5M14 13V3" stroke-linecap="round"/></svg>
            Analytics
        </a>
        <a href="/admin/requests" data-scope-nav{{navActive page "requests" "request-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8a6 6 0 0112 0M14 8a6 6 0 01-12 0M5 8l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Requests
        </a>
        <a href="/admin/sessions" data-scope-nav{{navActive page "sessions" "session-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M8 4.5V8l2.5 1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sessions
        </a>
        <a href="/admin/traces" data-scope-nav{{navActive page "traces" "trace-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4h6M2 8h10M2 12h4" stroke-linecap="round"/><circle cx="13" cy="4" r="1.5" fill="currentColor"/><circle cx="13" cy="12" r="1.5" fill="currentColor"/></svg>
            Traces
        </a>
        <a href="/admin/contexts" data-scope-nav{{navActive page "contexts" "context-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3h12v1H2zm0 3h10v1H2zm0 3h12v1H2zm0 3h8v1H2z"/></svg>
            Contexts
        </a>

        {{!-- GOVERNANCE — what the policy chain decided, and what it is still
             waiting on a human for. --}}
        <h2 class="sp-nav-label">Governance</h2>
        <a href="/admin/governance"{{navActive page "governance-warnings" "governance-decisions"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2l6 11H2z" stroke-linejoin="round"/><path d="M8 6.5v3M8 11.5v.01" stroke-linecap="round"/></svg>
            Governance
        </a>
        <a href="/admin/governance/approvals"{{navActive page "governance-approvals"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8.2l2 2 3.6-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Approvals
        </a>
        <a href="/admin/governance/secrets"{{navActive page "governance-secrets"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="6" r="3"/><path d="M8 9v4M6.5 11.5h3" stroke-linecap="round"/></svg>
            Secrets audit
        </a>

        {{!-- PLATFORM — the installable units declared in services/*.yaml, and
             the gateway that routes to them. --}}
        <h2 class="sp-nav-label">Platform</h2>
        <a href="/admin/mcp"{{navActive page "mcp" "mcp-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="4" rx="1"/><rect x="2" y="9" width="12" height="4" rx="1"/><path d="M5 5h.01M5 11h.01" stroke-linecap="round"/></svg>
            MCP servers
        </a>
        <a href="/admin/marketplaces"{{navActive page "marketplaces" "marketplace-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 5.5h12L13 13H3z" stroke-linejoin="round"/><path d="M5.5 5.5V4a2.5 2.5 0 015 0v1.5" stroke-linecap="round"/></svg>
            Marketplaces
        </a>
        <a href="/admin/plugins"{{navActive page "plugins" "plugin-detail" "catalog"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M3 3h4v4H3zM9 3h4v4H9zM3 9h4v4H3zM9 9h4v4H9z"/></svg>
            Plugins
        </a>
        <a href="/admin/skills"{{navActive page "skills" "skill-detail"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1.5l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.3 4.2 13.3l.7-4.3-3.1-3 4.3-.6z" stroke-linejoin="round"/></svg>
            Skills
        </a>
        <a href="/admin/gateway"{{navActive page "gateway"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8h12" stroke-linecap="round"/><circle cx="5" cy="8" r="2"/><circle cx="11" cy="8" r="2"/></svg>
            Gateway
        </a>
        {{/if}}

        {{!-- ACCOUNT — the signed-in person, not the business --}}
        <h2 class="sp-nav-label sp-nav-label--account">Account</h2>
        <a href="/admin/profile"{{navActive page "profile"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="5" r="3"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>
            Profile
        </a>
        <a href="/admin/history"{{navActive page "history" "history-conversation"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 3.5h11v8h-6l-2.5 2v-2h-2.5z" stroke-linejoin="round"/><path d="M5 6.5h6M5 9h4" stroke-linecap="round"/></svg>
            My conversations
        </a>
        <a href="/admin/settings"{{navActive page "settings" "setup"}}>
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4.754a3.246 3.246 0 100 6.492 3.246 3.246 0 000-6.492zM5.754 8a2.246 2.246 0 114.492 0 2.246 2.246 0 01-4.492 0z"/></svg>
            Settings
        </a>
        <a href="/documentation" target="_blank" rel="noopener noreferrer">
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M6 6a2 2 0 113.5 1.8c-.5.3-.5.5-.5 1.2M8 12v.5" stroke-linecap="round"/></svg>
            Help &amp; docs
            <span class="sp-nav-external" aria-hidden="true">↗</span>
        </a>
        <a href="https://discord.gg/wkAbSuPWpr" target="_blank" rel="noopener noreferrer">
            <svg class="sp-icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M13.5 3.4A13 13 0 0010.3 2.5a.05.05 0 00-.05.02c-.14.25-.3.57-.4.83a12 12 0 00-3.7 0 8 8 0 00-.42-.83.05.05 0 00-.05-.02A13 13 0 002.5 3.4a.04.04 0 00-.02.02C.9 6.1.5 8.7.7 11.3a.05.05 0 00.02.04 13.2 13.2 0 004 2 .05.05 0 00.06-.02c.3-.43.58-.88.82-1.35a.05.05 0 00-.03-.07 8.7 8.7 0 01-1.25-.6.05.05 0 01-.004-.08c.08-.06.17-.13.25-.19a.05.05 0 01.05-.01c2.6 1.2 5.4 1.2 8 0a.05.05 0 01.05 0c.08.07.17.13.25.2a.05.05 0 01-.003.08c-.4.23-.82.43-1.25.6a.05.05 0 00-.03.07c.24.47.52.92.82 1.35a.05.05 0 00.05.02 13.2 13.2 0 004-2 .05.05 0 00.02-.03c.24-2.56-.4-5.14-1.78-7.87a.04.04 0 00-.02-.02zM5.7 9.7c-.7 0-1.26-.63-1.26-1.4s.55-1.4 1.26-1.4c.7 0 1.27.64 1.26 1.4 0 .78-.56 1.4-1.26 1.4zm4.6 0c-.7 0-1.26-.63-1.26-1.4s.55-1.4 1.26-1.4c.7 0 1.27.64 1.26 1.4 0 .78-.55 1.4-1.26 1.4z"/></svg>
            Discord
            <span class="sp-nav-external" aria-hidden="true">↗</span>
        </a>
    </nav>
</aside>
