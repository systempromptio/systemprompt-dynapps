<template data-template="ws-avatar">
    <li class="sp-ws__person"><span class="sp-avatar sp-avatar--sm" data-field="initials" title=""></span></li>
</template>
<template data-template="ws-outline-item">
    <li class="sp-ws__outline-item"><button class="sp-ws__outline-link" type="button" data-field="text"></button></li>
</template>
<template data-template="ws-revision">
    <li class="sp-ws__entry">
        <span class="sp-ws__entry-title" data-field="message"></span>
        <span class="sp-ws__muted" data-field="meta"></span>
    </li>
</template>
