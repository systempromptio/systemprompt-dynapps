{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Non-interactive accounts a workflow definition acts as when it writes back to an external system. They never sign in; the broker issues their credential only to a workflow write-back or farm caller."}}
        {{#*inline "header_actions"}}
            {{#if can_manage}}<button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="create-service-account">New service account</button>{{/if}}
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-section sp-p-service-accounts" aria-label="Service accounts">
    {{#if rows}}
    {{#> components/table caption=count_label}}
      <thead><tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Credentials</th>
        <th scope="col">Bound definitions</th>
        <th scope="col" class="sp-col-date">Created</th>
      </tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td class="sp-table__cell--primary"><a class="sp-table__link" href="{{href}}">{{name}}</a></td>
          <td class="sp-u-mono">{{email}}</td>
          <td>{{#each credentials}}<span class="sp-p-service-accounts__credential" title="{{kind_label}}">{{provider}}</span>{{else}}<span class="sp-u-text-tertiary">None</span>{{/each}}</td>
          <td><span class="sp-u-text-tertiary" data-slot="bound-definitions">—</span></td>
          <td class="sp-col-date">{{created_at}}</td>
        </tr>
        {{/each}}
      </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state heading="No service accounts yet" message="Create one per farm or workflow definition that calls Odoo, then attach its machine credential."}}
    {{/if}}
    </section>

    {{#if can_manage}}
    <dialog class="sp-dialog" data-dialog="create-service-account" aria-label="New service account">
        <form class="sp-dialog-form" method="dialog">
            <h2 class="sp-section__title">New service account</h2>
            <label for="new-sa-name">Name</label>
            <input type="text" id="new-sa-name" class="sp-search-input" data-field="new-sa-name" placeholder="Release notes writer" autocomplete="off">
            <label for="new-sa-email">Email</label>
            <input type="email" id="new-sa-email" class="sp-search-input" data-field="new-sa-email" placeholder="release-notes@service.dynapps.be" autocomplete="off">
            <menu>
                <button type="button" class="sp-btn sp-btn--outline" data-action="close-create-service-account">Cancel</button>
                <button type="button" class="sp-btn sp-btn--primary" data-action="confirm-create-service-account">Create</button>
            </menu>
        </form>
    </dialog>
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-service-accounts.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
