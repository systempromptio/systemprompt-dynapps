{{#> layout title=title page=page}}{{#*inline "content"}}
{{> components/page-header title=title subtitle=experiment.name}}
<p><a href="/admin/analysis/evaluations">All experiments</a> · <a href="/api/public/admin/evals/experiments/{{experiment.id}}">Export experiment JSON</a></p>
<p>Status: {{experiment.status}}. Settled: {{experiment.settled}}. Reserved: {{experiment.reserved}}. Cap: {{experiment.cap}}.{{#if experiment.frozen}} Budget admission is frozen.{{/if}}</p>
<p>Reserved amounts include unresolved usage. Execution completion is separate from evaluation quality; consult evidence before judging a candidate.</p>
<div class="sp-table"><div class="sp-table__scroll"><table class="sp-table__el sp-analysis-table"><thead><tr><th>Case revision</th><th>Variant / repetition</th><th>Execution</th><th>Recorded outcome</th></tr></thead><tbody>
{{#each executions}}<tr><td>{{case_revision}}</td><td>{{variant}} / {{repetition}}</td><td>{{status}}<br><a href="/api/public/admin/evals/executions/{{id}}/evidence">Execution evidence</a></td><td>{{#if summary}}{{summary}}{{else}}No terminal outcome recorded{{/if}}</td></tr>{{else}}<tr><td colspan="4">No execution records.</td></tr>{{/each}}
</tbody></table></div></div>
<details><summary>Frozen experiment specification</summary><pre class="sp-analysis-file-preview"><code>{{specification}}</code></pre></details>
{{/inline}}{{/layout}}
