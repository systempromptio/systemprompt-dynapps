{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="Your identity, what you spend, what reaches you, and how to connect Claude Code to this gateway."}}
        {{#*inline "header_meta"}}
            <span class="sp-u-mono">{{identity.email}}</span>
            <span>{{#each identity.roles}}{{this}} {{/each}}</span>
            {{#if identity.provider}}<span>signed in via {{identity.provider}}</span>{{/if}}
            {{#if identity.tenant_id}}<span>tenant <code class="sp-u-mono">{{identity.tenant_id}}</code></span>{{/if}}
        {{/inline}}
        {{#*inline "header_actions"}}
            {{#if bridge_connect_available}}
            <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" id="issue-connect-code">Generate a connect code</button>
            {{/if}}
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/setup">Setup guide</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/settings">Settings</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/history">My conversations</a>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Your usage">
        {{!-- One spend tile, not three. Eight tiles wrapped to a second row and
              pushed the strip past the density bar, and the shorter windows are
              context for the headline number rather than three headlines. --}}
        {{> components/kpi label="Spend · 30d" value=(formatUsd usage.d30.cost_microdollars) note=(concat "7d " (formatUsd usage.d7.cost_microdollars) " · 24h " (formatUsd usage.d1.cost_microdollars)) delta=(deltaPct usage.d30.cost_microdollars usage.d30.previous_cost_microdollars)}}
        {{> components/kpi label="Tokens · 30d" value=(formatNumber usage.d30.tokens) note=(concat (formatNumber usage.d30.requests) " requests")}}
        {{> components/kpi label="Conversations" value=(formatNumber usage.conversations.total_conversations) note=(concat (formatNumber usage.conversations.total_ai_requests) " AI requests") href="/admin/history"}}
        {{> components/kpi label="Models used" value=models_count note="last 30 days"}}
        {{> components/kpi label="Agents enabled" value=agents.enabled note=(concat "of " agents.total " configured")}}
        {{> components/kpi label="Marketplaces" value=marketplaces_count note="reaching this account"}}
    </section>

    {{#unless identity.is_admin}}
    {{> components/notice tone="warn" title="You have user permissions"
        message="Admin pages, the systemprompt MCP server and the admin plugins are hidden. An operator promotes an account with `systemprompt admin users role promote`; sign out and back in afterwards, because the admin scope is minted with the token."}}
    {{/unless}}

    <section class="sp-p-profile__connections" id="connected-accounts" aria-label="Connected accounts" data-connected-accounts>
        {{#> components/section title="Connected accounts" note="Authorize once. Use the same account on every enrolled machine."}}
        {{/components/section}}
        <p data-connection-message role="status"></p>
        <div data-connection-list>
            {{#each connections.connections}}
            <article class="sp-card sp-p-profile__connection">
                <h3>{{provider}}</h3>
                <p>{{status}}{{#if account_name}} · {{account_name}}{{/if}}</p>
                {{#if resource_name}}<p>{{resource_name}}</p>{{/if}}
                {{#unless entitled}}<p>India Development marketplace access required.</p>{{/unless}}
                <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" disabled title="Waiting for an active login and account permissions">Connect</button>
            </article>
            {{/each}}
        </div>
        <noscript>Enable JavaScript to manage connected accounts.</noscript>
    </section>

    <section aria-label="Connect Claude Code">
        {{#> components/section title="Connect Claude Code on your machine" note="One-shot code, valid ten minutes, single use, issued only when you ask."}}
            {{#*inline "section_actions"}}
                <a class="sp-btn sp-btn--sm sp-btn--outline" href="/documentation/connect-claude-code">Walkthrough</a>
            {{/inline}}
        {{/components/section}}

        <div class="sp-card">
            <div class="sp-card__body">
            {{#if bridge_connect_available}}
                {{!-- One line, then silence. The long story about what the
                      installer writes is true and worth telling, but it is
                      three paragraphs a person reads once and then scrolls past
                      on every visit — so it lives inside the block the button
                      reveals, and the daily view keeps the tables above the fold. --}}
                <p class="sp-p-profile__lede">
                    Signs this machine in as <strong>{{identity.email}}</strong> and syncs your
                    organization's skills, plugins and MCP servers. Press
                    <em>Generate a connect code</em> above for the command and what it writes.
                </p>
                <p class="sp-p-profile__lede" id="connect-code-error" role="alert" hidden></p>

                <div id="connect-code-output" hidden>
                    <p class="sp-p-profile__lede">
                        It configures the whole machine, not one terminal:
                        <code class="sp-u-mono">astound-bridge</code> and Claude Code go to
                        <code class="sp-u-mono">~/.local/bin</code>, with a
                        <code class="sp-u-mono">~/.profile</code> block,
                        <code class="sp-u-mono">~/.claude/settings.json</code>, and two background
                        services. Nothing outside your home directory is touched, and
                        <code class="sp-u-mono">astound-bridge uninstall --purge</code> reverses all of it.
                    </p>
                    <p class="sp-p-profile__label">Linux &amp; WSL — one command</p>
                    <pre class="sp-p-profile__cmd"><code data-connect-field="install_command"></code></pre>
                    <p class="sp-p-profile__lede">Then run <code class="sp-u-mono">claude</code> in any terminal. Nothing to source: the installer writes <code class="sp-u-mono">~/.claude/settings.json</code>, which Claude Code reads on every run. If Claude Code's header says <code class="sp-u-mono">API Usage Billing</code> it is talking to Anthropic directly and nothing will appear in your usage.</p>

                    <p class="sp-p-profile__label">Windows — download and run</p>
                    <p class="sp-p-profile__lede">
                        Download <a href="/files/downloads/astound-bridge-windows.exe">astound-bridge-windows.exe</a>
                        (<a href="/files/downloads/astound-bridge-windows.exe.sha256">checksum</a>) and run it; paste the code when it asks.
                        SmartScreen may warn on first run — the binary is unsigned.
                    </p>
                    <pre class="sp-p-profile__cmd"><code>.\astound-bridge-windows.exe login --code <span data-connect-field="code"></span> --gateway <span data-connect-field="gateway"></span></code></pre>

                    <p class="sp-p-profile__label">macOS — not available yet</p>
                    <p class="sp-p-profile__lede">There is no macOS build. Run the Linux instructions inside a Linux VM or container, or ask an administrator to connect you another way.</p>

                    <details>
                        <summary class="sp-p-profile__label">Advanced — bridge already installed, or a checkout of this repository</summary>
                        <pre class="sp-p-profile__cmd"><code data-connect-field="login_command"></code></pre>
                        <pre class="sp-p-profile__cmd"><code data-connect-field="just_install_command"></code></pre>
                        <pre class="sp-p-profile__cmd"><code data-connect-field="just_login_command"></code></pre>
                        <pre class="sp-p-profile__cmd"><code data-connect-field="code"></code></pre>
                    </details>
                </div>
            {{else}}
                <p class="sp-p-profile__lede">
                    No gateway URL is configured, so a connect code cannot be minted here. An administrator
                    can issue one from the server with
                    <code class="sp-u-mono">systemprompt admin bridge issue-code --user-id {{identity.email}}</code>.
                </p>
            {{/if}}
            </div>
        </div>
    </section>

    <section aria-label="Model usage">
        {{> components/section title="Models you use" count=models_count note="Last 30 days, by token share."}}
        {{#if usage.top_models}}
        {{#> components/table caption="Models by token share over the last 30 days"}}
            <thead><tr>
                <th scope="col">Model</th>
                <th scope="col" aria-sort="descending" class="sp-table__cell--num">Share</th>
                <th scope="col" class="sp-table__cell--num">Tokens</th>
                <th scope="col" class="sp-table__cell--num">Requests</th>
                <th scope="col" class="sp-table__cell--num">Cost</th>
            </tr></thead>
            <tbody>
            {{#each usage.top_models}}
            <tr>
                <td class="sp-table__cell--mono">{{model}}</td>
                <td class="sp-table__cell--num sp-u-num">{{percent token_share}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber tokens}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber requests}}</td>
                <td class="sp-table__cell--num sp-u-num sp-u-mono">{{formatUsd cost_microdollars}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No model usage" message="Nothing has been billed to this account in the last 30 days. Connect Claude Code above, or call the gateway with a token."}}
        {{/if}}
    </section>

    <section aria-label="Recent conversations">
        {{#> components/section title="Recent conversations" count=usage.conversations.total_conversations note="Grouped by context id on incoming inference requests."}}
            {{#*inline "section_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/history">Search all</a>{{/inline}}
        {{/components/section}}
        {{#if usage.conversations.recent}}
        {{#> components/table caption="Your most recent conversations"}}
            <thead><tr>
                <th scope="col">Conversation</th>
                <th scope="col">Model</th>
                <th scope="col">Agent</th>
                <th scope="col" class="sp-table__cell--num">Requests</th>
                <th scope="col" aria-sort="descending" class="sp-table__cell--date">Last activity</th>
            </tr></thead>
            <tbody>
            {{#each usage.conversations.recent}}
            <tr>
                <td><a href="/admin/history/conversations/{{context_id}}" title="{{context_id}}">{{#if context_name}}{{context_name}}{{else}}{{shortId context_id 12}}{{/if}}</a></td>
                <td class="sp-table__cell--mono">{{default model "—"}}</td>
                <td>{{default agent_name "—"}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber ai_requests}}</td>
                <td class="sp-table__cell--date">{{relativeTime last_activity}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No conversations yet" message="Conversations are grouped by context id on incoming inference requests. Connect a client above to start one."}}
        {{/if}}
    </section>

    <section aria-label="Conversation breakdown">
        {{#> components/section title="Conversations by model" count=by_model_count}}{{/components/section}}
        {{#if usage.conversations.by_model}}
        {{#> components/table caption="Conversations grouped by model"}}
            <thead><tr>
                <th scope="col">Model</th>
                <th scope="col" class="sp-table__cell--num">Conversations</th>
                <th scope="col" aria-sort="descending" class="sp-table__cell--num">AI requests</th>
            </tr></thead>
            <tbody>
            {{#each usage.conversations.by_model}}
            <tr>
                <td class="sp-table__cell--mono">{{name}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber conversations}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber ai_requests}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state message="No conversations to group by model yet."}}
        {{/if}}

        {{#> components/section title="Conversations by agent" count=by_agent_count}}{{/components/section}}
        {{#if usage.conversations.by_agent}}
        {{#> components/table caption="Conversations grouped by agent"}}
            <thead><tr>
                <th scope="col">Agent</th>
                <th scope="col" class="sp-table__cell--num">Conversations</th>
                <th scope="col" aria-sort="descending" class="sp-table__cell--num">AI requests</th>
            </tr></thead>
            <tbody>
            {{#each usage.conversations.by_agent}}
            <tr>
                <td>{{name}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber conversations}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber ai_requests}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state message="No per-agent activity yet. Agents record conversations once one answers on your behalf."}}
        {{/if}}
    </section>

    <section aria-label="Identity and gateway">
        {{> components/section title="Identity and gateway" note="What this session is, and which gateway signs for it."}}
        {{#> components/table caption="Identity and gateway facts for this account"}}
            <thead><tr><th scope="col">Fact</th><th scope="col">Value</th></tr></thead>
            <tbody>
                <tr><td>Email</td><td class="sp-table__cell--mono">{{identity.email}}</td></tr>
                <tr><td>Display name</td><td>{{default identity.display_name "—"}}</td></tr>
                <tr><td>User id</td><td class="sp-table__cell--mono">{{identity.user_id}}</td></tr>
                <tr><td>Tenant</td><td class="sp-table__cell--mono">{{default identity.tenant_id "—"}}</td></tr>
                <tr><td>Identity provider</td><td>{{default identity.provider "local"}}</td></tr>
                <tr><td>Roles</td><td>{{#each identity.roles}}{{> components/badge tone="accent" text=this}}{{/each}}</td></tr>
                <tr><td>JWT issuer</td><td class="sp-table__cell--mono">{{default identity.jwt_issuer "—"}}</td></tr>
                <tr><td>Inference gateway</td><td class="sp-table__cell--mono">{{default identity.gateway "not configured"}}</td></tr>
                {{#if bridge_profile}}
                <tr><td>Auth scheme</td><td class="sp-table__cell--mono">{{bridge_profile.auth_scheme}}</td></tr>
                <tr><td>Gateway base URL</td><td class="sp-table__cell--mono">{{bridge_profile.inference_gateway_base_url}}</td></tr>
                <tr><td>Organization</td><td class="sp-table__cell--mono">{{default bridge_profile.organization_uuid "—"}}</td></tr>
                <tr><td>Allowed models</td><td>
                    <span class="sp-u-num">{{bridge_profile.models_count}}</span> signed for this user
                    {{#if bridge_profile.models}}<details><summary>list them</summary><span class="sp-u-mono">{{#each bridge_profile.models}}{{this}} {{/each}}</span></details>{{/if}}
                </td></tr>
                {{/if}}
            </tbody>
        {{/components/table}}
    </section>

    <section aria-label="Marketplaces reaching this account">
        {{> components/section title="Your marketplaces" count=marketplaces_count note="Group membership is what grants a marketplace; the layer column names the band that did."}}
        {{#if marketplaces}}
        {{#> components/table caption="Marketplaces reaching this account"}}
            <thead><tr>
                <th scope="col">Marketplace</th>
                <th scope="col">Version</th>
                <th scope="col" class="sp-table__cell--num">Plugins</th>
                <th scope="col">Granted by</th>
            </tr></thead>
            <tbody>
            {{#each marketplaces}}
            <tr>
                <td><a href="/admin/marketplaces/{{id}}">{{name}}</a></td>
                <td class="sp-table__cell--mono">{{version}}</td>
                <td class="sp-table__cell--num sp-u-num">{{plugin_count}}</td>
                <td>{{> components/badge tone="muted" text=layer}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No marketplace reaches this account" message="Group membership is what grants a marketplace. Ask an administrator to add you to a group."}}
        {{/if}}
    </section>

    <section aria-label="Agents available to this account">
        {{> components/section title="Available agents" count=agents.total note="Every agent configured on this instance, and whether its host is up."}}
        {{#if agents.items}}
        {{#> components/table caption="Agents configured on this instance"}}
            <thead><tr>
                <th scope="col">Agent</th>
                <th scope="col">Id</th>
                <th scope="col">State</th>
            </tr></thead>
            <tbody>
            {{#each agents.items}}
            <tr>
                <td>{{default display_name id}}</td>
                <td class="sp-table__cell--mono">{{id}}</td>
                <td>{{#if host_running}}{{> components/badge tone="ok" text="running"}}{{else if enabled}}{{> components/badge tone="info" text="enabled"}}{{else}}{{> components/badge tone="muted" text="disabled"}}{{/if}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No agents configured" message="Agents you enable appear here with their live status."}}
        {{/if}}
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    <script src="/js/components/sp-copy.js?v={{css_version}}" defer></script>
    <script src="/js/pages/profile-connections.js?v={{css_version}}" type="module"></script>
    <script src="/js/pages/profile-connect-code.js?v={{css_version}}" type="module"></script>
    {{/inline}}
{{/layout}}
