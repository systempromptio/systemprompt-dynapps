{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="What you have used, how you appear in this console, and the account itself. Sign-in identity is set by the directory and cannot be changed here."}}
        {{#*inline "header_meta"}}
            <span class="sp-u-mono">{{identity.email}}</span>
            <span>{{#each identity.roles}}{{this}} {{/each}}</span>
            {{#if identity.provider}}<span>signed in via {{identity.provider}}</span>{{/if}}
        {{/inline}}
        {{#*inline "header_actions"}}
            <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/connect">Connect a client</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/connectors">Connectors</a>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/history">My conversations</a>
        {{/inline}}
    {{/components/page-header}}

    {{#unless identity.is_admin}}
    {{> components/notice tone="warn" title="You have user permissions"
        message="Admin pages, the systemprompt MCP server and the admin plugins are hidden. An operator promotes an account with `systemprompt admin users role promote`; sign out and back in afterwards, because the admin scope is minted with the token."}}
    {{/unless}}

    <section class="sp-kpi-grid" aria-label="Your usage">
        {{> components/kpi label="Spend · 30d" value=(formatUsd usage.d30.cost_microdollars) note=(concat "7d " (formatUsd usage.d7.cost_microdollars) " · 24h " (formatUsd usage.d1.cost_microdollars)) delta=(deltaPct usage.d30.cost_microdollars usage.d30.previous_cost_microdollars)}}
        {{> components/kpi label="Conversations" value=(formatNumber usage.conversations.total_conversations) note=(concat (formatNumber usage.conversations.total_ai_requests) " AI requests") href="/admin/history"}}
        {{> components/kpi label="Models used" value=models_count note=(concat (formatNumber usage.d30.tokens) " tokens · 30d")}}
    </section>

    {{#if latest_conversation}}
    <section aria-label="Your latest conversation">
        {{> components/section title="Your latest conversation"}}
        <div class="sp-card sp-p-profile__latest">
            <div class="sp-card__body sp-p-profile__latest-body">
                <div class="sp-p-profile__latest-main">
                    <a class="sp-u-link-strong sp-p-profile__latest-title" href="{{latest_conversation.url}}" title="{{latest_conversation.context_id}}">{{latest_conversation.conversation_title}}</a>
                    <span class="sp-p-profile__latest-meta">
                        <span title="{{latest_conversation.last_at}}">{{latest_conversation.last_relative}}</span>
                        <span class="sp-badge sp-badge--info">{{latest_conversation.model}}</span>
                        <span>{{formatNumber latest_conversation.turns}} turns</span>
                        <span class="sp-u-mono">{{latest_conversation.cost_display}}</span>
                    </span>
                </div>
                <a class="sp-btn sp-btn--sm sp-btn--primary" href="{{latest_conversation.url}}">Open</a>
            </div>
        </div>
    </section>
    {{/if}}

    <section aria-label="Recent conversations">
        {{#> components/section title="Recent conversations" count=recent_count note="Your ten most recent conversations. Side calls — cache probes and title generation — are not listed."}}
            {{#*inline "section_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/history">Search all</a>{{/inline}}
        {{/components/section}}
        {{#if has_recent}}
        {{#> components/table caption="Your most recent conversations"}}
            <thead><tr>
                <th scope="col">Conversation</th>
                <th scope="col">Model</th>
                <th scope="col" class="sp-table__cell--num">Turns</th>
                <th scope="col" class="sp-table__cell--num">Cost</th>
                <th scope="col" aria-sort="descending" class="sp-table__cell--date">Last activity</th>
            </tr></thead>
            <tbody>
            {{#each recent_conversations}}
            <tr>
                <td><a href="{{this.url}}" class="sp-u-link-strong" title="{{this.context_id}}">{{this.conversation_title}}</a></td>
                <td class="sp-table__cell--mono">{{this.model}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber this.turns}}</td>
                <td class="sp-table__cell--num sp-u-num sp-u-mono">{{this.cost_display}}</td>
                <td class="sp-table__cell--date" title="{{this.last_at}}">{{this.last_relative}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{#if side_call_note}}<p class="sp-p-profile__side-note">{{side_call_note}}</p>{{/if}}
        {{else}}
        {{> components/empty-state heading="No conversations yet" message="Conversations are grouped by context id on incoming inference requests. Connect a client to start one."}}
        {{/if}}
    </section>


    <section class="sp-p-profile__subscriptions" aria-label="Personal subscriptions" data-subscriptions>
        {{> components/section title="Personal subscriptions" note="Your own model subscriptions, such as OpenCode Go. The gateway sends those models' requests with your key: governance and audit still apply, and usage bills to your subscription. One key per person; never add a shared or borrowed key."}}
        <div class="sp-card">
            <div class="sp-card__body">
                <p class="sp-u-text-sm sp-u-text-secondary" data-subscriptions-status role="status" aria-live="polite">Loading your subscriptions…</p>
                <ul class="sp-p-profile__subscription-list" data-subscriptions-list></ul>
                <noscript><p class="sp-u-text-sm">Managing subscriptions needs JavaScript; the bridge's Settings page does the same.</p></noscript>
                <p class="sp-u-text-xs sp-u-text-tertiary"><a href="/documentation/opencode-go-subscription">Bring your own OpenCode Go subscription</a></p>
            </div>
        </div>
        <template data-subscription-row>
            <li class="sp-p-profile__subscription">
                <div class="sp-p-profile__subscription-head">
                    <span class="sp-u-text-semibold" data-field="name"></span>
                    <span class="sp-badge" data-field="state"></span>
                    <span class="sp-u-text-xs sp-u-text-tertiary" data-field="meta"></span>
                </div>
                <form class="sp-p-profile__subscription-form" data-action="save">
                    <input type="password" name="api_key" autocomplete="off" required placeholder="Paste your API key" aria-label="API key">
                    <input type="text" name="label" maxlength="64" placeholder="Label (optional)" aria-label="Label">
                    <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Save and test</button>
                    <button type="button" class="sp-btn sp-btn--sm sp-btn--danger" data-action="remove">Remove</button>
                </form>
            </li>
        </template>
    </section>

    <form id="settings-form" class="sp-p-profile__settings" aria-label="Settings">
        {{#> components/section title="Settings" note="Username and email come from the directory that signed you in. Display name, avatar and timezone are yours."}}
            {{#*inline "section_actions"}}<button type="submit" form="settings-form" class="sp-btn sp-btn--sm sp-btn--primary" id="save-settings-btn">Save settings</button>{{/inline}}
        {{/components/section}}
        <div class="sp-card">
            <div class="sp-card__body sp-p-profile__settings-grid">
                <div class="sp-form-group">
                    <label for="settings-username">Username</label>
                    <input type="text" id="settings-username" value="{{username}}" readonly disabled>
                    <span class="sp-u-text-xs sp-u-text-tertiary">Set by the directory; cannot be changed.</span>
                </div>
                <div class="sp-form-group">
                    <label for="settings-email">Email</label>
                    <input type="email" id="settings-email" value="{{identity.email}}" readonly disabled>
                    <span class="sp-u-text-xs sp-u-text-tertiary">Contact an administrator to change this.</span>
                </div>
                <div class="sp-form-group">
                    <label for="settings-display-name">Display name</label>
                    <input type="text" id="settings-display-name" value="{{settings.display_name}}" placeholder="Enter a display name">
                    <span class="sp-u-text-xs sp-u-text-tertiary">Shown wherever this console names you.</span>
                </div>
                <div class="sp-form-group">
                    <label for="settings-avatar-url">Avatar URL</label>
                    <div class="sp-p-profile__avatar-row">
                        <input type="url" id="settings-avatar-url" value="{{settings.avatar_url}}" placeholder="https://example.com/avatar.png">
                        <span class="sp-p-profile__avatar" id="avatar-preview">
                            {{#if settings.avatar_url}}<img src="{{settings.avatar_url}}" alt="Avatar preview">{{else}}<span class="sp-p-profile__avatar-fallback">?</span>{{/if}}
                        </span>
                    </div>
                </div>
                <div class="sp-form-group">
                    <label for="settings-timezone">Timezone</label>
                    <select id="settings-timezone"><option value="UTC">UTC</option></select>
                    <span class="sp-u-text-xs sp-u-text-tertiary">Used to render timestamps in your local time.</span>
                    <input type="hidden" id="settings-timezone-saved" value="{{settings.timezone}}">
                </div>
            </div>
        </div>
        <p class="sp-u-text-sm" id="save-status" role="status" aria-live="polite"></p>
    </form>

    <section class="sp-p-profile__danger" aria-label="Danger zone">
        {{> components/section title="Danger zone" note="Irreversible. Everything below removes data that cannot be recovered."}}
        <div class="sp-card sp-card--danger">
            <div class="sp-card__body">
                <p class="sp-u-text-semibold">Delete account</p>
                <p class="sp-u-text-sm sp-u-text-secondary">
                    Permanently deletes this account and all data associated with it. Conversations,
                    keys and group memberships go with it. This cannot be undone.
                </p>
                <button type="button" class="sp-btn sp-btn--sm sp-btn--danger sp-u-mt-4" id="delete-account-btn">Delete account</button>
            </div>
        </div>
    </section>

    <details class="sp-p-profile__more">
        <summary>Account details — identity, gateway, marketplaces and agents</summary>

        <section aria-label="Identity and gateway">
            {{> components/section title="Identity and gateway" note="What this session is, and which gateway signs for it."}}
            {{#> components/table caption="Identity and gateway facts for this account"}}
                <thead><tr><th scope="col">Fact</th><th scope="col">Value</th></tr></thead>
                <tbody>
                    <tr><td>Email</td><td class="sp-table__cell--mono">{{identity.email}}</td></tr>
                    <tr><td>Display name</td><td>{{default identity.display_name "—"}}</td></tr>
                    <tr><td>User id</td><td class="sp-table__cell--mono">{{identity.user_id}}</td></tr>
                    <tr><td>Tenant</td><td class="sp-table__cell--mono">{{default identity.tenant_id "—"}}</td></tr>
                    <tr><td>Identity provider</td><td>{{default identity.provider "local"}}</td></tr>
                    <tr><td>Roles</td><td>{{#each identity.roles}}{{> components/badge tone="accent" text=this}}{{/each}}</td></tr>
                    <tr><td>JWT issuer</td><td class="sp-table__cell--mono">{{default identity.jwt_issuer "—"}}</td></tr>
                    <tr><td>Inference gateway</td><td class="sp-table__cell--mono">{{default identity.gateway "not configured"}}</td></tr>
                    {{#if bridge_profile}}
                    <tr><td>Auth scheme</td><td class="sp-table__cell--mono">{{bridge_profile.auth_scheme}}</td></tr>
                    <tr><td>Gateway base URL</td><td class="sp-table__cell--mono">{{bridge_profile.inference_gateway_base_url}}</td></tr>
                    <tr><td>Organization</td><td class="sp-table__cell--mono">{{default bridge_profile.organization_uuid "—"}}</td></tr>
                    <tr><td>Allowed models</td><td>
                        <span class="sp-u-num">{{bridge_profile.models_count}}</span> signed for this user
                        {{#if bridge_profile.models}}<details><summary>list them</summary><span class="sp-u-mono">{{#each bridge_profile.models}}{{this}} {{/each}}</span></details>{{/if}}
                    </td></tr>
                    {{/if}}
                </tbody>
            {{/components/table}}
        </section>

        <section aria-label="Marketplaces reaching this account">
            {{> components/section title="Your marketplaces" count=marketplaces_count note="Group membership is what grants a marketplace; the layer column names the band that did."}}
            {{#if marketplaces}}
            {{#> components/table caption="Marketplaces reaching this account"}}
                <thead><tr>
                    <th scope="col">Marketplace</th>
                    <th scope="col">Version</th>
                    <th scope="col" class="sp-table__cell--num">Plugins</th>
                    <th scope="col">Granted by</th>
                </tr></thead>
                <tbody>
                {{#each marketplaces}}
                <tr>
                    <td><a href="/admin/marketplaces/{{id}}">{{name}}</a></td>
                    <td class="sp-table__cell--mono">{{version}}</td>
                    <td class="sp-table__cell--num sp-u-num">{{plugin_count}}</td>
                    <td>{{> components/badge tone="muted" text=layer}}</td>
                </tr>
                {{/each}}
                </tbody>
            {{/components/table}}
            {{else}}
            {{> components/empty-state heading="No marketplace reaches this account" message="Group membership is what grants a marketplace. Ask an administrator to add you to a group."}}
            {{/if}}
        </section>

        <section aria-label="Agents available to this account">
            {{> components/section title="Available agents" count=agents.total note="Every agent configured on this instance, and whether it is enabled."}}
            {{#if agents.items}}
            {{#> components/table caption="Agents configured on this instance"}}
                <thead><tr>
                    <th scope="col">Agent</th>
                    <th scope="col">Id</th>
                    <th scope="col">State</th>
                </tr></thead>
                <tbody>
                {{#each agents.items}}
                <tr>
                    <td>{{default display_name id}}</td>
                    <td class="sp-table__cell--mono">{{id}}</td>
                    <td>{{#if enabled}}{{> components/badge tone="info" text="enabled"}}{{else}}{{> components/badge tone="muted" text="disabled"}}{{/if}}</td>
                </tr>
                {{/each}}
                </tbody>
            {{/components/table}}
            {{else}}
            {{> components/empty-state heading="No agents configured" message="Agents you enable appear here."}}
            {{/if}}
        </section>
    </details>
    {{/inline}}
    {{#*inline "scripts"}}
    <script src="/js/pages/admin-settings.js?v={{css_version}}" type="module"></script>
    <script src="/js/pages/admin-subscriptions.js?v={{css_version}}" type="module"></script>
    {{/inline}}
{{/layout}}
