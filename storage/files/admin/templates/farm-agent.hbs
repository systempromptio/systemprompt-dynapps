{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle=definition.description}}
      {{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--primary" href="{{open_launch_url}}" data-action="farm-launch-open">Launch run</a>{{/inline}}
      {{#*inline "header_meta"}}
        <span class="sp-farm-agent__meta">Farm <a class="sp-link" href="{{header.farm_url}}">{{header.farm_name}}</a></span>
        <span class="sp-farm-agent__meta">Model <code class="sp-u-mono">{{header.model}}</code></span>
        <span class="sp-farm-agent__meta">Plugin {{> components/badge tone="accent" text=header.plugin_id}}</span>
        {{#if header.fixture}}<span class="sp-farm-agent__meta">Fixture <code class="sp-u-mono">{{header.fixture}}</code></span>{{/if}}
        <span class="sp-farm-agent__meta">Synced <code class="sp-u-mono">{{header.synced_sha_short}}</code></span>
      {{/inline}}
    {{/components/page-header}}

    <div class="sp-farm-agent">
      <div class="sp-kpi-grid">
        {{#each kpis}}{{> components/kpi label=label value=value note=note tone=tone key=key}}{{/each}}
      </div>

      <div class="sp-farm-agent__grid">
        <section class="sp-card sp-farm-agent__card" aria-labelledby="farm-agent-definition">
          <div class="sp-card__body">
            <h2 class="sp-section__title" id="farm-agent-definition">Definition</h2>
            <p class="sp-farm-agent__label">Entry prompt</p>
            <pre class="sp-farm-agent__prompt">{{definition.entry_prompt}}</pre>
            <dl class="sp-kv-list">
              <div class="sp-kv-row"><dt>Tools</dt><dd>{{#if definition.tools}}{{#each definition.tools}}<code class="sp-farm-agent__tool">{{this}}</code>{{/each}}{{else}}All tools{{/if}}</dd></div>
              {{#if definition.skills}}<div class="sp-kv-row"><dt>Skills</dt><dd>{{#each definition.skills}}<code class="sp-farm-agent__tool">{{this}}</code>{{/each}}</dd></div>{{/if}}
              {{#if definition.output_path}}<div class="sp-kv-row"><dt>Output</dt><dd><code class="sp-u-mono">{{definition.output_path}}</code></dd></div>{{/if}}
              <div class="sp-kv-row"><dt>Source</dt><dd><code class="sp-u-mono">{{definition.source_path}}</code></dd></div>
            </dl>
          </div>
        </section>

        {{> farm/curl-snippet remote=remote devices_url=devices_url}}
      </div>

      {{> components/section title="Recent runs"}}
      {{#if runs}}
        {{#> components/table caption="Recent runs of this agent"}}
          <thead><tr>
            <th scope="col">Started</th><th scope="col">Run</th><th scope="col">Agent</th><th scope="col">User</th>
            <th scope="col">Trigger</th><th scope="col">Status</th><th scope="col">Tool calls</th>
            <th scope="col">Events</th><th scope="col">Cost</th><th scope="col">Duration</th>
          </tr></thead>
          <tbody>{{#each runs}}{{> farm/run-row this}}{{/each}}</tbody>
        {{/components/table}}
      {{else}}
        {{> components/empty-state heading="No runs for this agent" message="Launch a run from this page or with the remote execution command."}}
      {{/if}}

      {{#if matrix}}
        {{#> components/section title="Eval cases" note=matrix.suite_id}}
          {{#*inline "section_actions"}}
          <form method="post" action="{{matrix.run_url}}">
            <input type="hidden" name="farm_id" value="{{matrix.farm_id}}">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--outline">Run evals now</button>
          </form>
          {{/inline}}
        {{/components/section}}
        <ul class="sp-farm-agent__matrix">
          {{#each matrix.cases}}
          <li class="sp-farm-agent__case" title="{{rationale}}">
            <span class="sp-farm-agent__case-id">{{case_id}}</span>
            {{#if eval_run_url}}<a href="{{eval_run_url}}">{{> components/badge tone=tone text=verdict}}</a>{{else}}{{> components/badge tone=tone text=verdict}}{{/if}}
            <span class="sp-farm-agent__score">{{score}}</span>
          </li>
          {{/each}}
        </ul>
      {{/if}}
    </div>

    {{> farm/launch-dialog launch}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-farm-agent.js"></script>
    {{/inline}}
{{/layout}}
