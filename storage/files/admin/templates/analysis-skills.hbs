{{#> layout title=title page=page}}
{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Every managed resource with retained attributed use in the window, and the conversations behind the one you select. All figures are read from retained snapshot data."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/resources?start={{filter.start}}&amp;end={{filter.end}}">Resource effectiveness</a> <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/evaluations">Experiments</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid">
{{> components/kpi label="Attributed invocations" value=totals.attributed note=(concat totals.invocations " retained invocations in the window")}}
{{> components/kpi label="Conversations" value=totals.conversations note="distinct authenticated sessions with an attributed invocation"}}
{{> components/kpi label="Requests" value=totals.requests note=(concat totals.failed " failed")}}
{{> components/kpi label="Tokens" value=(formatNumber totals.tokens) note="input and output on retained requests"}}
{{> components/kpi label="Spend" value=cost note="USD on priced retained requests"}}
</div>
{{#> components/toolbar toolbar_count=(concat pagination.total_rows " " pagination.noun)}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter" method="get" action="/admin/analysis/skills">
{{#if filter.resource}}<input type="hidden" name="resource" value="{{filter.resource}}">{{/if}}
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="sk-start">From (UTC)</label><input class="sp-search-input" type="date" id="sk-start" name="start" value="{{filter.start}}" required></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="sk-end">Until (UTC, exclusive)</label><input class="sp-search-input" type="date" id="sk-end" name="end" value="{{filter.end}}" required></div>
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply</button>
</form>
{{/inline}}
{{#*inline "toolbar_actions"}}{{#if detail}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="{{all_href}}">All resources</a>{{/if}}{{/inline}}
{{/components/toolbar}}
{{#if detail}}
{{> components/section title=selected.resource_key note=(concat "Conversations with an invocation attributed to this " selected.kind ", with the requests and latest assessment retained for each.")}}
{{#> components/table caption="Conversations attributed to the selected resource" modifier="sp-analysis-table" pagination=pagination}}
<thead><tr><th scope="col">Session · consumer · host</th><th scope="col">Window</th><th scope="col" class="sp-table__cell--num">Invocations</th><th scope="col" class="sp-table__cell--num">Requests</th><th scope="col" class="sp-table__cell--num">Tokens</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col">Assessment</th></tr></thead>
<tbody>
{{#each conversations}}<tr><td class="sp-table__cell--primary sp-table__cell--stacked"><a class="sp-table__link" href="{{href}}">{{row.session_id}}</a><span class="sp-u-text-tertiary">{{row.user_id}}</span><span class="sp-u-text-tertiary">{{host}}</span></td><td class="sp-table__cell--stacked"><span>{{first}}</span><span class="sp-u-text-tertiary">→ {{last}}</span></td><td class="sp-table__cell--num sp-u-num">{{row.invocations}}</td><td class="sp-table__cell--num sp-u-num">{{row.requests}}{{#if row.failed}} <span class="sp-u-text-danger">({{row.failed}} failed)</span>{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.requests}}{{formatNumber row.tokens}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.requests}}{{cost}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td>{{assessment}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="7">{{> components/empty-state title="No retained conversations" message="No authenticated session invoked this resource in the window, or its facts have not been drained into a snapshot yet."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
{{else}}
{{#> components/table caption="Managed resources with retained attributed use" modifier="sp-analysis-table" pagination=pagination}}
<thead><tr><th scope="col">Resource</th><th scope="col">Plugin</th><th scope="col">Marketplaces</th><th scope="col" class="sp-table__cell--num">Invocations</th><th scope="col" class="sp-table__cell--num">Conversations</th><th scope="col" class="sp-table__cell--num">Requests</th><th scope="col" class="sp-table__cell--num">Failed</th><th scope="col" class="sp-table__cell--num">Tokens</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th></tr></thead>
<tbody>
{{#each resources}}<tr><td class="sp-table__cell--primary"><a class="sp-table__link" href="{{href}}">{{row.resource_key}}</a><br><small class="sp-u-mono sp-u-text-tertiary">{{row.kind}} · {{row.resource_id}}</small></td><td>{{#if plugin_id}}{{plugin_name}}<br><small class="sp-u-mono sp-u-text-tertiary">{{plugin_id}}</small>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td>{{#each marketplaces}}{{> components/badge tone="muted" text=this}} {{else}}<span class="sp-u-text-tertiary">—</span>{{/each}}</td><td class="sp-table__cell--num sp-u-num">{{row.invocations}}</td><td class="sp-table__cell--num sp-u-num">{{row.conversations}}</td><td class="sp-table__cell--num sp-u-num">{{row.requests}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.failed}}<span class="sp-u-text-danger">{{row.failed}}</span>{{else}}0{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.requests}}{{formatNumber row.tokens}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.requests}}{{cost}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td class="sp-table__cell--actions"><a class="sp-btn sp-btn--xs sp-btn--outline" href="{{inventory_href}}">Inventory</a></td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="10">{{> components/empty-state title="No retained attributed use" message="No managed resource has an attributed invocation in this window. Widen the window, or bind and publish resources so invocations can be attributed and drained into a snapshot."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
{{/if}}
<details class="sp-analysis-definitions"><summary>Where these numbers come from</summary>
<p>Every figure on this page is read from retained snapshot data; nothing is computed live from raw events. Totals come from the organisation-wide contributions retained for the window, resource rows from the contributions retained under that resource's scope, and conversations from the normalized invocation, association, request and assessment facts.</p>
<p>Unattributed invocations are excluded from every resource row and from the attributed headline. Only an invocation verified against a published managed resource counts, so a resource appears here once its facts have been drained into a snapshot — a newly bound resource shows nothing until the next drain.</p>
<p>A request associated with several resources is counted under each of them; resource rows must not be added together. Spend covers priced USD requests only. An assessment is the latest retained outcome for the conversation's invocation, not a human rating.</p>
</details>
{{/inline}}{{/layout}}
