{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="Plugins are the installable units in the catalog, each bundling skills, MCP servers, agents, and hooks. Read-only: loaded from services/plugins/*/config.yaml — edit on disk and restart to change."}}

    <div class="sp-toolbar" role="toolbar" aria-label="Plugin filters">
        <div class="sp-toolbar__search">
            <input type="text" class="sp-search-input" placeholder="Search plugins…" id="catalog-search" aria-label="Search plugins">
        </div>
        <span class="sp-u-text-muted sp-catalog-count">{{plugins_count}} plugin{{#unless (eq plugins_count 1)}}s{{/unless}}</span>
    </div>

    {{#if plugins_count}}
    <div class="sp-catalog-grid" id="catalog-grid">
        {{#each plugins}}
        <article class="sp-catalog-card" data-search="{{toLowerCase name}} {{toLowerCase id}} {{toLowerCase category}}">
            <a class="sp-catalog-card__main" href="{{detail_url}}">
                <div class="sp-catalog-card__head">
                    <h2 class="sp-catalog-card__title">{{name}}</h2>
                    {{#if enabled}}<span class="sp-badge sp-badge--ok">enabled</span>{{else}}<span class="sp-badge sp-badge--muted">disabled</span>{{/if}}
                </div>
                <p class="sp-catalog-card__desc">{{#if description}}{{description}}{{else}}<span class="sp-u-text-tertiary">No description</span>{{/if}}</p>
                <div class="sp-catalog-card__meta">
                    {{#if category}}<span class="sp-chip sp-chip--tag">{{category}}</span>{{/if}}
                    <span class="sp-chip sp-chip--muted">v{{version}}</span>
                </div>
            </a>
            <div class="sp-catalog-card__visibility">
                {{> components/visibility-badge visibility}}
            </div>
            <div class="sp-catalog-card__rel">
                <span class="sp-rel-chip" title="Skills"><strong>{{skills_count}}</strong> skills</span>
                <span class="sp-rel-chip" title="MCP servers"><strong>{{mcp_count}}</strong> MCP</span>
                <span class="sp-rel-chip" title="Agents"><strong>{{agents_count}}</strong> agents</span>
                <span class="sp-rel-chip sp-rel-chip--assign" title="Access assignments"><strong>{{assignment_count}}</strong> assigned</span>
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
    {{> components/empty-state message="No plugins configured. Add a services/plugins/<id>/config.yaml and restart."}}
    {{/if}}

    {{/inline}}
    {{#*inline "scripts"}}
    <script type="module" src="/js/pages/admin-catalog-filter.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
