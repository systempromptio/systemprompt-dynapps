{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="MCP servers expose tools to agents. Read-only: loaded from services/mcp/* and granted to an enterprise by the plan it is on."}}

    <div class="sp-toolbar" role="toolbar" aria-label="MCP filters">
        <div class="sp-toolbar__search">
            <input type="text" class="sp-search-input" placeholder="Search MCP servers…" id="catalog-search" aria-label="Search MCP servers">
        </div>
        <span class="sp-u-text-muted sp-catalog-count">{{servers_count}} server{{#unless (eq servers_count 1)}}s{{/unless}}</span>
    </div>

    {{#if servers_count}}
    {{#> components/table}}
        <thead><tr>
            <th>ID</th>
            <th>Description</th>
            <th class="sp-col-status">Status</th>
            <th class="sp-col-status">Auth</th>
            <th class="sp-u-numeric sp-table__cell--num">Plugins</th>
            <th class="sp-u-numeric sp-table__cell--num">Assignments</th>
            <th class="sp-table__cell--actions"></th>
        </tr></thead>
        <tbody>
        {{#each servers}}
        <tr data-search="{{toLowerCase id}} {{toLowerCase description}}">
            <td><a class="sp-table__link" href="{{detail_url}}"><code class="sp-code-inline">{{id}}</code></a></td>
            <td>{{#if description}}{{truncate description 90}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td class="sp-col-status">{{#if enabled}}<span class="sp-badge sp-badge--ok">enabled</span>{{else}}<span class="sp-badge sp-badge--muted">disabled</span>{{/if}}</td>
            <td class="sp-col-status">{{#if oauth_required}}<span class="sp-badge sp-badge--warn">OAuth</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td class="sp-u-numeric sp-table__cell--num">{{plugin_count}}</td>
            <td class="sp-u-numeric sp-table__cell--num">{{assignment_count}}</td>
            <td class="sp-table__cell--actions"><a class="sp-btn sp-btn--sm sp-btn--outline" href="{{detail_url}}">View →</a></td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="No MCP servers configured. Add a services/mcp/<id>.yaml and restart."}}
    {{/if}}

    {{/inline}}
    {{#*inline "scripts"}}
    <script type="module" src="/js/pages/admin-catalog-filter.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
