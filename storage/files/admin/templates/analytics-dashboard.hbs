{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header
        title="Analytics"
        subtitle="What the AI actually did, by model, skill, tool, session and cost — narrowed by the scope and window above."}}
      {{#*inline "header_meta"}}
        <span>{{kpis.requests}} requests · {{kpis.cost_display}} · {{kpis.active_users}} active people</span>
      {{/inline}}
      {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Request log</a>
        <a class="sp-btn sp-btn--sm sp-btn--primary" href="{{cost.csv_url}}">Export cost CSV</a>
      {{/inline}}
    {{/components/page-header}}

    {{> components/time-range time_range}}

    {{> components/tabs tabs=tabs nav_label="Analytics views"}}

    <div class="sp-p-analytics__controls">
        {{> components/scope-filter filters.scope}}
        <span class="sp-p-analytics__toggle" role="group" aria-label="Attribution">
            {{#each attribution_links}}
            <a class="sp-btn sp-btn--sm{{#unless this.is_active}} sp-btn--outline{{/unless}}"
               href="{{this.href}}" title="{{this.hint}}"
               {{#if this.is_active}}aria-current="true"{{/if}}>{{this.label}}</a>
            {{/each}}
        </span>
        <span class="sp-p-analytics__toggle" role="group" aria-label="Bucket size">
            {{#each filters.bucket_links}}
            <a class="sp-btn sp-btn--sm{{#unless this.is_active}} sp-btn--outline{{/unless}}"
               href="{{this.href}}">{{this.label}}</a>
            {{/each}}
        </span>
    </div>

    {{#if is_member_view}}
    {{> components/notice tone="warn" title="Member view — overlaps"
        message="Each person is counted in every group and project they belong to, so these rows deliberately do not sum to the instance total. Switch to Exclusive for figures that partition."}}
    {{/if}}

    {{#if chips}}
    <ul class="sp-filter-ribbon__chips" aria-label="Active filters">
        {{#each chips}}
        <li class="sp-filter-ribbon__chip">
            <span class="sp-filter-ribbon__chip-group">{{this.group_label}}:</span>
            <span class="sp-filter-ribbon__chip-value">{{this.label}}</span>
            <a class="sp-filter-ribbon__chip-remove" href="{{this.remove_url}}"
               aria-label="Remove {{this.group_label}} filter {{this.label}}">&times;</a>
        </li>
        {{/each}}
        <li><a class="sp-filter-ribbon__clear" href="{{clear_url}}">Clear all</a></li>
    </ul>
    {{/if}}

    {{#if is_overview}}{{> analytics/overview}}{{/if}}
    {{#if is_models}}{{> analytics/models}}{{/if}}
    {{#if is_skills}}{{> analytics/skills}}{{/if}}
    {{#if is_tools}}{{> analytics/tools}}{{/if}}
    {{#if is_sessions}}{{> analytics/sessions}}{{/if}}
    {{#if is_cost}}{{> analytics/cost}}{{/if}}

    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
