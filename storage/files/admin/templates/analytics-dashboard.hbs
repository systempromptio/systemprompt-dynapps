{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Analytics"
        subtitle="Usage, adoption, cost, and code impact across the site. Filter by project or user."}}

    {{> components/time-range time_range}}

    <nav class="sp-tabs" role="tablist" aria-label="Analytics views">
        {{#each tabs}}
        <a class="sp-tab{{#if this.is_active}} sp-tab--active{{/if}}" role="tab"
           aria-selected="{{#if this.is_active}}true{{else}}false{{/if}}"
           href="{{this.href}}">{{this.label}}</a>
        {{/each}}
    </nav>

    <div class="analytics-filters analytics-filters--sticky">
        {{> components/scope-filter filters.scope}}
        <span class="analytics-filters__group">
            {{#each filters.bucket_links}}
            <a class="btn btn-sm{{#unless this.is_active}} btn-outline{{/unless}}"
               href="{{this.href}}">{{this.label}}</a>
            {{/each}}
        </span>
    </div>

    {{#if chips}}
    <ul class="filter-ribbon__chips" aria-label="Active filters">
        {{#each chips}}
        <li class="filter-ribbon__chip">
            <span class="filter-ribbon__chip-group">{{this.group_label}}:</span>
            <span class="filter-ribbon__chip-value">{{this.label}}</span>
            <a class="filter-ribbon__chip-remove" href="{{this.remove_url}}"
               aria-label="Remove {{this.group_label}} filter {{this.label}}">&times;</a>
        </li>
        {{/each}}
        <li><a class="filter-ribbon__clear" href="{{clear_url}}">Clear all</a></li>
    </ul>
    {{/if}}

    {{#if is_overview}}
    <section aria-label="Site health">
        <div class="kpi-strip">
            <div class="kpi-card">
                <span class="kpi-card__label">Requests</span>
                <span class="kpi-card__value">{{kpis.requests}}</span>
                <span class="kpi-card__delta" data-direction="{{kpis.requests_delta.direction}}" data-tone="{{kpis.requests_delta.tone}}">{{kpis.requests_delta.display}} vs prior period</span>
                <span class="kpi-card__sub">{{kpis.error_display}}</span>
                {{#if kpis.requests_spark}}{{> components/kpi-sparkline kpis.requests_spark}}{{/if}}
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Total spend</span>
                <span class="kpi-card__value">{{kpis.cost_display}}</span>
                <span class="kpi-card__delta" data-direction="{{kpis.cost_delta.direction}}" data-tone="{{kpis.cost_delta.tone}}">{{kpis.cost_delta.display}} vs prior period</span>
                <span class="kpi-card__sub">{{kpis.cost_per_request_display}} per request</span>
                {{#if kpis.cost_spark}}{{> components/kpi-sparkline kpis.cost_spark}}{{/if}}
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Weekly active users</span>
                <span class="kpi-card__value">{{kpis.weekly_active_users}}</span>
                <span class="kpi-card__delta" data-direction="{{kpis.wau_delta.direction}}" data-tone="{{kpis.wau_delta.tone}}">{{kpis.wau_delta.display}} vs prior week</span>
                <span class="kpi-card__sub">{{kpis.active_users}} active in window · {{kpis.requests_per_user_day_display}} req/user/day</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Tokens</span>
                <span class="kpi-card__value">{{kpis.tokens_display}}</span>
                <span class="kpi-card__delta" data-direction="{{kpis.tokens_delta.direction}}" data-tone="{{kpis.tokens_delta.tone}}">{{kpis.tokens_delta.display}} vs prior period</span>
                <span class="kpi-card__sub">across the window</span>
            </div>
        </div>

        <div class="analytics-grid">
            <section class="analytics-grid__panel">
                {{> components/svg-line-chart volume_chart}}
            </section>
            <section class="analytics-grid__panel">
                {{> components/svg-line-chart cost_chart}}
            </section>
        </div>

        <div class="analytics-grid">
            <section class="analytics-grid__panel">
                {{> components/pie-chart model_pie}}
            </section>
            <section class="analytics-grid__panel">
                {{> components/svg-stacked-chart model_cost_chart}}
            </section>
        </div>
    </section>
    {{/if}}

    {{#if is_usage}}
    <section aria-label="User adoption">
        <div class="kpi-strip">
            <div class="kpi-card">
                <span class="kpi-card__label">Permission grant rate</span>
                {{#if permissions.has_data}}
                <span class="kpi-card__value">{{permissions.rate_display}}</span>
                <span class="kpi-card__sub">{{permissions.granted}} of {{permissions.requests}} permission requests followed by the tool running</span>
                {{else}}
                <span class="kpi-card__value">—</span>
                <span class="kpi-card__sub">no permission requests in this window</span>
                {{/if}}
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Prompt cache hit rate</span>
                {{#if session_costs.has_data}}
                <span class="kpi-card__value">{{session_costs.cache_hit_display}}</span>
                <span class="kpi-card__sub">{{session_costs.cache_read_display}} tokens served from cache across {{session_costs.sessions}} sessions · client-reported</span>
                {{else}}
                <span class="kpi-card__value">—</span>
                <span class="kpi-card__sub">no client-reported sessions in this window</span>
                {{/if}}
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Thinking share</span>
                {{#if thinking.has_data}}
                <span class="kpi-card__value">{{thinking.share_display}}</span>
                <span class="kpi-card__sub">{{thinking.reasoning_display}} reasoning tokens inside {{thinking.output_display}} output tokens</span>
                {{else}}
                <span class="kpi-card__value">—</span>
                <span class="kpi-card__sub">no reasoning tokens reported in this window</span>
                {{/if}}
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Context window</span>
                {{#if session_costs.has_data}}
                <span class="kpi-card__value">{{session_costs.avg_context_display}}</span>
                <span class="kpi-card__sub">average · {{session_costs.max_context_display}} peak · client-reported</span>
                {{else}}
                <span class="kpi-card__value">—</span>
                <span class="kpi-card__sub">no client-reported sessions in this window</span>
                {{/if}}
            </div>
        </div>
        <p class="analytics-note">Sorted by
            {{#each leaderboard.sort_links}}
            <a href="{{this.href}}"{{#if this.is_active}} aria-current="true"{{/if}}>{{this.label}}</a>{{#unless @last}} · {{/unless}}
            {{/each}}
        </p>
        {{#if leaderboard.has_rows}}
        {{#> components/data-table}}
            <thead><tr>
                <th>User</th>
                <th>Project</th>
                <th class="col-share">Share</th>
                <th class="col-num">Requests</th>
                <th class="col-num">Req/day</th>
                <th class="col-num">Tokens</th>
                <th class="col-num">Cost</th>
                <th class="col-date">Last active</th>
                <th></th>
            </tr></thead>
            <tbody>
            {{#each leaderboard.rows}}
            <tr>
                <td><a href="{{this.detail_url}}">{{this.label}}</a></td>
                <td>{{this.groups_display}}</td>
                <td class="col-share">
                    <span class="share-bar" style="--v:{{this.share_pct}}%"></span>
                </td>
                <td class="col-num">{{this.requests}}</td>
                <td class="col-num">{{this.requests_per_day_display}}</td>
                <td class="col-num">{{this.tokens_display}}</td>
                <td class="col-num">{{this.cost_display}}</td>
                <td class="col-date">{{this.last_active_display}}</td>
                <td>
                    <a href="{{this.analytics_url}}" title="Full analytics for this user">Analytics</a>
                    ·
                    <a href="{{this.scope_url}}" title="Scope the dashboard to this user">Focus</a>
                    ·
                    <a href="{{this.log_url}}" title="Raw request log for this user">Log</a>
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{> components/pagination leaderboard.pagination}}
        {{else}}
        {{> components/empty-state
            message="No user activity in this window. Widen the time range or clear the filters."}}
        {{/if}}
    </section>
    {{/if}}

    {{#if is_spend}}
    <section aria-label="Latency and anomalies">
        <div class="analytics-filters" role="group" aria-label="Latency SLO threshold">
            <span class="section-caption">Latency SLO:</span>
            {{#each slo_options}}
            <a class="btn btn-sm{{#unless this.selected}} btn-outline{{/unless}}"
               data-slo-option
               href="{{this.href}}">{{this.label}}</a>
            {{/each}}
        </div>
        <div class="kpi-strip">
            <div class="kpi-card">
                <span class="kpi-card__label">Within SLO (&lt;{{fast_slow.threshold_display}})</span>
                <span class="kpi-card__value">{{fast_slow.fast}}</span>
                <span class="kpi-card__sub">p50 {{fast_slow.p50_display}}</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-card__label">Breaching SLO (&ge;{{fast_slow.threshold_display}})</span>
                <span class="kpi-card__value">{{fast_slow.slow}}</span>
                <span class="kpi-card__sub">{{fast_slow.breach_pct_display}} of timed requests · p95 {{fast_slow.p95_display}} · {{fast_slow.untimed}} untimed</span>
            </div>
        </div>
        <p class="analytics-note">Request speed is a latency distribution, not a request class —
            see the <a href="{{latency_link}}">latency histogram on the request log</a>.</p>

        <h2 class="section-title">Usage anomalies</h2>
        <p class="section-caption">Hours where requests, cost, or errors spiked past the trailing-week hourly baseline — written by the hourly anomaly sweep.</p>
        {{#if has_anomalies}}
        {{#> components/data-table}}
            <thead><tr>
                <th>Metric</th>
                <th>Hour</th>
                <th class="col-num">Observed</th>
                <th class="col-num">Baseline</th>
            </tr></thead>
            <tbody>
            {{#each anomalies}}
            <tr>
                <td>{{this.metric}}</td>
                <td>{{this.window_display}}</td>
                <td class="col-num">{{this.observed_display}}</td>
                <td class="col-num">{{this.baseline_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/data-table}}
        {{else}}
        {{> components/empty-state
            message="No usage anomalies detected."}}
        {{/if}}
    </section>
    {{/if}}

    {{#if is_code}}
    <section aria-label="Code impact">
        <div class="analytics-grid">
            <section class="analytics-grid__panel">
                {{> components/svg-line-chart commit_chart}}
            </section>
            <section class="analytics-grid__panel">
                {{> components/svg-line-chart loc_chart}}
            </section>
        </div>
        <div class="code-frames">
            {{#each code_frames}}
            <div class="code-frame">
                <span class="code-frame__title">{{this.frame_title}}</span>
                <span class="code-frame__value">{{this.value_display}}</span>
                <p class="code-frame__caption">{{this.caption}}</p>
            </div>
            {{/each}}
        </div>
        <p class="analytics-note">AI lines and committed lines are different measurement frames —
            hook-observed tool edits versus git diff totals — and are shown side by side, never subtracted.</p>
    </section>
    {{/if}}

    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
