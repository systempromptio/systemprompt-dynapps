{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title}}


    <section aria-label="Profile settings">
    <div class="sp-card sp-u-mb-6">
        <div class="sp-section__head">
            <h2 class="sp-section__title">Identity</h2>
        </div>
        <div class="sp-card__body">
            <form id="settings-form" class="sp-settings-form">
                <div class="sp-settings-form-grid">
                    <div class="sp-settings-field">
                        <label class="sp-settings-label" for="settings-username">Username</label>
                        <input type="text" id="settings-username" class="sp-form-input sp-form-input--readonly" value="{{username}}" readonly disabled />
                        <span class="sp-settings-hint">Username cannot be changed</span>
                    </div>
                    <div class="sp-settings-field">
                        <label class="sp-settings-label" for="settings-email">Email</label>
                        <input type="email" id="settings-email" class="sp-form-input sp-form-input--readonly" value="{{user_email}}" readonly disabled />
                        <span class="sp-settings-hint">Contact support to change email</span>
                    </div>
                    <div class="sp-settings-field">
                        <label class="sp-settings-label" for="settings-display-name">Display Name</label>
                        <input type="text" id="settings-display-name" class="sp-form-input" value="{{settings.display_name}}" placeholder="Enter a display name" />
                    </div>
                    <div class="sp-settings-field">
                        <label class="sp-settings-label" for="settings-avatar-url">Avatar URL</label>
                        <div class="sp-settings-avatar-row">
                            <input type="url" id="settings-avatar-url" class="sp-form-input" value="{{settings.avatar_url}}" placeholder="https://example.com/avatar.png" />
                            <div class="sp-settings-avatar-preview" id="avatar-preview">
                                {{#if settings.avatar_url}}
                                <img src="{{settings.avatar_url}}" alt="Avatar preview" />
                                {{else}}
                                <span class="sp-settings-avatar-placeholder">?</span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sp-settings-divider"></div>

                <h3 class="sp-settings-section-title">Preferences</h3>

                <div class="sp-settings-field sp-u-mt-4">
                    <label class="sp-settings-label" for="settings-timezone">Timezone</label>
                    <select id="settings-timezone" class="sp-form-input">
                        <option value="UTC">UTC</option>
                    </select>
                    <span class="sp-settings-hint">Used to render timestamps in your local time</span>
                    <input type="hidden" id="settings-timezone-saved" value="{{settings.timezone}}" />
                </div>

                <div class="sp-settings-actions">
                    <button type="submit" class="sp-btn sp-btn--primary" id="save-settings-btn">Save Settings</button>
                    <span class="sp-settings-save-status" id="save-status" role="status" aria-live="polite"></span>
                </div>
            </form>
        </div>
    </div>
    </section>

    <section aria-label="Danger zone">
    <div class="sp-card sp-u-mb-6 sp-card--danger">
        <div class="sp-section__head">
            <h2 class="sp-section__title">Danger Zone</h2>
        </div>
        <div class="sp-card__body">
            <div class="sp-danger-zone-item">
                <div>
                    <strong>Delete Account</strong>
                    <p class="sp-u-text-secondary sp-u-text-sm">Permanently delete your account and all associated data. This action cannot be undone.</p>
                </div>
                <button type="button" class="sp-btn sp-btn--danger" id="delete-account-btn">Delete Account</button>
            </div>
        </div>
    </div>
    </section>

    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" src="/js/pages/admin-settings.js" type="module" defer></script>
    {{/inline}}
{{/layout}}
