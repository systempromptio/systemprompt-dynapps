{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{#> components/page-header title=title
        subtitle="Stateful AI conversations — search by user, drill into the transcript."}}
      {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/sessions">Sessions</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/traces">Traces</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Requests</a>
      {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Context KPIs">
      {{> components/kpi label="Contexts" value=(formatNumber kpis.total_contexts)}}
      {{> components/kpi label="Users"    value=(formatNumber kpis.active_users)}}
      {{> components/kpi label="Requests" value=(formatNumber kpis.total_requests)}}
      {{> components/kpi label="Messages" value=(formatNumber kpis.total_messages) note="user prompts + AI responses"}}
      {{> components/kpi label="Tokens"   value=(formatNumber kpis.total_tokens)}}
      {{> components/kpi label="Cost"     value=(concat "$" kpis.total_cost_usd)}}
    </section>

    {{> components/scope-filter scope_filter}}

    <form class="sp-toolbar" role="search" aria-label="Filter contexts" method="get" id="contexts-filter-form">
        <div class="sp-toolbar__search">
            <input type="search" class="sp-search-input" name="q"
                   placeholder="Search contexts, users, IDs..."
                   value="{{filter.q}}" aria-label="Search contexts">
        </div>

        <label class="sp-toolbar__field" aria-label="Filter by user">
            <span class="sp-toolbar__field-label">User</span>
            <select name="user_id" class="sp-select" data-autosubmit>
                <option value="">All users</option>
                {{#each users_for_filter}}
                <option value="{{user_id}}" {{#if (eq user_id ../filter.user_id)}}selected{{/if}}>
                    {{default display_name user_id}}
                </option>
                {{/each}}
            </select>
        </label>

        <label class="sp-toolbar__field" aria-label="Filter by model">
            <span class="sp-toolbar__field-label">Model</span>
            <select name="model" class="sp-select" data-autosubmit>
                <option value="">All models</option>
                {{#each models}}
                <option value="{{this}}" {{#if (eq this ../filter.model)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </label>

        <div class="sp-time-range-pills" role="radiogroup" aria-label="Time range">
            <label class="sp-pill {{#unless filter.since}}sp-pill--active{{/unless}}">
                <input type="radio" name="since" value="" {{#unless filter.since}}checked{{/unless}} data-autosubmit>
                <span>All time</span>
            </label>
            <label class="sp-pill {{#if (eq filter.since '24h')}}sp-pill--active{{/if}}">
                <input type="radio" name="since" value="24h" {{#if (eq filter.since '24h')}}checked{{/if}} data-autosubmit>
                <span>24h</span>
            </label>
            <label class="sp-pill {{#if (eq filter.since '7d')}}sp-pill--active{{/if}}">
                <input type="radio" name="since" value="7d" {{#if (eq filter.since '7d')}}checked{{/if}} data-autosubmit>
                <span>7d</span>
            </label>
            <label class="sp-pill {{#if (eq filter.since '30d')}}sp-pill--active{{/if}}">
                <input type="radio" name="since" value="30d" {{#if (eq filter.since '30d')}}checked{{/if}} data-autosubmit>
                <span>30d</span>
            </label>
        </div>

        <input type="hidden" name="group" value="{{filter.group}}">
        <input type="hidden" name="project" value="{{filter.project}}">
        <input type="hidden" name="view" value="{{filter.view}}" id="contexts-view-input">
        <noscript><button type="submit" class="sp-btn sp-btn--primary">Apply</button></noscript>
    </form>

    {{> components/toolbar toolbar_count=count_label}}

    <nav class="sp-tabs" role="tablist" aria-label="Context views">
        <button type="button" role="tab"
                class="sp-tab {{#if view_is_contexts}}sp-tab--active{{/if}}"
                data-view="contexts"
                aria-selected="{{#if view_is_contexts}}true{{else}}false{{/if}}">
            Contexts
        </button>
        <button type="button" role="tab"
                class="sp-tab {{#if view_is_users}}sp-tab--active{{/if}}"
                data-view="users"
                aria-selected="{{#if view_is_users}}true{{else}}false{{/if}}">
            By user
        </button>
    </nav>

    {{#if view_is_users}}
    <section aria-label="Contexts grouped by user" data-page="contexts" data-view="users">
        {{#if has_user_summaries}}
        {{#> components/table caption="Contexts grouped by user"}}
            <thead><tr>
                <th>User</th>
                <th class="sp-u-numeric sp-table__cell--num">Contexts</th>
                <th class="sp-u-numeric sp-table__cell--num">Requests</th>
                <th class="sp-u-numeric sp-table__cell--num">Messages</th>
                <th class="sp-u-numeric sp-table__cell--num">Tokens</th>
                <th class="sp-u-numeric sp-table__cell--num">Cost</th>
                <th>Models</th>
                <th class="sp-col-date">Last activity</th>
                <th class="sp-table__cell--actions"></th>
            </tr></thead>
            <tbody>
            {{#each user_summaries}}
            <tr class="sp-table__row--expand" data-user-id="{{user_id}}">
                <td>
                    <a href="/admin/users/{{user_id}}" class="sp-user-cell">
                        <span class="sp-avatar sp-avatar-sm">{{initials (default display_name user_id)}}</span>
                        <span>{{default display_name user_id}}</span>
                    </a>
                </td>
                <td class="sp-u-numeric">{{formatNumber context_count}}</td>
                <td class="sp-u-numeric">{{formatNumber request_count}}</td>
                <td class="sp-u-numeric">{{formatNumber message_count}}</td>
                <td class="sp-u-numeric">{{formatNumber total_tokens}}</td>
                <td class="sp-u-numeric">${{cost_usd}}</td>
                <td>
                    {{#each models}}<span class="sp-badge sp-badge--info">{{this}}</span> {{/each}}
                </td>
                <td class="sp-col-date">
                    {{#if last_activity}}<span title="{{formatDate last_activity}}">{{relativeTime last_activity}}</span>
                    {{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}
                </td>
                <td class="sp-table__cell--actions">
                    <button class="sp-btn--actions sp-table__row-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="user-contexts-{{user_id}}"
                            aria-label="Show contexts for {{default display_name user_id}}">&#9662;</button>
                </td>
            </tr>
            <tr class="sp-table__row-detail" id="user-contexts-{{user_id}}" hidden>
                <td colspan="9">
                    {{#if contexts}}
                    <div class="sp-table"><div class="sp-table__scroll">
                      <table class="sp-table__el sp-table__el--nested">
                          <thead><tr>
                              <th>Context</th>
                              <th class="sp-col-conversation">Conversation</th>
                              <th>Model</th>
                              <th class="sp-u-numeric">Requests</th>
                              <th class="sp-u-numeric">Messages</th>
                              <th class="sp-u-numeric">Tokens</th>
                              <th class="sp-u-numeric">Cost</th>
                              <th class="sp-col-date">Last activity</th>
                          </tr></thead>
                          <tbody>
                          {{#each contexts}}
                          <tr>
                              <td>
                                  <a href="/admin/contexts/{{context_id}}" class="sp-u-link-strong">
                                      {{default name context_id}}
                                  </a>
                              </td>
                              <td class="sp-col-conversation">
                                  {{#if summary}}<span class="sp-conversation-preview" title="{{summary}}">{{summary}}</span>
                                  {{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
                              </td>
                              <td>{{#if model}}<span class="sp-badge sp-badge--info">{{model}}</span>{{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}</td>
                              <td class="sp-u-numeric">{{formatNumber request_count}}</td>
                              <td class="sp-u-numeric">{{formatNumber message_count}}</td>
                              <td class="sp-u-numeric">{{formatNumber total_tokens}}</td>
                              <td class="sp-u-numeric">${{cost_usd}}</td>
                              <td class="sp-col-date">
                                  {{#if last_activity}}<span title="{{formatDate last_activity}}">{{relativeTime last_activity}}</span>
                                  {{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
                              </td>
                          </tr>
                          {{/each}}
                          </tbody>
                      </table>
                    </div></div>
                    {{else}}
                    <p class="sp-u-text-tertiary sp-u-p-3">No contexts in the current filter.</p>
                    {{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No users in scope" message="Nobody under the selected group, project and time range has a conversation context. Widen the scope or clear the filters."}}
        {{/if}}
    </section>
    {{else}}
    <section aria-label="Contexts list" data-page="contexts" data-view="contexts">
        {{#if has_contexts}}
        {{#> components/table caption="Conversation contexts in the current filter" pagination=pagination}}
            <thead><tr>
                <th>User</th>
                <th>Context</th>
                <th>Session</th>
                <th class="sp-col-conversation">Conversation</th>
                <th class="sp-col-model">Model</th>
                {{> components/sort-header sort_headers.requests}}
                {{> components/sort-header sort_headers.messages}}
                {{> components/sort-header sort_headers.tokens}}
                {{> components/sort-header sort_headers.cost}}
                <th class="sp-col-status">Errors</th>
                {{> components/sort-header sort_headers.activity}}
            </tr></thead>
            <tbody>
            {{#each contexts}}
            <tr data-context-id="{{context_id}}"
                data-user-id="{{user_id}}"
                data-search-blob="{{toLowerCase (default display_name user_id)}} {{toLowerCase (default name context_id)}}">
                <td>
                    {{#if user_id}}
                    <a href="/admin/users/{{user_id}}" class="sp-user-cell">
                        <span class="sp-avatar sp-avatar-sm">{{initials (default display_name user_id)}}</span>
                        <span>{{default display_name user_id}}</span>
                    </a>
                    {{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
                </td>
                <td>
                    <a href="/admin/contexts/{{context_id}}" class="sp-u-link-strong">
                        {{default name context_id}}
                    </a>
                    {{#unless name}}<div class="sp-u-text-tertiary sp-u-text-xs">{{context_id}}</div>{{/unless}}
                    {{#if is_cli_session}}<span class="sp-badge sp-badge--muted">CLI session</span>{{/if}}
                </td>
                <td>
                    {{#if session_id}}<a href="/admin/sessions/{{session_id}}"><code class="sp-code-inline">{{session_id}}</code></a>
                    {{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
                </td>
                <td class="sp-col-conversation">
                    {{#if summary}}<span class="sp-conversation-preview" title="{{summary}}">{{summary}}</span>
                    {{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}
                </td>
                <td class="sp-col-model">{{#if model}}<span class="sp-badge sp-badge--info">{{model}}</span>{{else}}<span class="sp-u-text-tertiary">&mdash;</span>{{/if}}</td>
                <td class="sp-u-numeric">{{formatNumber request_count}}</td>
                <td class="sp-u-numeric">{{formatNumber message_count}}</td>
                <td class="sp-u-numeric" title="{{formatNumber input_tokens}} in / {{formatNumber output_tokens}} out">{{formatNumber total_tokens}}</td>
                <td class="sp-u-numeric">${{cost_usd}}</td>
                <td class="sp-col-status">
                    {{#if error_count}}<span class="sp-badge sp-badge--err">{{error_count}}</span>
                    {{else}}<span class="sp-u-text-tertiary">0</span>{{/if}}
                </td>
                <td class="sp-col-date">
                    {{#if last_activity}}<span title="{{formatDate last_activity}}">{{relativeTime last_activity}}</span>
                    {{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No contexts" message="No conversation context matches the selected scope and filters. Widen the scope, clear the search, or pick a longer time range."}}
        {{/if}}
    </section>
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-contexts.js"></script>
    {{/inline}}
{{/layout}}
