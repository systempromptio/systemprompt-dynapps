{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle=subtitle}}
        {{#*inline "header_meta"}}
        <nav class="sp-time-range__presets" role="group" aria-label="Time range" data-overview-ranges>
            {{#each ranges}}
            <a class="sp-time-range__btn{{#if this.is_active}} sp-time-range__btn--active{{/if}}" href="{{this.href}}" data-overview-range="{{this.preset}}"{{#if this.is_active}} aria-current="page"{{/if}}>{{this.label}}</a>
            {{/each}}
        </nav>
        <span class="sp-live" data-live-status hidden>
            <span class="sp-live__dot" aria-hidden="true"></span>
            <span class="sp-live__text" data-live-text aria-hidden="true">Live</span>
            <span class="sp-u-sr-only" role="status" aria-live="polite" data-live-announce></span>
            <button type="button" class="sp-btn sp-btn--xs sp-btn--ghost sp-live__toggle" data-live-toggle aria-pressed="false">Pause</button>
        </span>
        {{/inline}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Request log</a>
        <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analytics">Analytics</a>
        {{/inline}}
    {{/components/page-header}}

    {{> overview/live-body}}

    {{/inline}}
    {{#*inline "scripts"}}<script type="module" src="/js/pages/admin-overview.js?v={{css_version}}"></script>{{/inline}}
{{/layout}}
