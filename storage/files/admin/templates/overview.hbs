{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{#> components/page-header title=title subtitle=subtitle}}
        {{#*inline "header_meta"}}
        <nav class="sp-p-overview__ranges" aria-label="Time range">
            {{#each ranges}}
            <a class="sp-p-overview__range{{#if this.is_active}} is-active{{/if}}"
               href="{{this.href}}"{{#if this.is_active}} aria-current="page"{{/if}}>{{this.label}}</a>
            {{/each}}
        </nav>
        {{/inline}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Request log</a>
        <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analytics">Analytics</a>
        {{/inline}}
    {{/components/page-header}}

    <section aria-label="Headline figures">
        {{#if kpis.error}}{{> components/notice tone="err" title="Headline figures unavailable" message=kpis.error}}{{/if}}
        <div class="sp-kpi-grid">
            <a class="sp-kpi sp-kpi--link" href="{{kpis.requests.href}}">
                <span class="sp-kpi__label">{{kpis.requests.label}}</span>
                <span class="sp-kpi__value">{{kpis.requests.value}}</span>
                <span class="sp-kpi__sub">{{kpis.requests.sub}}</span>
                <span class="sp-delta{{#if kpis.requests.delta_dir}} sp-delta--{{kpis.requests.delta_dir}}{{/if}}">{{kpis.requests.delta}}</span>
                {{> components/kpi-sparkline kpis.spark}}
                <span class="sp-kpi__sub">{{kpis.spark_caption}}</span>
            </a>
            {{#each kpis.tiles}}
            {{> components/kpi label=this.label value=this.value note=this.sub href=this.href
                tone=this.tone delta=this.delta delta_dir=this.delta_dir}}
            {{/each}}
        </div>
    </section>

    <section aria-label="MCP servers">
        {{#> components/section title="MCP servers" count=mcp.count note=mcp.summary}}
            {{#*inline "section_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/mcp">All servers</a>{{/inline}}
        {{/components/section}}
        {{#if mcp.error}}{{> components/notice tone="err" title="Liveness unavailable" message=mcp.error}}{{/if}}
        {{#if mcp.has_rows}}
        {{#> components/table caption="Configured MCP servers and their last session heartbeat" modifier="sp-p-overview__mcp-table"}}
            <thead><tr>
                <th scope="col">Server</th>
                <th scope="col">State</th>
                <th scope="col">Last heartbeat</th>
                <th scope="col" class="sp-table__cell--num">Active sessions</th>
            </tr></thead>
            <tbody>
            {{#each mcp.rows}}
            <tr>
                <td><a href="{{this.href}}" class="sp-u-mono">{{this.id}}</a>
                    {{#if this.description}}<span class="sp-p-overview__hint">{{truncate this.description 70}}</span>{{/if}}</td>
                <td>{{> components/badge tone=this.state_tone text=this.state_label}}</td>
                <td class="sp-table__cell--date">{{this.heartbeat_display}}</td>
                <td class="sp-table__cell--num sp-u-num">{{this.sessions}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No MCP servers configured" message="Declare one in services/mcp/ and restart to see it here."}}
        {{/if}}
    </section>

    <section aria-label="Waiting on a person">
        {{#> components/section title="Waiting on a person" note="Calls held for approval, and usage the detector flagged in the last 24 hours."}}
            {{#*inline "section_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/governance">Governance</a>{{/inline}}
        {{/components/section}}
        {{#if queues.approvals_error}}{{> components/notice tone="err" title="Approval queue unavailable" message=queues.approvals_error}}{{/if}}
        <div class="sp-kpi-grid">
            {{> components/kpi label="Pending approvals" value=queues.approvals tone=queues.approvals_tone
                note="calls held by require_approval" href="/admin/governance/approvals"}}
            {{> components/kpi label="Open anomalies" value=queues.anomaly_count
                note="detected in the last 24 hours" href="/admin/analytics?tab=spend"}}
        </div>
        {{#if queues.anomalies_error}}{{> components/notice tone="err" title="Anomalies unavailable" message=queues.anomalies_error}}{{/if}}
        {{#if queues.has_anomalies}}
        {{#> components/table caption="Usage anomalies detected in the last 24 hours" modifier="sp-p-overview__queue-table"}}
            <thead><tr>
                <th scope="col">Metric</th>
                <th scope="col">Window</th>
                <th scope="col" class="sp-table__cell--num">Observed</th>
                <th scope="col" class="sp-table__cell--num">Baseline</th>
                <th scope="col">Severity</th>
            </tr></thead>
            <tbody>
            {{#each queues.anomalies}}
            <tr>
                <td>{{this.metric}}</td>
                <td class="sp-table__cell--date">{{this.window_display}}</td>
                <td class="sp-table__cell--num sp-u-num">{{this.observed_display}}</td>
                <td class="sp-table__cell--num sp-u-num">{{this.baseline_display}}</td>
                <td>{{this.multiple_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="Nothing flagged" message="No usage anomaly has been detected in the last 24 hours."}}
        {{/if}}
    </section>

    <div class="sp-p-overview__boards">
        {{> overview/scope-board board=projects}}
        {{> overview/scope-board board=groups}}
    </div>
    {{/inline}}
{{/layout}}
