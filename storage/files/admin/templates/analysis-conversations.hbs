{{#> layout page_title=title page_id=page}}
{{#*inline "content"}}
{{#> components/page-header title=title help=help subtitle="Every gateway conversation as the record shows it — who, which client and model, turns, tools and artifacts, errors and denials, tokens, cost, latency — with the judge's one verdict where it exists."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/skills">{{> components/icon name="skill"}} Skills</a> <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/conversations">{{> components/icon name="chat"}} Read conversations</a> {{#if manual_judge}}{{#if unjudged_in_view}}<form method="post" action="{{judge_all_url}}" class="sp-inventory-inline"><input type="hidden" name="query" value="{{filter.query}}"><input type="hidden" name="back" value="{{current_url}}"><button class="sp-btn sp-btn--sm sp-btn--outline" type="submit" title="Queue every unjudged conversation these filters select (up to 200) for the judge's next tick">{{> components/icon name="judge"}} Judge {{formatNumber unjudged_in_view}} unjudged</button></form> {{/if}}{{/if}}{{> components/export-button export}}{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
{{> analysis/report-banner report_banner}}
<div class="sp-aconv-range">{{> components/tabs tabs=range_links nav_label="Window"}}{{> components/scope-filter scope_filter}}</div>
<div class="sp-kpi-grid sp-kpi-grid--compact sp-aconv-kpis">
{{#each kpis.tiles}}{{> components/kpi label=label icon=icon value=value note=note tone=tone hint=hint spark=spark}}{{/each}}
</div>
<section class="sp-aconv-charts" aria-label="Over time">
{{#each charts}}<div class="sp-aconv-chart">{{> components/svg-line-chart this}}</div>{{/each}}
</section>
{{> components/filter-ribbon ribbon}}
<section class="sp-section sp-aconv-block" aria-label="Breakdown">
<header class="sp-aconv-block__head">{{> components/icon name="layers"}}<h2 class="sp-aconv-block__title">Breakdown</h2>{{> components/tabs tabs=breakdown_tabs nav_label="Breakdown"}}</header>
{{#> components/table caption=(concat "Conversations " breakdown_label) modifier="sp-aconv-breakdown"}}
<thead><tr><th scope="col">{{breakdown_label}}</th><th scope="col" class="sp-table__cell--num">Conversations</th><th scope="col" class="sp-table__cell--num">People</th><th scope="col" class="sp-table__cell--num">Turns</th><th scope="col" class="sp-table__cell--num" title="Tool calls">{{> components/icon name="wrench"}} Tools</th><th scope="col" class="sp-table__cell--num" title="Tool calls that produced something viewable">{{> components/icon name="file"}} Artifacts</th><th scope="col" class="sp-table__cell--num">Tokens</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col" class="sp-aconv-col-share" title="Share of the filtered set's cost">Share</th><th scope="col" class="sp-table__cell--num" title="Failed requests">Err</th><th scope="col" class="sp-table__cell--num" title="Denied tool calls">Denied</th><th scope="col" class="sp-table__cell--num" title="Judge outcome achieved">Achieved</th><th scope="col" class="sp-table__cell--num" title="AI judge: mean completion over the judged conversations in the bucket">{{> components/icon name="sparkle"}} AI</th><th scope="col">Top intent</th><th scope="col" class="sp-aconv-col-export"><span class="sp-u-sr-only">Export</span></th></tr></thead>
<tbody>
{{#each breakdown}}<tr><td class="sp-table__cell--primary">{{#if href}}<a class="sp-table__link" href="{{href}}">{{label}}</a>{{else}}{{label}}{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber conversations}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber users}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber turns}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber tool_calls}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber artifacts}}</td><td class="sp-table__cell--num sp-u-num">{{tokens_display}}</td><td class="sp-table__cell--num sp-u-num">{{cost_display}}</td><td class="sp-aconv-col-share"><span class="sp-aconv-bar" style="--sp-fill: {{cost_share_pct}}%"><i></i></span><span class="sp-aconv-bar__label">{{cost_share_pct}}%</span></td><td class="sp-table__cell--num sp-u-num"><span class="sp-aconv-num sp-aconv-num--{{errors_tone}}">{{errors}}</span></td><td class="sp-table__cell--num sp-u-num"><span class="sp-aconv-num sp-aconv-num--{{denied_tone}}">{{denied}}</span></td><td class="sp-table__cell--num sp-u-num">{{achieved_display}}</td><td class="sp-table__cell--num">{{> components/ai-score tone=completion_tone score=completion_display show_value=true label=(concat judged " judged")}}</td><td>{{top_category}}</td><td class="sp-aconv-col-export">{{#if export_href}}<a class="sp-aconv-export" href="{{export_href}}" data-export-open data-export-group-label="{{label}}" title="Download the conversations in this bucket" aria-label="Export {{label}}">{{> components/icon name="download"}}</a>{{/if}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="15">{{> components/empty-state heading="Nothing in this window" message="No conversation's last activity falls inside the window with these filters. Widen the window or clear a filter; the rollup job refreshes the record every minute."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<section class="sp-section sp-aconv-block" aria-label="Conversations">
<header class="sp-aconv-block__head">{{> components/icon name="chat"}}<h2 class="sp-aconv-block__title">{{count_label}}</h2></header>
{{#> components/table caption="Conversations" pagination=pagination modifier="sp-aconv-table"}}
<thead><tr><th scope="col" class="sp-aconv-col-select">{{> components/table-select header=true label="conversations"}}</th><th scope="col" class="sp-aconv-col-title">Conversation</th><th scope="col" class="sp-aconv-col-person">Person</th><th scope="col" class="sp-aconv-col-client">Client · model</th>{{> components/sort-header sort_headers.turns}}{{> components/sort-header sort_headers.tools}}<th scope="col" class="sp-table__cell--num" title="Tool calls that produced something viewable — files, cards, UI, retained bodies">{{> components/icon name="file"}}</th>{{> components/sort-header sort_headers.errors}}{{> components/sort-header sort_headers.tokens}}{{> components/sort-header sort_headers.cost}}{{> components/sort-header sort_headers.latency}}{{> components/sort-header sort_headers.duration}}<th scope="col" class="sp-aconv-col-spark" title="Tokens per turn, last 24 turns">{{> components/icon name="spark"}}</th><th scope="col" class="sp-aconv-col-skills">Skills</th>{{> components/sort-header sort_headers.activity}}{{> components/sort-header sort_headers.completion}}</tr></thead>
<tbody>
{{#each rows}}<tr data-context-id="{{context_key}}" data-category="{{judge.category}}">
<td class="sp-aconv-col-select">{{> components/table-select id=context_key label=title}}</td>
<td class="sp-table__cell--primary sp-aconv-cell-title"><a class="sp-table__link" href="{{href}}" title="{{context_key}}">{{title}}</a>{{#if judge.judged}}<div class="sp-aconv-meta"><span class="sp-aconv-intent">{{judge.category_label}}</span> · <span class="sp-aconv-outcome sp-aconv-outcome--{{judge.outcome_tone}}">{{judge.outcome}}</span>{{#if judge.summary}} · <span class="sp-aconv-summary">{{judge.summary}}</span>{{/if}}</div>{{else}}<div class="sp-aconv-meta">{{#if judge.pending}}queued for the AI judge{{else}}not judged yet{{/if}}</div>{{/if}}</td>
<td class="sp-aconv-cell-person"><a class="sp-table__link" href="{{user_href}}" title="{{user_key}}">{{display_name}}</a>{{#if group_name}}<div class="sp-aconv-meta">{{group_name}}{{#if project_name}} · {{project_name}}{{/if}}</div>{{else}}{{#if project_name}}<div class="sp-aconv-meta">{{project_name}}</div>{{/if}}{{/if}}</td>
<td class="sp-aconv-cell-client"><span class="sp-badge sp-badge--{{client.tone}}" title="{{client.title}}">{{client.label}}</span><div class="sp-aconv-meta sp-aconv-model" title="{{model}}{{#each extra_models}} · {{this}}{{/each}}">{{model}}{{#if extra_models}} <span class="sp-aconv-more">+{{extra_models_count}}</span>{{/if}}</div></td>
<td class="sp-table__cell--num sp-u-num">{{turns}}</td>
<td class="sp-table__cell--num sp-u-num"><a class="sp-aconv-num sp-aconv-num--{{tools_tone}} sp-aconv-cell-link" href="{{tools_href}}" title="{{tools_title}} — opens the tool calls">{{tools_display}}</a></td>
<td class="sp-table__cell--num sp-u-num">{{#if artifacts}}<a class="sp-aconv-num sp-aconv-num--accent sp-aconv-cell-link" href="{{artifacts_href}}" title="{{artifacts}} artifacts — opens them">{{artifacts}}</a>{{else}}<span class="sp-aconv-num sp-aconv-num--muted">0</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num"><span class="sp-aconv-num sp-aconv-num--{{errors_tone}}" title="Failed requests">{{errors}}</span>{{#if denied}} <span class="sp-aconv-num sp-aconv-num--{{denied_tone}}" title="Denied tool calls">⛔{{denied}}</span>{{/if}}{{#if safety}} <span class="sp-aconv-num sp-aconv-num--{{safety_tone}}" title="Safety findings">⚑{{safety}}</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num sp-aconv-cell-tokens" title="{{tokens_title}}">{{tokens_display}}<span class="sp-aconv-cache sp-aconv-cache--{{cache_tone}}" style="--sp-fill: {{cache_pct}}%" title="{{cache_pct}}% of what the models read came from cache"><i></i></span></td>
<td class="sp-table__cell--num sp-u-num">{{cost_display}}</td>
<td class="sp-table__cell--num sp-u-num"><span class="sp-aconv-num sp-aconv-num--{{latency_tone}}">{{latency_display}}</span></td>
<td class="sp-table__cell--num sp-u-num">{{duration_display}}</td>
<td class="sp-aconv-cell-spark">{{> components/sparkline spark}}</td>
<td class="sp-aconv-cell-skills"><div class="sp-aconv-skills">{{#each skills}}<a class="sp-aconv-skill{{#if hooked}} sp-aconv-skill--hooked{{/if}}" href="{{href}}" title="{{name}} — {{#if hooked}}reported by the harness hook{{else}}read from the transcript by the judge{{/if}}; opens the skill's analysis">{{name}}</a>{{else}}<span class="sp-u-text-tertiary">—</span>{{/each}}</div></td>
<td class="sp-col-date"><time datetime="{{last_full}}" title="{{last_full}}">{{last_display}}</time></td>
<td class="sp-aconv-col-judge"><div class="sp-verdict">{{#if judge.judged}}{{> components/ai-score tone=judge.tone score=judge.completion_display href=(concat href "#judge")}}<div class="sp-verdict__card" role="tooltip"><span class="sp-verdict__score sp-aconv-score sp-aconv-score--{{judge.tone}}">{{judge.completion_display}}</span><b class="sp-verdict__head">{{judge.category_label}} · {{judge.outcome}}</b><p class="sp-verdict__summary">{{judge.summary}}</p>{{#if judge.rationale}}<p class="sp-verdict__rationale">{{judge.rationale}}</p>{{/if}}</div>{{else}}{{#if judge.pending}}{{> components/ai-score tone="muted" score="—" pending=true}}{{else}}{{#if judge.can_judge}}{{> components/ai-score tone="muted" judge_url=judge.judge_url back_url=back_url}}{{else}}{{> components/ai-score tone="muted" score="not judged yet"}}{{/if}}{{/if}}{{/if}}</div></td>
</tr>
{{else}}<tr class="sp-table__empty"><td colspan="16">{{> components/empty-state heading="No conversations match" message="Clear a filter or widen the window. A conversation appears here once the gateway has recorded a turn for it; the rollup job refreshes the record every minute."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
{{#if manual_judge}}{{> components/bulk-bar noun="conversations" export_dataset="analysis-conversations" judge_url=judge_all_url back=current_url}}{{else}}{{> components/bulk-bar noun="conversations" export_dataset="analysis-conversations"}}{{/if}}
</section>
{{/inline}}{{#*inline "scripts"}}<script type="module" src="/js/components/sp-chart.js?v={{css_version}}"></script>{{/inline}}{{/layout}}
