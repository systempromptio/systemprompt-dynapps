{{#> layout title=title page=page}}
{{#*inline "content"}}
{{#> components/page-header title=title subtitle="What people are doing with the gateway: purpose, outcome, skills and cost per conversation, as the classifier judged them."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/skills">Skill usage</a> <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/contexts">By person</a> <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/conversations">Read conversations &rarr;</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid sp-kpi-grid--compact">
{{> components/kpi label="Conversations" value=(formatNumber kpis.conversations) note=(concat kpis.unclassified " awaiting classification")}}
{{> components/kpi label="People" value=(formatNumber kpis.users) note="distinct users behind them"}}
{{> components/kpi label="Turns" value=(formatNumber kpis.turns) note="human prompts answered"}}
{{> components/kpi label="Tool calls" value=(formatNumber kpis.tool_calls) note="on those turns"}}
{{> components/kpi label="Cost" value=kpis.cost_display note=(concat kpis.tokens_display " tokens")}}
{{> components/kpi label="Achieved" value=kpis.achieved_display note="conversations the judge read as achieved" tone="ok"}}
</div>
{{#> components/toolbar toolbar_count=count_label}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter" method="get" action="/admin/analysis/conversations" role="search" id="aconv-filter-form">
<input type="hidden" name="group" value="{{filter.group}}">
<input type="hidden" name="project" value="{{filter.project}}">
<input type="hidden" name="by" value="{{filter.by}}">
<input type="hidden" name="sort" value="{{filter.sort}}">
<input type="hidden" name="dir" value="{{filter.dir}}">
<label class="sp-u-sr-only" for="aconv-since">Time range</label>
<select id="aconv-since" name="since" class="sp-search-input">
<option value="24h"{{#if (eq filter.since "24h")}} selected{{/if}}>Last 24 hours</option>
<option value="7d"{{#if (eq filter.since "7d")}} selected{{/if}}>Last 7 days</option>
<option value="30d"{{#if (eq filter.since "30d")}} selected{{/if}}>Last 30 days</option>
<option value="90d"{{#if (eq filter.since "90d")}} selected{{/if}}>Last 90 days</option>
<option value="all"{{#if (eq filter.since "all")}} selected{{/if}}>All time</option>
</select>
<label class="sp-u-sr-only" for="aconv-category">Category</label>
<select id="aconv-category" name="category" class="sp-search-input">
<option value="">All categories</option>
{{#each categories}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
</select>
<label class="sp-u-sr-only" for="aconv-outcome">Outcome</label>
<select id="aconv-outcome" name="outcome" class="sp-search-input">
<option value="">All outcomes</option>
{{#each outcomes}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
</select>
<label class="sp-u-sr-only" for="aconv-skill">Skill</label>
<select id="aconv-skill" name="skill" class="sp-search-input">
<option value="">All skills</option>
{{#each skills}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
</select>
<label class="sp-u-sr-only" for="aconv-user">Person</label>
<select id="aconv-user" name="user_id" class="sp-search-input">
<option value="">All people</option>
{{#each users}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
</select>
<label class="sp-u-sr-only" for="aconv-q">Search</label>
<input type="search" id="aconv-q" class="sp-search-input" name="q" placeholder="title, summary, tag or person" value="{{filter.q}}">
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply</button>
</form>
{{/inline}}
{{#*inline "toolbar_actions"}}{{> components/scope-filter scope_filter}}{{/inline}}
{{/components/toolbar}}
<section class="sp-section sp-aconv-block" aria-label="Breakdown">
{{> components/tabs tabs=breakdown_tabs nav_label="Breakdown"}}
{{#> components/table caption=(concat "Conversations " breakdown_label)}}
<thead><tr><th scope="col">{{breakdown_label}}</th><th scope="col" class="sp-table__cell--num">Conversations</th><th scope="col" class="sp-table__cell--num">People</th><th scope="col" class="sp-table__cell--num">Turns</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col" class="sp-table__cell--num">Achieved</th><th scope="col">Top category</th></tr></thead>
<tbody>
{{#each breakdown}}<tr><td class="sp-table__cell--primary">{{#if href}}<a class="sp-table__link" href="{{href}}">{{label}}</a>{{else}}{{label}}{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber conversations}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber users}}</td><td class="sp-table__cell--num sp-u-num">{{formatNumber turns}}</td><td class="sp-table__cell--num sp-u-num">{{cost_display}}</td><td class="sp-table__cell--num sp-u-num">{{achieved_display}}</td><td>{{top_category}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="7">{{> components/empty-state title="Nothing classified in this window" message="The classifier runs every five minutes and reads a conversation once it has been quiet for thirty minutes. Widen the window, or check that the conversation_classifier job is enabled."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<section class="sp-section sp-aconv-block" aria-label="Conversations">
{{#> components/table caption="Classified conversations" pagination=pagination modifier="sp-aconv-table"}}
<thead><tr><th scope="col">Conversation</th><th scope="col">Person</th><th scope="col">Category</th><th scope="col">Summary</th><th scope="col">Outcome</th><th scope="col">Skills</th>{{> components/sort-header sort_headers.turns}}<th scope="col" class="sp-table__cell--num">Tools</th>{{> components/sort-header sort_headers.cost}}{{> components/sort-header sort_headers.activity}}{{#if can_evaluate}}<th scope="col">Actions</th>{{/if}}</tr></thead>
<tbody>
{{#each rows}}<tr data-context-id="{{context_key}}" data-category="{{category}}">
<td class="sp-table__cell--primary sp-aconv-cell-title"><a class="sp-table__link" href="{{href}}" title="{{context_key}}">{{title}}</a><div class="sp-aconv-meta">{{client_kind}}{{#if model}} · {{model}}{{/if}}{{#if session_href}} · <a href="{{session_href}}">session</a>{{/if}}</div></td>
<td class="sp-aconv-cell-person">{{#if user_href}}<a class="sp-table__link" href="{{user_href}}" title="{{user_key}}">{{display_name}}</a>{{else}}{{display_name}}{{/if}}{{#if group_name}}<div class="sp-aconv-meta">{{group_name}}{{#if project_name}} · {{project_name}}{{/if}}</div>{{else}}{{#if project_name}}<div class="sp-aconv-meta">{{project_name}}</div>{{/if}}{{/if}}</td>
<td>{{> components/badge tone="info" text=category_label}}</td>
<td class="sp-aconv-cell-summary"><span class="sp-aconv-summary" title="{{summary}}">{{summary}}</span>{{#if tags}}<div class="sp-aconv-tags">{{#each tags}}<span class="sp-aconv-tag">{{this}}</span>{{/each}}</div>{{/if}}</td>
<td>{{> components/badge tone=outcome_tone text=outcome}}<div class="sp-aconv-meta" title="Judge confidence">{{confidence_display}}</div></td>
<td class="sp-aconv-cell-skills">{{#each skills}}<span class="sp-aconv-skill{{#if hooked}} sp-aconv-skill--hooked{{/if}}" title="{{#if hooked}}Reported by the harness hook{{else}}Read from the transcript by the judge{{/if}}">{{name}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/each}}</td>
<td class="sp-table__cell--num sp-u-num">{{turns}}</td>
<td class="sp-table__cell--num sp-u-num">{{tool_calls}}{{#if errors}} <span class="sp-u-text-danger">({{errors}} failed)</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num" title="{{tokens_display}} tokens">{{cost_display}}</td>
<td class="sp-col-date"><time datetime="{{last_full}}" title="{{last_full}}">{{last_display}}</time></td>
{{#if ../can_evaluate}}<td>{{#if evaluate_url}}<form method="post" action="{{evaluate_url}}" class="sp-inventory-inline"><input type="hidden" name="back" value="{{../back_url}}"><button class="sp-btn sp-btn--xs sp-btn--outline" type="submit" title="Score this session on every criterion now and come back here">Evaluate</button></form>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>{{/if}}
</tr>
{{else}}<tr class="sp-table__empty"><td colspan="11">{{> components/empty-state title="No classified conversations match" message="Clear a filter, or wait for the classifier: it runs every five minutes over conversations that have been quiet for thirty minutes and have at least one turn."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<details class="sp-analysis-definitions"><summary>Where these numbers come from</summary>
<p>Every conversation is a gateway context: its turns, tool calls, tokens and cost are rolled up from the same request records the Sessions and By-person pages read. Group and project are the person's primary containers.</p>
<p>The <em>category</em>, <em>summary</em>, <em>outcome</em> and judge-read skills come from the <code>conversation_classifier</code> job. It reads a conversation once it has been quiet for thirty minutes, sends the transcript (credentials redacted) to the configured model with the response schema enforced by the provider API, and records one verdict per conversation. A conversation that keeps growing is read again. Categories are fixed: development, business analysis, operations, admin &amp; config, writing &amp; comms, research &amp; learning, other.</p>
<p>Skills marked solid were reported by the harness hook and are evidence; outlined ones are what the judge read from the transcript. The judge's own gateway calls are audited under the job's identity and never counted as conversations.</p>
</details>
{{/inline}}{{/layout}}
