{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/page-header title=title}}

    <div class="sp-toolbar" role="toolbar" aria-label="Actions">
        <div class="sp-toolbar__search">
            <input type="text" class="sp-search-input" placeholder="Search users..." id="user-search" aria-label="Search users...">
        </div>
        <button type="button" class="sp-btn sp-btn--primary" id="btn-add-user" data-action="create-user">+ Add User</button>
    </div>
    {{> components/create-user-panel}}

    {{> components/scope-filter scope_filter}}

    <section aria-label="Users list" data-page="users">
    {{#if groups}}
    {{#> components/table}}
        <thead><tr>
            <th>User</th>
            <th>Roles</th>
            <th title="Groups the directory or an admin placed this account in">Groups</th>
            <th title="Projects this account is a member of">Projects</th>
            <th title="Marketplaces granted by YAML default plus any DB overrides">Marketplaces</th>
            <th class="sp-col-status" title="Active access tokens, coloured by last-used">Tokens</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Lifetime model tokens consumed via the gateway">Model tokens</th>
            <th class="sp-u-numeric sp-table__cell--num">Sessions</th>
            <th class="sp-col-status">Status</th>
            <th class="sp-col-date">Joined</th>
            <th class="sp-col-date">Last Active</th>
            <th class="sp-table__cell--actions"></th>
        </tr></thead>
        {{#each groups}}
        <tbody class="sp-table-group" data-group="{{group_id}}">
            <tr class="sp-table-group-header">
                <th colspan="12">
                    <span class="sp-table-group-title">
                        <span class="sp-table-group-name">{{group_name}}</span>
                        <span class="sp-table-group-count">{{user_count}} user{{#unless (eq user_count 1)}}s{{/unless}}</span>
                    </span>
                    <span class="sp-table-group-stats">
                        {{#if total_tokens}}<span title="Lifetime tokens">{{formatNumber total_tokens}} tokens</span>{{/if}}
                        {{#if total_sessions}}<span title="Total sessions">&middot; {{total_sessions}} sessions</span>{{/if}}
                    </span>
                </th>
            </tr>
            {{#each users}}
            <tr data-user-id="{{user_id}}" data-user-name="{{toLowerCase (default display_name user_id)}}" data-user-email="{{toLowerCase (default email "")}}">
                <td>
                    <a href="/admin/user/?id={{user_id}}" class="sp-user-cell">
                        <span class="sp-avatar sp-avatar-sm">{{initials (default display_name user_id)}}</span>
                        <span class="sp-user-cell-text">
                            <span class="sp-user-cell-name">{{default display_name user_id}}</span>
                            {{#if email}}<span class="sp-user-cell-email">{{email}}</span>{{/if}}
                        </span>
                    </a>
                </td>
                <td>
                    {{#if roles}}{{#each roles}}<span class="sp-badge sp-badge--muted">{{this}}</span> {{/each}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}
                </td>
                <td class="sp-scope-chips">
                    {{#if group_ids}}{{#each group_ids}}<a class="sp-badge sp-badge--info" href="/admin/users?group={{this}}">{{default (lookup ../../../group_names this) this}}</a> {{/each}}{{else}}<span class="sp-u-text-tertiary">Unassigned</span>{{/if}}
                </td>
                <td class="sp-scope-chips">
                    {{#if project_ids}}{{#each project_ids}}<a class="sp-badge sp-badge--warn" href="/admin/users?project={{this}}">{{default (lookup ../../../project_names this) this}}</a> {{/each}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}
                </td>
                <td>
                    {{#if marketplaces}}{{#each marketplaces}}<span class="sp-badge {{#if (eq source "override")}}sp-badge--info{{else}}sp-badge--warn{{/if}}" title="{{#if (eq source "override")}}DB override{{else}}YAML default{{/if}}">{{name}}</span> {{/each}}{{else}}<span class="sp-u-text-tertiary">None</span>{{/if}}
                </td>
                <td class="sp-col-status">
                    {{#if tokens_count}}
                        <span class="sp-token-pill sp-token-pill--{{token_freshness}}" title="{{tokens_count}} token{{#unless (eq tokens_count 1)}}s{{/unless}} ({{token_freshness}})">
                            <span class="sp-agent-dot"></span>{{tokens_count}}
                        </span>
                    {{else}}
                        <span class="sp-u-text-tertiary">0</span>
                    {{/if}}
                </td>
                <td class="sp-u-numeric" title="{{lifetime_tokens}} tokens">{{#if lifetime_tokens}}{{formatNumber lifetime_tokens}}{{else}}<span class="sp-u-text-tertiary">0</span>{{/if}}</td>
                <td class="sp-u-numeric">{{sessions}}</td>
                <td class="sp-col-status">{{#if is_active}}<span class="sp-badge sp-badge--ok">Active</span>{{else}}<span class="sp-badge sp-badge--muted">Inactive</span>{{/if}}</td>
                <td class="sp-col-date">{{#if created_at}}<span title="{{formatDate created_at}}">{{relativeTime created_at}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
                <td class="sp-col-date">{{#if last_active}}<span title="{{formatDate last_active}}">{{relativeTime last_active}}</span>{{else}}Never{{/if}}</td>
                <td class="sp-table__cell--actions"><button class="sp-btn--actions" data-user-id="{{user_id}}" aria-label="Actions for {{default display_name user_id}}" aria-haspopup="true" aria-expanded="false" type="button">&#8943;</button></td>
            </tr>
            {{/each}}
        </tbody>
        {{/each}}
    {{/components/table}}
    <div id="user-search-empty" hidden>
        {{> components/empty-state message="No users match that search."}}
    </div>
    {{else}}
    {{> components/empty-state message="No users found."}}
    {{/if}}
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-users.js"></script>
    {{/inline}}
{{/layout}}
