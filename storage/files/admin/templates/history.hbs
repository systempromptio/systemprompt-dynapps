{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle="Claude Code sessions and gateway conversations, with prompts, models, turns, tokens and cost. Full-text search runs over the redacted transcript."}}
        {{#*inline "meta"}}
            <span>Showing {{scope_label}}.</span>
            {{#if viewer_is_admin}}{{> components/badge tone="accent" text="admin view"}}{{/if}}
        {{/inline}}
        {{#*inline "actions"}}
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/profile">Profile</a>
            {{#if filter_user_id}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/history">Clear user filter</a>{{/if}}
        {{/inline}}
    {{/components/page-header}}

    <section aria-label="Conversation history">
        {{#> components/toolbar count=(concat pagination.total_rows " conversations")}}
            {{#*inline "filters"}}
            <form method="get" action="/admin/history" class="sp-toolbar__search" role="search">
                {{#if filter_user_id}}<input type="hidden" name="user_id" value="{{filter_user_id}}">{{/if}}
                <label class="sp-u-sr-only" for="history-q">Search conversation history</label>
                <input type="search" id="history-q" name="q" value="{{search_query}}" class="sp-search-input"
                       placeholder="Search prompts and responses…">
                <button type="submit" class="sp-btn sp-btn--sm">Search</button>
                {{#if search_query}}<a href="/admin/history" class="sp-btn sp-btn--sm sp-btn--outline">Clear</a>{{/if}}
            </form>
            {{/inline}}
        {{/components/toolbar}}

        {{#if has_rows}}
        {{#> components/table caption="Your conversations, newest first" pagination=pagination}}
            <thead><tr>
                <th scope="col" aria-sort="descending" class="sp-table__cell--date">When</th>
                <th scope="col" aria-sort="none">Conversation</th>
                <th scope="col" aria-sort="none">Source</th>
                <th scope="col" aria-sort="none">User</th>
                <th scope="col" aria-sort="none">Model</th>
                <th scope="col" aria-sort="none" class="sp-table__cell--num">Turns</th>
                <th scope="col" aria-sort="none" class="sp-table__cell--num">Tokens</th>
                <th scope="col" aria-sort="none" class="sp-table__cell--num">Cost</th>
            </tr></thead>
            <tbody>
            {{#each rows}}
            <tr>
                <td class="sp-table__cell--date">{{this.when_local}}</td>
                <td class="sp-table__cell--stacked">
                    {{#if this.detail_url}}<a href="{{this.detail_url}}">{{this.title}}</a>{{else}}<span>{{this.title}}</span>{{/if}}
                    <span class="sp-u-mono sp-u-text-xs sp-u-text-tertiary">{{this.short_id}}</span>
                    {{#if this.snippet}}<span class="sp-u-text-xs sp-u-text-tertiary">{{this.snippet}}</span>
                    {{else if this.preview}}<span class="sp-u-text-xs sp-u-text-tertiary">{{this.preview}}</span>{{/if}}
                </td>
                <td>{{> components/badge tone="info" text=this.source}}</td>
                <td>{{#if this.is_own}}{{> components/badge tone="muted" text="you"}}{{else}}<span class="sp-u-mono">{{this.user_id}}</span>{{/if}}</td>
                <td class="sp-table__cell--mono">{{default this.model "—"}}</td>
                <td class="sp-table__cell--num sp-u-num">{{formatNumber this.entries_counted}}</td>
                <td class="sp-table__cell--num sp-u-num">{{this.tokens_display}}</td>
                <td class="sp-table__cell--num sp-u-num sp-u-mono">{{default this.cost_display "—"}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state title="No conversations match"
            message="Clear the search, or start a Claude Code session or a gateway conversation to populate history."}}
        {{/if}}
    </section>
    {{/inline}}
{{/layout}}
