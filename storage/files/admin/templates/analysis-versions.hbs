{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Trace each skill from the source that declared it, through the generation that observed it, to the immutable revision it published."}}
{{#*inline "header_actions"}}{{#if can_manage}}<form method="post" action="/admin/analysis/versions/capture-baseline" class="sp-inventory-inline"><button class="sp-btn sp-btn--sm sp-btn--outline" type="submit">Capture Super Admin baseline</button></form>{{/if}}{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
{{#if hash}}<p class="sp-generation-filter">{{#if no_hash_match}}No generation carries hash <span class="sp-hash">{{hash}}</span>.{{else}}Showing only generations carrying hash <span class="sp-hash">{{hash}}</span>.{{/if}} <a href="/admin/analysis/versions">Clear filter</a></p>{{/if}}
<details class="sp-how-to-read">
<summary class="sp-how-to-read__summary">How to read this page</summary>
<p>Sources are where declarations come from; a bundle is a kit the profile pins by digest, and base is this repository's own services tree. A generation is minted only when the observed entry set moves, so every timeline row is a real change. The resources below are imported and authored revisions — importing a baseline does not change active skills or start an experiment.</p>
</details>

<section aria-label="Marketplace sources">
{{> components/section title="Marketplace sources" note="Where the declarations come from, and the generation that first carried each hash."}}
{{#> components/table caption="Declaration sources with their hashes and first observation" modifier="sp-source-table"}}
<thead><tr><th scope="col">Source</th><th scope="col">Version</th><th scope="col">Content hash</th><th scope="col">Pinned</th><th scope="col">Active</th><th scope="col">First seen</th><th scope="col">Last changed</th><th scope="col" class="sp-table__cell--actions">Manage</th></tr></thead>
<tbody>
{{#each sources}}<tr class="sp-source-row{{#if highlighted}} sp-source-row--match{{/if}}">
<td class="sp-table__cell--primary">{{name}} <span class="sp-u-mono sp-u-text-tertiary">{{owner_key}}</span></td>
<td>{{#if version}}{{version}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{#if content_hash}}<span class="sp-hash" title="{{content_hash}}">{{content_hash_short}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{#if pinned_digest}}<span class="sp-hash" title="{{pinned_digest}}">{{truncate pinned_digest 19}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{#if active_digest}}<span class="sp-hash" title="{{active_digest}}">{{truncate active_digest 19}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{#if first_generation}}gen {{first_generation}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{#if last_changed}}{{relativeTime last_changed}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td class="sp-table__cell--actions"><a class="sp-table__link" href="{{../sync_href}}">Code ↔ Instance</a></td>
</tr>{{else}}<tr class="sp-table__empty"><td colspan="8">{{> components/empty-state title="No sources resolved" message="The profile pins no bundles and the base tree has not been hashed yet."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>

<section id="generation-timeline" aria-label="Generation timeline">
{{> components/section title="Generation timeline" note="An inventory generation is minted only when the observed entry set moves, so every row here is a real change to what the instance serves."}}
<div class="sp-table"><div class="sp-table__scroll" tabindex="0"><table class="sp-table__el sp-generation-table" data-table="primary">
<caption class="sp-u-sr-only">Inventory generations with their composed hash, entry movement and the publications they triggered</caption>
<thead><tr><th scope="col">Generation</th><th scope="col">Observed</th><th scope="col">Composed hash</th><th scope="col">Entries · change</th><th scope="col">Publications</th><th scope="col" class="sp-table__cell--actions">Compare</th></tr></thead>
<tbody>
{{#each generations}}<tr class="sp-generation-row{{#if highlighted}} sp-generation-row--match{{/if}}">
<td class="sp-table__cell--primary">{{generation}}</td>
<td>{{relativeTime observed_at}}</td>
<td>{{#if composed_hash}}<span class="sp-hash" title="{{composed_hash}}">{{composed_hash_short}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td>{{entries}} <span class="sp-generation-delta"><span class="sp-generation-delta__add">+{{added}}</span> <span class="sp-generation-delta__remove">−{{removed}}</span> <span class="sp-generation-delta__change">~{{changed}}</span></span></td>
<td>{{publications}}</td>
<td class="sp-table__cell--actions">{{#if compare_href}}<a class="sp-table__link" href="{{compare_href}}">Compare</a>{{else}}<span class="sp-u-text-tertiary">first</span>{{/if}}</td>
</tr>{{else}}<tr class="sp-table__empty"><td colspan="6">{{#if no_hash_match}}<div class="sp-empty" role="status"><p class="sp-empty__title">No generation carries this hash</p><p>The hash filter <span class="sp-hash">{{hash_short}}</span> matched no generation&#39;s sources. <a href="/admin/analysis/versions">Clear the filter</a> to see the full timeline.</p></div>{{else}}{{> components/empty-state title="No generations observed" message="The inventory has not reconciled yet. Press Sync inventory now on Campaigns, or wait for the scheduled pass."}}{{/if}}</td></tr>{{/each}}
</tbody>
</table></div></div>
</section>

<section aria-label="Managed resources">
{{> components/section title="Managed resources" note="Every captured skill and the revision chain behind it."}}
{{#> components/table caption="Managed resources and their captured revisions"}}
<thead><tr><th scope="col">Resource</th><th scope="col">Source</th><th scope="col">Revisions</th><th scope="col">Evidence</th></tr></thead>
<tbody>
{{#each resources}}<tr><td class="sp-table__cell--primary"><a href="/admin/analysis/versions/{{id}}">{{resource_key}}</a> <span class="sp-u-text-tertiary">{{kind}}</span></td><td>{{source_name}}</td><td>{{revision_count}}</td><td>{{#if latest_revision}}<a href="/admin/analysis/revisions/{{latest_revision}}">Latest revision</a>{{else}}<span class="sp-u-text-tertiary">No revision captured</span>{{/if}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="4">{{> components/empty-state title="No managed resources" message="Nothing is captured in your authoring scope. Capture the current baseline to begin."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<nav class="sp-analysis-pagination" aria-label="Version pages">{{#if previous}}<a class="sp-btn sp-btn--outline" href="{{previous}}">Previous</a>{{/if}}{{#if next}}<a class="sp-btn sp-btn--outline" href="{{next}}">Next</a>{{/if}}</nav>
{{/inline}}{{/layout}}
