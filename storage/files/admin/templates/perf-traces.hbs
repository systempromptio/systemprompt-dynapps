{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Trace Explorer"
        subtitle="Every gateway call, governance decision, and tool invocation grouped into a trace. Click any row to see the full waterfall."}}


    {{> components/time-range time_range}}
    {{> components/scope-filter scope_filter}}
    {{> components/identity-filter-ribbon filter_ribbon}}

    <section class="sp-kpi-grid" aria-label="Trace summary">
      {{> components/kpi label="Traces" value=stats.total_traces
          subtitle="in window"}}
      {{> components/kpi label="Denied" value=stats.deny_count tone="err"
          href=stats.deny_url active=stats.deny_active
          subtitle="traces with a deny"
          hint="Show only traces containing a denied decision"}}
      {{> components/kpi label="Errors" value=stats.error_count tone="warn"
          href=stats.error_url active=stats.error_active
          subtitle="traces with a failure"
          hint="Show only traces containing a failed request"}}
      {{> components/kpi label="Cost" value=stats.cost_display
          subtitle="billed in window"}}
      {{> components/kpi label="Tokens" value=stats.tokens_display
          subtitle="total in / out"}}
      {{> components/kpi label="p95 active" value=stats.p95_display
          subtitle=(concat "p50 " stats.p50_display " · p99 " stats.p99_display)
          hint="Percentiles over request latency, across traces that issued at least one request"}}
    </section>

    {{#if has_traces}}
      {{#> components/table caption="Traces in the selected window" modifier="sp-trace-table"}}
            <thead><tr>
              {{> components/sort-header sort_headers.started}}
              <th class="sp-col-trace">Trace</th>
              <th class="sp-col-identity">Identity</th>
              <th class="sp-col-model">Model</th>
              {{> components/sort-header sort_headers.activity}}
              {{> components/sort-header sort_headers.tokens}}
              {{> components/sort-header sort_headers.cost}}
              {{> components/sort-header sort_headers.duration}}
              <th class="sp-col-status">Status</th>
            </tr></thead>
            <tbody>
            {{#each traces}}
            <tr class="sp-trace-row">
              <td class="sp-col-started">
                <div class="sp-table__cell--stacked">
                  <span class="sp-table__cell--primary">{{this.started_at_time}}</span>
                  <span class="sp-table__cell--secondary">{{this.started_at_day}}</span>
                </div>
              </td>
              <td class="sp-col-trace">
                <div class="sp-table__cell--stacked">
                  <a href="{{this.detail_url}}" class="sp-trace-row__id" title="{{this.session_id}}">
                    <code class="sp-code-inline">{{this.session_id_short}}</code>
                  </a>
                  {{#if this.trace_id_short}}
                    <span class="sp-table__cell--secondary" title="{{this.trace_id}}">trace {{this.trace_id_short}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="sp-col-identity">
                <div class="sp-table__cell--stacked">
                  <span class="sp-table__cell--primary" title="{{this.user_id}}">{{this.user_label}}</span>
                  {{#if this.agent_id}}
                    <span class="sp-table__cell--secondary">{{this.agent_id}}{{#if this.agent_scope}} · {{this.agent_scope}}{{/if}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="sp-col-model">
                {{#if this.model_short}}
                  <div class="sp-table__cell--stacked">
                    <span class="sp-table__cell--primary" title="{{this.model}}">{{this.model_short}}</span>
                    {{#if this.provider}}<span class="sp-table__cell--secondary">{{this.provider}}</span>{{/if}}
                  </div>
                {{else}}<span class="sp-table__cell--muted">—</span>{{/if}}
              </td>
              <td class="sp-col-spans">
                <div class="sp-table__cell--stacked">
                  <span class="sp-table__cell--primary">{{this.activity_display}}</span>
                  {{#if this.governance_display}}
                    <span class="sp-table__cell--secondary">{{this.governance_display}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="sp-col-tokens">
                <div class="sp-table__cell--stacked">
                  <span class="sp-table__cell--primary">{{this.tokens_display}}</span>
                  {{#if this.tokens_split_display}}
                    <span class="sp-table__cell--secondary">{{this.tokens_split_display}}</span>
                  {{/if}}
                </div>
              </td>
              <td class="sp-col-cost">{{this.cost_display}}</td>
              <td class="sp-col-duration">
                <div class="sp-table__cell--stacked">
                  <span class="sp-table__cell--primary">{{this.active_display}}</span>
                  <span class="sp-table__cell--secondary">{{this.window_display}} window</span>
                </div>
              </td>
              <td class="sp-col-status">
                <div class="sp-trace-row__badges">
                  {{#if this.has_deny}}<span class="sp-badge sp-badge--err" title="{{this.deny_count}} denied decision(s)">DENY {{this.deny_count}}</span>{{/if}}
                  {{#if this.has_error}}<span class="sp-badge sp-badge--warn">ERROR</span>{{/if}}
                  {{#unless this.has_deny}}{{#unless this.has_error}}<span class="sp-badge sp-badge--ok">OK</span>{{/unless}}{{/unless}}
                  {{#if this.cache_hit_any}}<span class="sp-badge" title="Served partly from prompt cache">CACHE</span>{{/if}}
                </div>
              </td>
            </tr>
            {{/each}}
            </tbody>
      {{/components/table}}
    {{else}}
      {{> components/empty-state message="No traces in the selected window. Adjust the time range or filters."}}
    {{/if}}
    {{/inline}}
{{/layout}}
