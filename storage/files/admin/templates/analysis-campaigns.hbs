{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Pick a measured baseline, set a shared budget and an objective, then compare candidate revisions under review."}}
{{#*inline "header_actions"}}<form method="post" action="/admin/analysis/inventory/sync" class="sp-inventory-inline"><input type="hidden" name="back" value="/admin/analysis/campaigns"><button class="sp-btn sp-btn--sm sp-btn--outline" type="submit">Sync inventory now</button></form> <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/versions">Import baselines</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid">
    {{> components/kpi label="Campaigns" value=kpis.total note="in this authoring scope"}}
    {{> components/kpi label="Active" value=kpis.active note="accepting comparisons" tone="ok"}}
    {{> components/kpi label="Stale baselines" value=kpis.stale note="served generation moved" tone="warn"}}
    {{> components/kpi label="Optimizable skills" value=kpis.resources note="have a captured revision"}}
</div>
{{#each capabilities}}{{#if admitted}}{{> components/notice tone="ok" title="Execution admitted" message="Experiments can run in the retained environment."}}{{else}}{{> components/notice tone="warn" title="Execution blocked" message=reason}}{{/if}}{{/each}}
{{#each diagnostics}}{{> components/notice tone="warn" title=(concat stage " · " code) message=(concat remediation " (" occurrences " occurrences; last " last_seen_at ")")}}{{/each}}
<section aria-label="Campaigns">
{{> components/section title="Campaigns" note="Experiments require frozen datasets, rubrics and executable environment settings. Recommendations must pass quality, accounting and independent holdout gates; source commits and publication require human review."}}
{{#> components/table caption="Optimization campaigns with baseline usage, state and launch controls" modifier="sp-campaign-table"}}
<thead><tr><th scope="col">Campaign</th><th scope="col">Resource usage (30 d)</th><th scope="col">State</th><th scope="col">Baseline provenance</th><th scope="col">Objective</th><th scope="col">Budget account</th><th scope="col" class="sp-table__cell--actions">Launch a comparison</th></tr></thead>
<tbody>
{{#each campaigns}}<tr>
<td class="sp-table__cell--primary"><strong>{{policy.name}}</strong> <span class="sp-u-text-secondary">{{resource_key}}</span> <span class="sp-u-mono sp-u-text-tertiary" title="{{id}}">{{truncate id 8}}</span></td>
<td>{{#if measured}}{{measured.invocations}} inv · {{measured.cost}} · p95 {{measured.p95}} · {{#if measured.failed_requests}}<span class="sp-u-text-danger">{{measured.failed_requests}} failed</span>{{else}}0 failed{{/if}}{{else}}<span class="sp-u-text-tertiary">no retained usage</span>{{/if}}</td>
<td>{{> components/badge tone="info" text=status}} <span class="sp-u-text-tertiary">gen {{generation}}</span></td>
<td><span class="sp-hash" title="{{composed_hash}}">{{#if composed_hash_short}}{{composed_hash_short}}{{else}}—{{/if}}</span> <span class="sp-u-text-tertiary">{{#if publication_generation}}pub {{publication_generation}}{{else}}unpinned{{/if}}</span>{{#if stale}} {{> components/badge tone="warn" text="stale"}}{{/if}}</td><td>{{policy.objective}}</td>
<td class="sp-table__cell--mono">{{policy.budget_id}}</td>
<td class="sp-table__cell--actions"><details class="sp-campaign-run"><summary class="sp-campaign-run__summary">Run…</summary>
<form method="post" action="/admin/analysis/campaigns/{{id}}/launch" class="sp-inventory-bind"><input type="hidden" name="operation_key" value="{{../operation_key}}"><label class="sp-u-sr-only" for="tpl-{{id}}">Frozen environment and dataset</label><select class="sp-select" id="tpl-{{id}}" name="template_id" required><option value="">Choose a retained experiment</option>{{#each ../templates}}<option value="{{id}}">{{spec.name}} · {{spec.execution_mode}}</option>{{/each}}</select><label class="sp-u-sr-only" for="cand-{{id}}">Candidate revision</label><select class="sp-select" id="cand-{{id}}" name="candidate_revision_id" required>{{#each candidates}}<option value="{{id}}">{{rationale}} · {{created_at}}</option>{{/each}}</select><button class="sp-btn sp-btn--xs sp-btn--primary" type="submit">Run comparison</button></form>
<form method="post" action="/admin/analysis/campaigns/{{id}}/holdout" class="sp-inventory-bind"><input type="hidden" name="idempotency_key" value="{{../operation_key}}"><label class="sp-u-sr-only" for="dev-{{id}}">Qualifying development experiment</label><select class="sp-select" id="dev-{{id}}" name="development_experiment_id" required>{{#each experiments}}<option value="{{this}}">{{this}}</option>{{/each}}</select><label class="sp-u-sr-only" for="hold-{{id}}">Independent holdout dataset revision</label><input class="sp-field-input" id="hold-{{id}}" name="holdout_dataset_id" placeholder="Holdout dataset revision" required><button class="sp-btn sp-btn--xs sp-btn--outline" type="submit">Prepare holdout</button></form>
</details></td></tr>{{else}}<tr class="sp-table__empty"><td colspan="7">{{> components/empty-state title="No campaigns yet" message="No campaigns yet — pick a skill on Skills and press Campaign."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<details class="sp-form-section sp-campaign-form" aria-label="Create a campaign"{{#if form_open}} open{{/if}}>
<summary class="sp-campaign-form__summary">New campaign</summary>
{{> components/section title="Campaign policy" note="Creating a campaign does not start inference. The resource's retained 30-day usage is shown beside each option so the objective is chosen against numbers."}}
<form method="post" action="/admin/analysis/campaigns" class="sp-form-grid">
<input type="hidden" name="operation_key" value="{{operation_key}}">
<div class="sp-form-field"><label class="sp-form-label" for="cp-name">Campaign name</label><input class="sp-field-input" id="cp-name" name="name" required maxlength="200"></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-baseline">Resource baseline</label><select class="sp-filter-select" id="cp-baseline" name="baseline" required><option value="">Choose a captured resource</option>{{#each resources}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{resource_key}}{{#if measured}} · {{measured.invocations}} invocations · {{#if (eq measured.users null)}}unknown users{{else}}{{measured.users}} users{{/if}} · {{measured.cost}} · p95 {{measured.p95}} · {{measured.failed_requests}} failed{{else}} · retained usage unavailable{{/if}}</option>{{/each}}</select><span class="sp-field-hint">{{#if preselected_baseline}}Pre-selected from Resource effectiveness{{#if preselected_marketplace}} ({{preselected_marketplace}}){{/if}}.{{else}}Only resources with a captured revision can be optimized; the inventory sync captures and publishes every configured skill within a minute.{{/if}}</span></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-objective">Objective</label><select class="sp-filter-select" id="cp-objective" name="objective"><option value="tokens">Reduce tokens</option><option value="cost">Reduce cost</option><option value="latency">Reduce latency</option><option value="quality">Improve quality</option></select><span class="sp-field-hint">Failed requests are tracked as a quality signal on every campaign row.</span></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-budget">Total budget (USD)</label><input class="sp-field-input" type="number" id="cp-budget" name="budget_dollars" min="0.01" step="0.01" value="5.00" required></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-quality">Quality floor (thousandths)</label><input class="sp-field-input" type="number" id="cp-quality" name="minimum_quality_milli" min="1000" max="5000" value="4000" required><span class="sp-field-hint">4000 = 4/5</span></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-pairs">Minimum paired cases per partition</label><input class="sp-field-input" type="number" id="cp-pairs" name="minimum_pairs" min="2" max="1000" value="10" required></div>
<div class="sp-form-field"><label class="sp-form-label" for="cp-iterations">Maximum iterations</label><input class="sp-field-input" type="number" id="cp-iterations" name="maximum_iterations" min="1" max="100" value="3" required></div>
<div class="sp-form-field sp-form-field--inline"><input type="checkbox" id="cp-auto" name="automatic" value="true"><label class="sp-form-label" for="cp-auto">Allow automatic follow-up development runs within this budget and iteration limit</label></div>
<div class="sp-form-actions"><button class="sp-btn sp-btn--primary" type="submit">Create campaign</button></div>
</form>
</details>
{{/inline}}{{/layout}}
