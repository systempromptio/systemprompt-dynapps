{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="The policy chain declared in services/governance/config.yaml against what this console staged in governance_chain. Core enforces the file it booted from, so a staged change takes effect only after Export, commit and restart."}}
    {{/components/page-header}}

    {{> components/tabs tabs=tabs nav_label="Governance views"}}

    {{#if sync}}
    {{> components/sync-plane plane=sync can_write=can_write}}
    {{> components/sync-plane-dialogs}}
    {{else}}
    {{> components/notice tone="warn" title="The governance plane is not registered" message="This build registers no governance sync plane."}}
    {{/if}}
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-governance.js"></script>
    {{/inline}}
{{/layout}}
