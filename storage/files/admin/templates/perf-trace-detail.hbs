{{#> layout title=title page=page}}
    {{#*inline "content"}}
    <a href="{{back_url}}" class="sp-back-link">&larr; All traces</a>

    {{> components/page-header
        title=title
        subtitle="Span-by-span waterfall of one trace. Each bar is colored by its kind; click for the chain envelope."}}

    <section class="sp-trace-detail__summary" aria-label="Trace summary">
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Session</span>
        <code class="sp-code-inline" title="{{summary.session_id}}">{{summary.session_id_short}}</code>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Started</span>
        <span title="{{summary.started_at}}">{{summary.started_at_local}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Duration</span>
        <span>{{summary.duration_display}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Identity</span>
        <span>{{summary.identity}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Spans</span>
        <span>{{summary.span_count}}</span>
      </div>
      {{#if summary.deny_count}}
        <div class="sp-trace-detail__field">
          <span class="sp-trace-detail__label">Denies</span>
          <span class="sp-u-text-danger">{{summary.deny_count}}</span>
        </div>
      {{/if}}
      {{#if summary.error_count}}
        <div class="sp-trace-detail__field">
          <span class="sp-trace-detail__label">Errors</span>
          <span class="sp-u-text-warning">{{summary.error_count}}</span>
        </div>
      {{/if}}
    </section>

    <section class="sp-waterfall" aria-labelledby="waterfall-title">
      <div class="sp-section__head">
        <h2 class="sp-section__title" id="waterfall-title">Waterfall</h2>
        <ul class="sp-waterfall__legend" aria-hidden="true">
          <li><span class="sp-waterfall__swatch sp-waterfall__swatch--gateway"></span> Gateway</li>
          <li><span class="sp-waterfall__swatch sp-waterfall__swatch--governance"></span> Governance</li>
          <li><span class="sp-waterfall__swatch sp-waterfall__swatch--tool"></span> Tool</li>
          <li><span class="sp-waterfall__swatch sp-waterfall__swatch--model"></span> Model</li>
          <li><span class="sp-waterfall__swatch sp-waterfall__swatch--spawn"></span> Spawn</li>
        </ul>
      </div>
      <div class="sp-waterfall__root">
        {{#each spans}}
        <div class="sp-waterfall__row">
          <span class="sp-waterfall__name" title="{{this.name}}">
            <code class="sp-code-inline">{{truncate this.name 32}}</code>
          </span>
          <div class="sp-waterfall__track">
            <span class="sp-waterfall__bar sp-waterfall__bar--{{this.kind}}"
                  data-chain-id="{{this.id}}"
                  style="--start:{{this.offset_pct}}%;--w:{{this.width_pct}}%"
                  title="{{this.name}} · {{this.offset_label}} · {{this.duration_ms}} ms"></span>
          </div>
          <span class="sp-waterfall__dur">{{this.offset_label}} · {{this.duration_ms}} ms</span>
        </div>
        {{/each}}
      </div>
    </section>

    <section aria-labelledby="span-list-title">
      <div class="sp-section__head">
        <h2 class="sp-section__title" id="span-list-title">Span list</h2>
      </div>
      {{#> components/table}}
        <thead><tr>
          <th class="sp-col-date">Started</th>
          <th>Kind</th>
          <th>Name</th>
          <th class="sp-table__cell--num">Duration</th>
          <th class="sp-col-status">Status</th>
          <th class="sp-table__cell--actions"></th>
        </tr></thead>
        <tbody>
        {{#each spans}}
          <tr>
            <td class="sp-col-date">{{this.started_at_local}}</td>
            <td>
              <span class="sp-waterfall__swatch sp-waterfall__swatch--{{this.kind}}"></span>
              {{this.kind}}
            </td>
            <td><code class="sp-code-inline">{{this.name}}</code></td>
            <td class="sp-table__cell--num">{{this.duration_ms}} ms</td>
            <td class="sp-col-status">
              {{#if (eq this.status "deny")}}<span class="sp-badge sp-badge--err">DENY</span>{{/if}}
              {{#if (eq this.status "error")}}<span class="sp-badge sp-badge--warn">ERROR</span>{{/if}}
              {{#if (eq this.status "ok")}}<span class="sp-badge sp-badge--ok">OK</span>{{/if}}
              {{#if (eq this.status "pending")}}<span class="sp-badge">PENDING</span>{{/if}}
              {{#if (eq this.status "rejected")}}<span class="sp-badge sp-badge--err">REJECTED</span>{{/if}}
            </td>
            <td class="sp-table__cell--actions">
              <button type="button" class="sp-btn sp-btn--sm sp-btn--outline"
                      data-chain-id="{{this.id}}">Chain</button>
            </td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-entities.js"></script>
    {{/inline}}
{{/layout}}
