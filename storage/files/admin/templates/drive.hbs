{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Your documents, the ones shared with you and the ones you worked on last. Rows are read from the document API as you, so each is one you may view."}}
        {{#*inline "header_actions"}}
            <span class="sp-p-drive__actions" data-slot="drive-listing-actions"></span>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="drive-create-open" aria-controls="drive-create">New document</button>
        {{/inline}}
    {{/components/page-header}}

    <section class="sp-section sp-p-drive" aria-label="Folders and documents" data-drive-list data-documents-api="{{documents_api}}" data-folders-api="{{folders_api}}" data-base-url="{{base_url}}"{{#if folder_id}} data-folder-id="{{folder_id}}"{{/if}}{{#if is_admin}} data-admin{{/if}}>
    <form class="sp-p-drive__toolbar" data-slot="drive-filters" role="search">
        <div class="sp-p-drive__scopes" role="group" aria-label="Show">
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-scope="folder" aria-pressed="true">Folders</button>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-scope="recent" aria-pressed="false">Recent</button>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-scope="shared" aria-pressed="false">Shared with me</button>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-scope="mine" aria-pressed="false">Mine</button>
        </div>
        <label class="sp-u-sr-only" for="drive-search">Search by name</label>
        <input class="sp-field-input sp-p-drive__search" id="drive-search" name="query" type="search" placeholder="Search by name">
        <label class="sp-u-sr-only" for="drive-sort">Sort</label>
        <select class="sp-select" id="drive-sort" name="sort">
            <option value="updated">Last updated</option>
            <option value="name">Name</option>
            <option value="recent">Last opened</option>
        </select>
        <div class="sp-p-drive__modes" role="group" aria-label="Layout">
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-view="list" aria-pressed="true">List</button>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-view="grid" aria-pressed="false">Grid</button>
        </div>
        <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="drive-new-folder">New folder</button>
        <label class="sp-btn sp-btn--sm sp-btn--outline sp-p-drive__upload">Upload<input class="sp-u-sr-only" type="file" name="file" data-slot="drive-upload" multiple></label>
    </form>
    <p class="sp-p-drive__drop" data-slot="drive-drop" hidden>Drop files to upload them here.</p>
    <ul class="sp-upload-list" data-slot="drive-uploads" aria-live="polite" hidden></ul>
    {{#> components/table caption="Folders and documents"}}
      <thead><tr>
        <th scope="col">Name</th>
        <th scope="col">Format</th>
        <th scope="col">Head revision</th>
        <th scope="col">Editing now</th>
        {{#if is_admin}}<th scope="col">Agent edits</th>{{/if}}
        <th scope="col" class="sp-col-date">Updated</th>
        <th scope="col"><span class="sp-u-sr-only">Actions</span></th>
      </tr></thead>
      <tbody data-slot="drive-rows">
        <tr data-slot="drive-loading"><td colspan="7"><span class="sp-u-text-tertiary">Loading…</span></td></tr>
      </tbody>
    {{/components/table}}
    <p class="sp-p-drive__empty" data-slot="drive-empty" hidden>This folder holds no documents you may view.</p>
    <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="drive-more" hidden>Load more</button>
    </section>

    <dialog class="sp-dialog sp-p-drive__dialog" id="drive-folder-class-dialog" aria-labelledby="drive-folder-class-title" data-drive-folder-class>
        <div class="sp-dialog-form">
            <h2 class="sp-ac-dialog__header" id="drive-folder-class-title">Class of <span data-field="drive-folder-name"></span></h2>
            <div class="sp-ac-dialog__body sp-p-drive__class">
                <label class="sp-form-label" for="drive-folder-class">Class</label>
                <select class="sp-select" id="drive-folder-class" data-slot="drive-folder-class" disabled></select>
                <p class="sp-p-drive__empty" data-field="drive-folder-agents"></p>
                <p class="sp-ac-form-error" data-field="drive-folder-class-status" role="alert"></p>
            </div>
            <div class="sp-ac-dialog__actions">
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="drive-folder-class-close">Close</button>
            </div>
        </div>
    </dialog>

    <dialog class="sp-dialog sp-p-drive__dialog" id="drive-create" aria-labelledby="drive-create-title" data-drive-create>
        <form method="dialog" class="sp-dialog-form" data-slot="drive-create-form">
            <h2 class="sp-ac-dialog__header" id="drive-create-title">New document</h2>
            <div class="sp-ac-dialog__body">
                <div class="sp-form-field">
                    <label class="sp-form-label" for="drive-create-template">Template</label>
                    <select class="sp-select" id="drive-create-template" name="template_id" required>
                        {{#each templates}}
                        <option value="{{id}}" data-format="{{format}}">{{name}} ({{format}})</option>
                        {{/each}}
                    </select>
                </div>
                <div class="sp-form-field">
                    <label class="sp-form-label" for="drive-create-name">Name</label>
                    <input class="sp-field-input" id="drive-create-name" type="text" name="name" required maxlength="200" autocomplete="off">
                </div>
                <div class="sp-form-field">
                    <label class="sp-form-label" for="drive-create-title-param">Title</label>
                    <input class="sp-field-input" id="drive-create-title-param" type="text" name="title" data-param="title" maxlength="200" autocomplete="off" placeholder="Untitled">
                </div>
                <p class="sp-ac-form-error" data-slot="drive-create-error" role="alert" hidden></p>
            </div>
            <div class="sp-ac-dialog__actions">
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="drive-create-cancel">Cancel</button>
                <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary" value="create">Create</button>
            </div>
        </form>
    </dialog>

    <template data-template="drive-folder-row">
      <tr>
        <td class="sp-table__cell--primary"><a class="sp-table__link" data-field="link"></a> <span class="sp-p-drive__ext" data-slot="ext"></span></td>
        <td><span class="sp-u-text-tertiary">Folder</span></td>
        <td></td>
        <td></td>
        <td data-admin-only>
          <select class="sp-select" data-action="drive-policy" aria-label="Agent edits in this folder">
            <option value="direct">Land directly</option>
            <option value="propose">Propose for review</option>
          </select>
        </td>
        <td class="sp-col-date" data-field="updated"></td>
        <td><button type="button" class="sp-btn sp-btn--sm sp-btn--ghost" data-action="drive-row-menu" aria-haspopup="menu" aria-label="Folder actions" hidden>⋯</button></td>
      </tr>
    </template>
    <template data-template="drive-document-row">
      <tr>
        <td class="sp-table__cell--primary"><a class="sp-table__link" data-field="link"></a> <span class="sp-p-drive__ext" data-slot="ext"></span></td>
        <td class="sp-u-mono" data-field="format"></td>
        <td class="sp-u-mono" data-field="head"></td>
        <td data-field="editors"><span class="sp-u-text-tertiary">—</span></td>
        <td data-admin-only></td>
        <td class="sp-col-date" data-field="updated"></td>
        <td><button type="button" class="sp-btn sp-btn--sm sp-btn--ghost" data-action="drive-row-menu" aria-haspopup="menu" aria-label="Document actions" hidden>⋯</button></td>
      </tr>
    </template>
    <template data-template="drive-row-menu">
      <div class="sp-dropdown-menu sp-p-drive__menu" role="menu" aria-label="Actions">
        <button type="button" class="sp-p-drive__menu-item" role="menuitem"></button>
      </div>
    </template>
    <template data-template="drive-listing-action">
      <button type="button" class="sp-btn sp-btn--sm sp-btn--outline"></button>
    </template>
    <template data-template="drive-upload-row">
      <li class="sp-upload-row">
        <span class="sp-upload-row__name" data-field="name"></span>
        <progress class="sp-upload-row__bar" data-field="bar" max="100" value="0"></progress>
        <span class="sp-upload-row__status" data-field="status">Queued</span>
        <button type="button" class="sp-btn sp-btn--sm sp-btn--ghost" data-action="upload-cancel">Cancel</button>
      </li>
    </template>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/drive.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
