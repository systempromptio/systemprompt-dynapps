{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="People containers. A group carries membership and the marketplace entitlement its members inherit."}}

    <section class="group-stat-grid" aria-label="Group totals">
        {{#each stats}}
        {{> components/stat-card label=label value=value}}
        {{/each}}
    </section>

    <section aria-label="Groups">
    {{#if groups}}
    {{#> components/data-table}}
        <thead><tr>
            <th>Group</th>
            <th class="numeric col-numeric">Members</th>
            <th>Marketplaces</th>
            <th class="numeric col-numeric">Projects</th>
            <th class="numeric col-numeric">Requests 30d</th>
            <th class="numeric col-numeric">Cost 30d</th>
        </tr></thead>
        <tbody>
        {{#each groups}}
        <tr data-group-id="{{id}}"{{#if is_unassigned}} class="is-unassigned"{{/if}}>
            <td>
                <a href="{{href}}" class="group-cell">
                    <span class="group-cell__name">{{name}}</span>
                    {{#if is_unassigned}}<span class="badge badge-orange">Needs assignment</span>{{/if}}
                </a>
                {{#if description}}<span class="group-cell__desc">{{truncate description 90}}</span>{{/if}}
            </td>
            <td class="numeric">
                <span class="group-member-count">{{member_count}}</span>
                <span class="text-tertiary text-xs">{{active_members_30d}} active</span>
            </td>
            <td>{{> components/group-chips chips=marketplaces empty="None"}}</td>
            <td class="numeric">{{project_count}}</td>
            <td class="numeric">{{formatNumber requests_30d}}</td>
            <td class="numeric">{{formatUsd cost_30d_microdollars}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/data-table}}
    {{else}}
    {{> components/empty-state message="No groups yet. The directory creates them as sign-ins map onto them."}}
    {{/if}}
    </section>
    {{/inline}}
{{/layout}}
