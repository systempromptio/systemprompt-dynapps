{{#> layout title=title page=page}}{{#*inline "content"}}
<section data-portfolio data-generation="{{health.generation}}.{{inventory.generation}}.{{installations.generation}}">
{{#> components/page-header title=title subtitle="Every skill in the inventory, grouped by the marketplace and plugin that deliver it, with retained resource-wide snapshots for the selected window."}}
{{#*inline "header_actions"}}<form method="post" action="/admin/analysis/resources/baselines" class="sp-inventory-inline"><input type="hidden" name="operation_id" value="{{operation_key}}"><button class="sp-btn sp-btn--sm sp-btn--outline" type="submit" title="Bind every configured skill to a managed resource so retained snapshots can attach">Prepare baselines</button></form> <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analysis/skills?start={{start}}&amp;end={{end}}">Skill conversations</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<p>{{metrics_notice}}</p>
<div class="sp-kpi-grid">
{{> components/kpi label="Skills" value=kpis.skills note="on this inventory page"}}
{{> components/kpi label="Used" value=kpis.used tone="ok" note="invoked in window"}}
{{> components/kpi label="Unused" value=kpis.unused tone="warn" note="retained zero on this page"}}
{{> components/kpi label="Failing" value=kpis.failing tone="err" note="conflicting or >10% failed"}}
{{#if (eq kpis.invocations null)}}{{> components/kpi label="Invocations" value="Unknown" note="unavailable for this scope"}}{{else}}{{> components/kpi label="Invocations" value=kpis.invocations note="organization snapshot, unfiltered"}}{{/if}}
{{#if (eq kpis.users null)}}{{> components/kpi label="Users" value="Unknown" note="unavailable for this scope"}}{{else}}{{> components/kpi label="Users" value=kpis.users note="distinct people invoking"}}{{/if}}
{{#if (eq kpis.linked_requests null)}}{{> components/kpi label="Linked requests" value="Unknown" note="unavailable for this scope"}}{{else}}{{> components/kpi label="Linked requests" value=kpis.linked_requests note="organization snapshot, deduplicated"}}{{/if}}
{{> components/kpi label="Related spend" value=kpis.cost note="organization priced evidence"}}
{{> components/kpi label="Mean latency" value=kpis.avg_latency note="linked requests, measured"}}
</div>
<div class="sp-inventory-status">
<p data-live-status role="status" aria-live="polite" class="sp-inventory-status__live">{{#if pending_jobs}}Preparing the requested range…{{else}}Retained snapshots. Retained snapshot generation {{health.generation}} (facts {{health.fact_generation}}/{{health.facts_generation}}), inventory generation {{inventory.generation}} with {{inventory.entries}} entries, coverage generation {{installations.generation}}.{{/if}}</p>
<p data-freshness>{{generated_at}} · pending facts {{health.pending_changes}} · producer changes {{health.pending_producer_changes}} {{health.last_error}} {{inventory.last_error}}</p>
{{#each range_jobs}}<p>Range operation <a href="/api/v1/analytics/jobs/{{operation_id}}">{{operation_id}}</a>: {{state}} {{diagnostic}}</p>{{/each}}
<p data-inventory-health></p><p data-installation-health></p><p data-unknown-usage>{{#if totals}}{{unknown_usage}} invocations have unknown resource attribution.{{/if}}</p>
{{#if unbound}}{{> components/notice tone="warn" title="Attribution pending" message=(concat unbound " skill entries are not bound to a managed resource, so version attribution and installation coverage cannot attach to them yet. Usage remains unknown until a retained snapshot exists. Use Prepare baselines to bind them.")}}{{/if}}
{{#if conflicting}}{{> components/notice tone="err" title="Conflicting names" message=(concat conflicting " configured entries share a name with an imported managed resource. Choose the resource in the row's Bind control to resolve each one explicitly.")}}{{/if}}
</div>
{{#> components/toolbar toolbar_count=(concat kpis.skills " skills")}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter" method="get" action="/admin/analysis/resources">
<input type="hidden" name="kind" value="{{kind}}">
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-marketplace">Marketplace</label><select class="sp-select" id="pf-marketplace" name="marketplace"><option value="">All marketplaces</option>{{#each marketplaces}}<option value="{{id}}"{{#if (eq id ../filter_marketplace)}} selected{{/if}}>{{name}}</option>{{/each}}</select></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-group">User group</label><select class="sp-select" id="pf-group" name="group"><option value="">All groups</option>{{#each user_groups}}<option value="{{id}}"{{#if (eq id ../filter_group)}} selected{{/if}}>{{name}}</option>{{/each}}</select></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-days">Window</label><select class="sp-select" id="pf-days" name="days"><option value="7"{{#if (eq days 7)}} selected{{/if}}>7 days</option><option value="30"{{#if (eq days 30)}} selected{{/if}}>30 days</option><option value="90"{{#if (eq days 90)}} selected{{/if}}>90 days</option><option value="365"{{#if (eq days 365)}} selected{{/if}}>365 days</option></select></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-search">Skill</label><input class="sp-search-input" type="search" id="pf-search" name="search" value="{{search}}" placeholder="Find a skill…" maxlength="200"></div>
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply</button>
</form>
{{/inline}}
{{#*inline "toolbar_actions"}}{{#if filter_marketplace}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/analysis/resources">Clear</a>{{else}}{{#if filter_group}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/analysis/resources">Clear</a>{{else}}{{#if search}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/analysis/resources">Clear</a>{{/if}}{{/if}}{{/if}} <a class="sp-btn sp-btn--xs sp-btn--outline" href="/admin/analysis/resources.json?days={{days}}{{#if filter_marketplace}}&amp;marketplace={{filter_marketplace}}{{/if}}{{#if filter_group}}&amp;group={{filter_group}}{{/if}}">JSON</a>{{/inline}}
{{/components/toolbar}}
{{#> components/table caption="Skills grouped by marketplace and plugin with window usage, audience, spend, latency and attribution" modifier="sp-analysis-table sp-inventory-table"}}
<thead><tr>
<th scope="col">Skill</th><th scope="col">Health</th>
<th scope="col" class="sp-table__cell--num">Invocations</th><th scope="col" class="sp-table__cell--num">Users</th><th scope="col" class="sp-table__cell--num" title="Current catalog audience, not historical usage or installation proof">Audience</th>
<th scope="col" class="sp-table__cell--num">Linked</th><th scope="col" class="sp-table__cell--num">Failed</th>
<th scope="col" class="sp-table__cell--num" title="Input / output / cache tokens on linked requests">Tokens</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col" class="sp-table__cell--num">p95</th>
<th scope="col">Assessed</th><th scope="col" title="Verified invocations / installation coverage from retained snapshots">Attribution</th><th scope="col">Last used</th>
<th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
</tr></thead>
<tbody>
{{#each groups}}
<tr class="sp-inventory-row--marketplace"><th scope="rowgroup" colspan="2"><span class="sp-inventory-group__name">{{marketplace_name}}</span> <span class="sp-inventory-rollup">{{rollup.skills}} skills · {{rollup.used}} used · {{rollup.healthy}} healthy · {{rollup.warning}} warn · {{rollup.failing}} failing</span></th>
<td class="sp-table__cell--num sp-u-num">Unavailable</td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td class="sp-table__cell--num sp-u-num">Unknown</td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td></td><td class="sp-table__cell--num sp-u-num">{{rollup.cost}}</td><td colspan="5"></td></tr>
{{#each plugins}}
<tr class="sp-inventory-row--plugin"><th scope="rowgroup" colspan="2"><span class="sp-inventory-group__name">{{plugin_name}}</span> <span class="sp-inventory-rollup sp-u-mono">{{plugin_id}} · {{rollup.skills}} skills · {{rollup.used}} used</span></th>
<td class="sp-table__cell--num sp-u-num">Unavailable</td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td></td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td class="sp-table__cell--num sp-u-num">Unavailable</td><td></td><td class="sp-table__cell--num sp-u-num">{{rollup.cost}}</td><td colspan="5"></td></tr>
{{#each rows}}
<tr class="sp-inventory-row sp-inventory-row--{{health_tone}}" data-skill="{{skill_id}}" data-status="{{usage_status}}">
<td class="sp-table__cell--primary"><a class="sp-table__link" href="{{drilldown_href}}" title="Open conversations that used this skill">{{skill_id}}</a>{{#if entry.diagnostic}}<br><small class="sp-u-text-danger">{{entry.diagnostic}}</small>{{/if}}</td>
<td>{{> components/badge tone=health_tone text=health_reason}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if usage}}{{#if (eq usage.invocations null)}}Unknown{{else}}{{usage.invocations}}{{/if}}{{else}}Unknown{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if usage}}{{#if (eq usage.distinct_users null)}}Unknown{{else}}{{usage.distinct_users}}{{/if}}{{else}}Unknown{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">Unknown</td>
<td class="sp-table__cell--num sp-u-num">{{#if usage}}{{#if (eq usage.linked_requests null)}}Unknown{{else}}{{usage.linked_requests}}{{/if}}{{else}}Unknown{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if usage}}{{usage.failed_requests}}{{else}}Unknown{{/if}}</td>
<td class="sp-table__cell--num sp-u-num sp-inventory-tokens"><span title="input">{{tokens_in}}</span><span title="output">{{tokens_out}}</span><span title="cache">{{tokens_cache}}</span></td>
<td class="sp-table__cell--num sp-u-num">{{cost}}</td>
<td class="sp-table__cell--num sp-u-num">{{p95}}</td>
<td class="sp-table__cell--stacked">{{#if usage}}<span>{{usage.assessed_conversations}}/{{usage.assessment_conversations}} assessed</span><span>{{usage.failed_assessments}} failed assessments</span>{{else}}Unknown{{/if}}</td>
<td class="sp-table__cell--stacked">{{#if snapshot}}<span>{{#if (eq attributed_pct null)}}Unknown attribution coverage{{else}}{{attributed_pct}}% attributed{{/if}}</span>{{else}}<span class="sp-u-text-tertiary">{{#if (eq usage_status "pending")}}snapshot pending{{else}}{{usage_status}}{{/if}}</span>{{/if}}{{#if installation}}<span>{{installation.current_acknowledged_devices}}/{{installation.eligible_devices}} acknowledged / eligible devices</span>{{else}}<span>Installation coverage unknown</span>{{/if}}<span>Offline outbox count unknown</span>{{#if usage}}<span>{{usage.latency_measured}}/{{usage.linked_requests}} latency measured; {{usage.priced_requests}}/{{usage.linked_requests}} priced</span>{{/if}}</td>
<td class="sp-table__cell--date">{{#if last_used}}{{last_used}}{{else}}<span class="sp-u-text-tertiary">Unavailable</span>{{/if}}</td>
<td class="sp-table__cell--actions">{{#if bind_candidates}}<form method="post" action="/admin/analysis/resources/{{entry.entry_id}}/bind" class="sp-inventory-bind"><label class="sp-u-sr-only" for="bind-{{entry.entry_id}}">Bind to managed resource</label><select class="sp-select" id="bind-{{entry.entry_id}}" name="resource_id">{{#each bind_candidates}}<option value="{{id}}">{{source_name}}</option>{{/each}}</select><button class="sp-btn sp-btn--xs sp-btn--outline" type="submit">Bind</button></form>{{/if}}{{#if more_bind_candidates}}<span>More than 50 candidates: use the inventory API to select an explicit resource.</span>{{/if}}{{#if campaign_href}}<a class="sp-btn sp-btn--xs sp-btn--outline-primary" href="{{campaign_href}}">Campaign</a>{{/if}}{{#if catalog_href}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="{{catalog_href}}">Catalog</a>{{/if}}</td>
</tr>
{{/each}}
{{/each}}
{{else}}
<tr class="sp-table__empty"><td colspan="14">{{> components/empty-state title="No skills match" message="No inventory skill matches these filters. Clear the marketplace, group or search filter, or run the inventory refresh job."}}</td></tr>
{{/each}}
</tbody>
{{/components/table}}
{{#if next_href}}<a class="sp-btn sp-btn--outline" data-next-cursor="{{next_cursor}}" href="{{next_href}}">Next inventory page</a>{{/if}}
<details class="sp-analysis-definitions"><summary>How to read this table</summary>
<p>Usage comes only from retained resource-wide snapshots. Missing, pending, unbound or privacy-suppressed evidence is unknown. Zero is shown only when a ready snapshot measured zero. p95 is the upper bound from the retained geometric histogram; its measured-request denominator is shown separately. Mean latency, cache tokens, model ranking and last-use timestamps are unavailable in this aggregate contract.</p>
<p>Current catalog placement is navigation context; current audience is unavailable without complete effective-grant evidence, not historical usage dimensions. A resource can repeat under several plugins; their usage, distinct identities and related spend are not additive. Group and marketplace historical totals remain unavailable. Filtering by user group makes usage unavailable rather than projecting today's access onto history.</p>
<p>Installation acknowledgements and eligible-device denominators are independent of usage. Disconnected outboxes cannot be counted by the server. Cached snapshot generation and pending producer/fact health describe freshness; notifications only prompt refreshes.</p>
</details>
</section>
{{/inline}}{{#*inline "scripts"}}<script type="module" src="/js/pages/analysis-portfolio.js?v={{css_version}}"></script>{{/inline}}{{/layout}}
