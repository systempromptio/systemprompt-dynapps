{{#> layout title=title page=page}}{{#*inline "content"}}
<section data-portfolio data-generation="{{health.generation}}.{{inventory.generation}}.{{installations.generation}}">
{{#> components/page-header title=title subtitle="Every skill in the inventory, grouped by the marketplace and plugin that deliver it, with the figures its retained snapshot holds for the selected window."}}
{{#*inline "header_actions"}}<form method="post" action="/admin/analysis/resources/baselines" class="sp-inventory-inline"><input type="hidden" name="operation_id" value="{{operation_key}}"><button class="sp-btn sp-btn--sm sp-btn--outline" type="submit" title="Bind every configured skill to a managed resource so retained snapshots can attach">Prepare baselines</button></form> <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analysis/skills?start={{start}}&amp;end={{end}}">Skill conversations</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid">
{{> components/kpi label="Skills" value=kpis.skills note=(concat kpis.measured " with a retained snapshot")}}
{{> components/kpi label="Attributed use" value=kpis.used tone="ok" note="skills with verified invocations"}}
{{> components/kpi label="Unattributed" value=kpis.unused tone="warn" note="no verified invocation yet"}}
{{> components/kpi label="Failing" value=kpis.failing tone="err" note="conflicting or >10% failed"}}
{{> components/kpi label="Invocations" value=kpis.invocations note=(concat kpis.attributed " attributed to a resource")}}
{{> components/kpi label="Users" value=kpis.users note="distinct authenticated consumers"}}
{{> components/kpi label="Requests" value=kpis.requests note=(concat kpis.failed_requests " failed")}}
{{> components/kpi label="Related spend" value=kpis.cost note="overlaps across skills"}}
{{> components/kpi label="p95 latency" value=kpis.p95 note="upper bound, all resources"}}
</div>
<div class="sp-inventory-status">
<p data-live-status role="status" aria-live="polite" class="sp-inventory-status__live">{{#if pending_jobs}}Preparing the requested range…{{else}}Retained snapshot generation {{health.generation}} (facts {{health.fact_generation}}/{{health.facts_generation}}), inventory generation {{inventory.generation}} with {{inventory.entries}} entries, coverage generation {{installations.generation}}.{{/if}}</p>
<p data-freshness hidden>{{generated_at}} · pending facts {{health.pending_changes}} · producer changes {{health.pending_producer_changes}} {{health.last_error}} {{inventory.last_error}}</p>
<p data-unknown-usage hidden>{{#if totals}}{{unknown_usage}} invocations have unknown resource attribution.{{/if}}</p>
{{#if unbound}}{{> components/notice tone="warn" title="Not yet measured" message=(concat unbound " skill entries are not bound to a managed resource, so no snapshot can be retained for them. Use Prepare baselines to bind them; the organisation totals above already include their traffic.")}}{{/if}}
{{#if conflicting}}{{> components/notice tone="err" title="Conflicting names" message=(concat conflicting " configured entries share a name with an imported managed resource. Choose the resource in the row's Bind control to resolve each one explicitly.")}}{{/if}}
</div>
{{#> components/toolbar toolbar_count=(concat kpis.skills " skills")}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter" method="get" action="/admin/analysis/resources">
<input type="hidden" name="kind" value="{{kind}}">
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-marketplace">Marketplace</label><select class="sp-select" id="pf-marketplace" name="marketplace"><option value="">All marketplaces</option>{{#each marketplaces}}<option value="{{id}}"{{#if (eq id ../filter_marketplace)}} selected{{/if}}>{{name}}</option>{{/each}}</select></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-days">Window</label><select class="sp-select" id="pf-days" name="days"><option value="7"{{#if (eq days 7)}} selected{{/if}}>7 days</option><option value="30"{{#if (eq days 30)}} selected{{/if}}>30 days</option><option value="90"{{#if (eq days 90)}} selected{{/if}}>90 days</option><option value="365"{{#if (eq days 365)}} selected{{/if}}>365 days</option></select></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="pf-search">Skill</label><input class="sp-search-input" type="search" id="pf-search" name="search" value="{{search}}" placeholder="Find a skill…" maxlength="200"></div>
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply</button>
</form>
{{/inline}}
{{#*inline "toolbar_actions"}}{{#if filter_marketplace}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/analysis/resources">Clear</a>{{else}}{{#if search}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="/admin/analysis/resources">Clear</a>{{/if}}{{/if}} <a class="sp-btn sp-btn--xs sp-btn--outline" href="/admin/analysis/resources.json?days={{days}}{{#if filter_marketplace}}&amp;marketplace={{filter_marketplace}}{{/if}}">JSON</a>{{/inline}}
{{/components/toolbar}}
{{#> components/table caption="Skills grouped by marketplace and plugin with retained usage, audience, spend, latency and attribution" modifier="sp-analysis-table sp-inventory-table"}}
<thead><tr>
<th scope="col">Skill</th><th scope="col">Health</th>
<th scope="col" class="sp-table__cell--num" title="Invocations attributed to this resource in the window">Invocations</th><th scope="col" class="sp-table__cell--num" title="Verified invocations as a share of attributed invocations">Attributed</th><th scope="col" class="sp-table__cell--num" title="Distinct authenticated consumers">Users</th><th scope="col" class="sp-table__cell--num" title="People who receive this skill through a marketplace">Audience</th>
<th scope="col" class="sp-table__cell--num">Requests</th><th scope="col" class="sp-table__cell--num">Failed</th>
<th scope="col" class="sp-table__cell--num" title="Input / output tokens on attributed requests">Tokens</th><th scope="col" class="sp-table__cell--num">Cost</th><th scope="col" class="sp-table__cell--num">p95</th>
<th scope="col" title="Scored / assessed conversations">Assessed</th><th scope="col" title="Acknowledged / eligible devices">Coverage</th>
<th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
</tr></thead>
<tbody>
{{#each groups}}
<tr class="sp-inventory-row--marketplace"><th scope="rowgroup" colspan="2"><span class="sp-inventory-group__name">{{marketplace_name}}</span> <span class="sp-inventory-rollup">{{rollup.skills}} skills · {{rollup.measured}} measured · {{rollup.used}} used · {{rollup.healthy}} healthy · {{rollup.warning}} warn · {{rollup.failing}} failing</span></th>
<td class="sp-table__cell--num sp-u-num">{{rollup.invocations}}</td><td></td><td></td><td class="sp-table__cell--num sp-u-num">{{users_with_access}}</td><td class="sp-table__cell--num sp-u-num">{{rollup.requests}}</td><td class="sp-table__cell--num sp-u-num">{{rollup.failed_requests}}</td><td></td><td class="sp-table__cell--num sp-u-num">{{rollup.cost}}</td><td colspan="4"></td></tr>
{{#each plugins}}
<tr class="sp-inventory-row--plugin"><th scope="rowgroup" colspan="2"><span class="sp-inventory-group__name">{{plugin_name}}</span> <span class="sp-inventory-rollup sp-u-mono">{{plugin_id}} · {{rollup.skills}} skills · {{rollup.used}} used</span></th>
<td class="sp-table__cell--num sp-u-num">{{rollup.invocations}}</td><td></td><td></td><td></td><td class="sp-table__cell--num sp-u-num">{{rollup.requests}}</td><td class="sp-table__cell--num sp-u-num">{{rollup.failed_requests}}</td><td></td><td class="sp-table__cell--num sp-u-num">{{rollup.cost}}</td><td colspan="4"></td></tr>
{{#each rows}}
<tr class="sp-inventory-row sp-inventory-row--{{health_tone}}" data-skill="{{resource_key}}" data-status="{{usage_status}}">
<td class="sp-table__cell--primary"><a class="sp-table__link" href="{{drilldown_href}}" title="Open conversations that used this skill">{{resource_key}}</a>{{#if entry.diagnostic}}<br><small class="sp-u-text-danger">{{entry.diagnostic}}</small>{{/if}}</td>
<td>{{> components/badge tone=health_tone text=health_reason}}</td>
{{#if figures.measured}}<td class="sp-table__cell--num sp-u-num">{{figures.invocations}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if figures.attributed_pct}}{{figures.attributed_pct}}%{{else}}<span class="sp-u-text-tertiary">0%</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if figures.distinct_users}}{{figures.distinct_users}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>{{else}}<td class="sp-table__cell--num" colspan="3"><span class="sp-u-text-tertiary">{{#if (eq usage_status "pending")}}snapshot pending{{else}}{{#if (eq usage_status "suppressed")}}suppressed cohort{{else}}not bound — no snapshot{{/if}}{{/if}}</span></td>{{/if}}
<td class="sp-table__cell--num sp-u-num">{{#if users_with_access}}{{users_with_access}}{{else}}<span class="sp-u-text-danger">0</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if figures.measured}}{{figures.requests}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{#if figures.failed_requests}}<span class="sp-u-text-danger">{{figures.failed_requests}}</span>{{else}}{{#if figures.measured}}0{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}{{/if}}</td>
<td class="sp-table__cell--num sp-u-num sp-inventory-tokens"><span title="input">{{tokens_in}}</span><span title="output">{{tokens_out}}</span></td>
<td class="sp-table__cell--num sp-u-num">{{cost}}</td>
<td class="sp-table__cell--num sp-u-num">{{p95}}</td>
<td class="sp-table__cell--stacked">{{#if figures.measured}}<span>{{figures.assessed_conversations}} / {{figures.assessment_conversations}}</span>{{#if figures.failed_assessments}}<span class="sp-u-text-danger">{{figures.failed_assessments}} failed</span>{{/if}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td class="sp-table__cell--stacked">{{#if installation}}<span>{{installation.current_acknowledged_devices}} / {{installation.eligible_devices}} devices</span><span class="sp-u-text-tertiary">{{installation.current_verified_devices}} verified</span>{{else}}<span class="sp-u-text-tertiary">{{#if entry.resource_id}}pending{{else}}unbound{{/if}}</span>{{/if}}</td>
<td class="sp-table__cell--actions">{{#if bind_candidates}}<form method="post" action="/admin/analysis/resources/{{entry.entry_id}}/bind" class="sp-inventory-bind"><label class="sp-u-sr-only" for="bind-{{entry.entry_id}}">Bind to managed resource</label><select class="sp-select" id="bind-{{entry.entry_id}}" name="resource_id">{{#each bind_candidates}}<option value="{{id}}">{{source_name}}</option>{{/each}}</select><button class="sp-btn sp-btn--xs sp-btn--outline" type="submit">Bind</button></form>{{/if}}{{#if campaign_href}}<a class="sp-btn sp-btn--xs sp-btn--outline-primary" href="{{campaign_href}}">Campaign</a>{{/if}}{{#if catalog_href}}<a class="sp-btn sp-btn--xs sp-btn--ghost" href="{{catalog_href}}">Catalog</a>{{/if}}</td>
</tr>
{{/each}}
{{/each}}
{{else}}
<tr class="sp-table__empty"><td colspan="14">{{> components/empty-state title="No skills match" message="No inventory skill matches these filters. Clear the marketplace or search filter, or run the inventory refresh job."}}</td></tr>
{{/each}}
</tbody>
{{/components/table}}
<details class="sp-analysis-definitions"><summary>How to read this table</summary>
<p>Every figure is read from the retained feedback snapshot for the selected window; nothing here is recomputed from raw events. The headline tiles are the organisation-wide snapshot and include traffic that is not yet attributed to any resource. A row is measured once its inventory entry is bound to a managed resource and a snapshot exists for that resource; attribution to a row requires verified evidence — a device-authenticated consumer, a session binding and a verified installation receipt — so a skill used without that chain contributes to the totals but not to its own row.</p>
<p>Audience is the number of signed-in people who receive the skill through at least one marketplace they are entitled to, resolved with the same rules the gateway enforces. Health is red for conflicting, unavailable or withdrawn entries and for more than 10% failed attributed requests; amber for unbound or audience-less skills and for measured skills with no attributed use; grey while a bound resource waits for its first snapshot.</p>
<p>A skill carried by two plugins appears under each; rollups count each skill once per marketplace. Related spend overlaps across skills and must not be summed. Percentiles merge versioned latency buckets and show an upper bound.</p>
</details>
</section>
{{/inline}}{{#*inline "scripts"}}<script type="module" src="/js/pages/analysis-portfolio.js?v={{css_version}}"></script>{{/inline}}{{/layout}}
