{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title subtitle=subtitle}}
        {{#*inline "header_meta"}}
        <span class="sp-live" data-live-status hidden>
            <span class="sp-live__dot" aria-hidden="true"></span>
            <span class="sp-live__text" data-live-text aria-hidden="true">Live</span>
            <span class="sp-u-sr-only" role="status" aria-live="polite" data-live-announce></span>
            <button type="button" class="sp-btn sp-btn--xs sp-btn--ghost sp-live__toggle" data-live-toggle aria-pressed="false">Pause</button>
        </span>
        {{/inline}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/farm/evals">Evals</a>
        <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/farm/runs">All runs</a>
        {{/inline}}
    {{/components/page-header}}

    <div class="sp-farm-overview" data-farm-live-list="{{live_url}}">
        {{> farm/activity-live activity}}

        {{#if scheduled_kpis}}
        <section class="sp-farm-clients" aria-label="Scheduled runs">
            {{> components/section title="Nightly audit" note="Runs the scheduler started in the last 30 days: outcome, cost, MCP reads and writes, governance warnings, DynBrain delivery and eval score."}}
            <div class="sp-kpi-grid sp-kpi-grid--compact">
                {{#each scheduled_kpis}}
                {{> components/kpi key=this.key label=this.label icon=this.icon value=this.value note=this.note
                    hint=this.hint tone=this.tone href=this.href}}
                {{/each}}
            </div>
        </section>
        {{/if}}

        <section class="sp-farm-clients" aria-label="Last 30 days">
            {{#> components/section title="Last 30 days" note="Outcomes across every farm and client: runs, success rate, cost and eval score."}}
                {{#*inline "section_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/farm/clients">By client</a>{{/inline}}
            {{/components/section}}
            <div class="sp-kpi-grid sp-kpi-grid--compact">
                {{#each trend_kpis}}
                {{> components/kpi key=this.key label=this.label icon=this.icon value=this.value note=this.note
                    hint=this.hint tone=this.tone spark=this.spark}}
                {{/each}}
            </div>
            <div class="sp-farm-clients__trends">
                {{> components/svg-line-chart runs_chart}}
                {{> components/svg-line-chart rates_chart}}
            </div>
        </section>

        <section class="sp-farm-overview__farms" aria-label="Farms">
            {{> components/section title="Farms" count=farm_count note="Each farm is a Git marketplace whose agents run headlessly on this instance."}}
            {{#if has_farms}}
            <div class="sp-farm-overview__grid">
                {{#each farms}}{{> farm/farm-card this}}{{/each}}
            </div>
            {{else}}
            {{> components/empty-state heading="No farms synced yet" message="Declare a farm in agent-farms.yaml and sync it to see its agents here."}}
            {{/if}}
        </section>
    </div>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-farm-live-list.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
