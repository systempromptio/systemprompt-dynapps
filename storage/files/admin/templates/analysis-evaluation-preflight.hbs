{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="What the complete matrix would cost. No provider call and no worker assignment has been dispatched."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/evaluations">&larr; Experiments</a>{{/inline}}
{{/components/page-header}}
<div class="sp-kpi-grid">
{{> components/kpi label="Executions" value=estimate.execution_count note="cases × variants × repetitions"}}
{{> components/kpi label="Conservative maximum" value=maximum_cost note="upper bound on the whole matrix, not an expected spend"}}
{{> components/kpi label="Available" value=available note="unreserved headroom on the shared account"}}
{{> components/kpi label="Admission" value=admission_label tone=admission_tone note="whether the complete matrix fits the cap"}}
</div>
<section class="sp-section sp-aflow-block">
{{> components/section title="Frozen matrix" note="The digest below identifies the exact matrix that would run. A different digest is a different experiment."}}
<dl class="sp-aflow-facts">
<dt>Matrix digest</dt><dd class="sp-u-mono">{{estimate.matrix_digest}}</dd>
<dt>Budget account</dt><dd class="sp-u-mono">{{budget_id}}</dd>
<dt>Idempotency key</dt><dd class="sp-u-mono">{{idempotency_key}}</dd>
</dl>
</section>
{{#if estimate.affordable}}
<section class="sp-section sp-aflow-block">
<form class="sp-form-section" method="post" action="/admin/analysis/evaluations/launch">
{{> components/section title="Launch this exact matrix" note="Launching reserves the conservative maximum against the shared account and dispatches every execution."}}
<div class="sp-form-section__body">
<input type="hidden" name="budget_id" value="{{budget_id}}">
<input type="hidden" name="idempotency_key" value="{{idempotency_key}}">
<textarea hidden name="spec_json">{{spec_json}}</textarea>
</div>
<footer class="sp-form-section__foot"><button class="sp-btn sp-btn--primary" type="submit">Launch exact frozen matrix</button><span class="sp-aflow-help">Next: watch its executions on the experiment page.</span></footer>
</form>
</section>
{{else}}
{{> components/notice tone="warn" title="Budget blocked" message="The full matrix exceeds the shared account, and the matrix has not been reduced to fit. Raise the cap or preflight a smaller reviewed specification."}}
{{/if}}
{{/inline}}{{/layout}}
