{{!--
  Farm › Credentials: names, kinds and dates of the credentials the farm
  holds for every tenant (or one). Metadata only, by design: there is nothing here that
  can hold or accept a secret, and the view model has no field for one.
--}}
{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{> components/page-header title=title subtitle="Which credentials the Dynapps Farm holds, every tenant mixed unless you pick one: name, kind and dates. The secrets themselves are never shown."}}

    <section class="sp-section" aria-label="Credentials">
    {{#if select.has_tenants}}
    <form method="get" action="{{select.action}}" class="sp-toolbar">
        <label class="sp-toolbar__count" for="farm-tenant">Tenant</label>
        <select id="farm-tenant" name="tenant" class="sp-search-input" data-autosubmit>
            <option value=""{{#if select.all_selected}} selected{{/if}}>All tenants</option>
            {{#each select.tenants}}<option value="{{slug}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <noscript><button type="submit" class="sp-btn sp-btn--sm sp-btn--outline">Show</button></noscript>
    </form>
    {{/if}}

    {{#if has_rows}}
    {{#> components/table caption=count_label}}
      <thead><tr>
        <th scope="col">Name</th>
        <th scope="col">Level</th>
        <th scope="col">Kind</th>
        <th scope="col">Tenant</th>
        <th scope="col">Description</th>
        <th scope="col" class="sp-col-date">Expires</th>
        <th scope="col" class="sp-col-date">Created</th>
        <th scope="col" class="sp-col-date">Rotated</th>
      </tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td class="sp-table__cell--primary"><code class="sp-code-inline">{{name}}</code></td>
          <td>{{> components/badge tone=scope_tone text=scope}}</td>
          <td>{{kind}}</td>
          <td>{{tenant}}</td>
          <td>{{description}}</td>
          <td class="sp-col-date">{{expires}}</td>
          <td class="sp-col-date">{{created}}</td>
          <td class="sp-col-date">{{updated}}</td>
        </tr>
        {{/each}}
      </tbody>
    {{/components/table}}
    {{else}}
    {{#if loaded}}
    {{> components/empty-state heading="No credentials" message="farm-api holds no credentials to show."}}
    {{else}}
    {{> components/empty-state heading="Credentials unavailable" message="The farm could not be read; the notice above says why."}}
    {{/if}}
    {{/if}}
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-farm.js"></script>
    {{/inline}}
{{/layout}}
