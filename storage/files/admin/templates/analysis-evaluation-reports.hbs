{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Every report the writer has produced, newest first — each one a snapshot of what the judge was seeing at the time, so a scope can be read against its own history."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analysis/evaluation">Evaluation &rarr;</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
{{#> components/toolbar toolbar_count=(concat pagination.total_rows " " pagination.noun)}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter" method="get" action="/admin/analysis/evaluation/report">
<label class="sp-u-sr-only" for="rep-scope">Scope</label>
<input class="sp-search-input" type="text" id="rep-scope" name="scope" value="{{scope}}" placeholder="global or marketplace:<id>">
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply</button>
</form>
{{/inline}}
{{/components/toolbar}}
<section class="sp-section sp-aflow-block">
{{#> components/table caption="Evaluation reports" pagination=pagination}}
<thead><tr><th scope="col">Written</th><th scope="col">Scope</th><th scope="col">Status</th><th scope="col">Assessment</th><th scope="col">Headline</th><th scope="col" class="sp-table__cell--num">Themes</th><th scope="col" class="sp-table__cell--num">Actions</th><th scope="col">Model</th><th scope="col" class="sp-table__cell--num">Cost</th></tr></thead>
<tbody>
{{#each reports}}
<tr>
<td class="sp-table__cell--primary"><a class="sp-table__link" href="{{view.href}}" title="{{view.generated_display}}">{{#if view.generated_relative}}{{view.generated_relative}}{{else}}—{{/if}}</a></td>
<td>{{view.scope_label}}</td>
<td>{{> components/badge tone=status_tone text=status}}{{#if last_error}}<div class="sp-aconv-meta" title="{{last_error}}">attempt {{attempts}} · {{last_error}}</div>{{/if}}</td>
<td>{{#if view.has_findings}}{{> components/badge tone=view.assessment_tone text=view.assessment}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td class="sp-aconv-cell-summary">{{#if view.has_findings}}{{view.headline}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
<td class="sp-table__cell--num sp-u-num">{{theme_count}}</td>
<td class="sp-table__cell--num sp-u-num">{{recommendation_count}}</td>
<td>{{view.model}}</td>
<td class="sp-table__cell--num sp-u-num">{{view.cost}}</td>
</tr>
{{else}}<tr class="sp-table__empty"><td colspan="9">{{> components/empty-state heading="No report yet" message="The evaluation_report job writes one per scope once enough sessions have been judged; Regenerate on the Evaluation page asks for one now."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
{{/inline}}{{/layout}}
