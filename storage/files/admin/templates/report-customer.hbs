{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{!--
      The sendable report. Nothing on this page is an internal figure: usage
      only, never what serving it cost.
    --}}
    {{> components/page-header title=scope_name subtitle=month_label}}

    <div class="sp-toolbar">
        {{> components/scope-filter scope_filter}}
        {{> components/month-selector}}
        <a class="sp-btn sp-btn--secondary" href="/admin/reports/customer.csv?month={{month_key}}{{#if project_key}}&project={{project_key}}{{/if}}" data-print-hide>Download CSV</a>
        <button class="sp-btn sp-btn--secondary" type="button" data-print-report>Print / Save PDF</button>
    </div>

    <div class="sp-report-print-header" aria-hidden="true">
        <strong>{{scope_name}} — usage report</strong>
        <span>{{month_label}} · generated {{generated_at}}</span>
    </div>

    {{#unless month_complete}}
    <p class="sp-notice" role="status">
        {{month_label}} is still in progress — these figures cover the month so far.
    </p>
    {{/unless}}

    <section class="sp-kpi-grid" aria-label="Usage summary for {{month_label}}">
      {{> components/kpi label="Users with activity" value=(formatNumber summary.active_users)}}
      {{> components/kpi label="Requests" value=(formatNumber summary.requests) subtitle=(concat summary.success_rate_display " succeeded")}}
      {{> components/kpi label="Total tokens" value=summary.total_tokens_display subtitle="metered billable total"}}
      {{> components/kpi label="Input tokens" value=summary.input_tokens_display}}
      {{> components/kpi label="Output tokens" value=summary.output_tokens_display}}
      {{> components/kpi label="Cached reads" value=summary.cache_read_tokens_display subtitle="served from cache"}}
      {{> components/kpi label="Thinking tokens" value=summary.reasoning_tokens_display subtitle=(concat summary.reasoning_share_display " of output")}}
    </section>

    <section aria-label="Usage by project" data-page="report-customer">
    <h2 class="sp-report-section-title">By project</h2>
    {{#if projects}}
    {{#> components/table}}
        <thead><tr>
            <th>Project</th>
            <th class="sp-col-share">Share</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Members who made at least one request">People</th>
            <th class="sp-u-numeric sp-table__cell--num">Requests</th>
            <th class="sp-u-numeric sp-table__cell--num">Input</th>
            <th class="sp-u-numeric sp-table__cell--num">Output</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Reasoning tokens, billed inside output">Thinking</th>
            <th class="sp-u-numeric sp-table__cell--num">Total tokens</th>
        </tr></thead>
        <tbody>
        {{#each projects}}
        <tr>
            <td>{{this.project}}</td>
            <td class="sp-col-share">
                <span class="sp-share-bar" style="--v:{{this.share_pct}}%" aria-hidden="true"></span>
                <span class="sp-share-bar__value">{{this.share_display}}</span>
            </td>
            <td class="sp-u-numeric">{{this.members}}</td>
            <td class="sp-u-numeric">{{formatNumber this.requests}}</td>
            <td class="sp-u-numeric">{{this.input_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.output_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.reasoning_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.total_tokens_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="No project recorded any usage in this month."}}
    {{/if}}
    </section>

    <section aria-label="Usage by model">
    <h2 class="sp-report-section-title">By model</h2>
    {{#if models}}
    {{#> components/table}}
        <thead><tr>
            <th>Model</th>
            <th>Provider</th>
            <th class="sp-col-share">Share</th>
            <th class="sp-u-numeric sp-table__cell--num">Requests</th>
            <th class="sp-u-numeric sp-table__cell--num">Input</th>
            <th class="sp-u-numeric sp-table__cell--num">Output</th>
            <th class="sp-u-numeric sp-table__cell--num">Cached</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Reasoning tokens, billed inside output">Thinking</th>
            <th class="sp-u-numeric sp-table__cell--num">Total tokens</th>
        </tr></thead>
        <tbody>
        {{#each models}}
        <tr>
            <td><code class="sp-code-inline">{{this.model}}</code></td>
            <td>{{this.provider}}</td>
            <td class="sp-col-share">
                <span class="sp-share-bar" style="--v:{{this.share_pct}}%" aria-hidden="true"></span>
                <span class="sp-share-bar__value">{{this.share_display}}</span>
            </td>
            <td class="sp-u-numeric">{{formatNumber this.requests}}</td>
            <td class="sp-u-numeric">{{this.input_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.output_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.cache_read_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.reasoning_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.total_tokens_display}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="No model was called in this month."}}
    {{/if}}
    </section>

    <section aria-label="Usage by user">
    <h2 class="sp-report-section-title">By user</h2>
    {{#if users}}
    {{#> components/table}}
        <thead><tr>
            <th>User</th>
            <th>Project</th>
            <th class="sp-col-share">Share</th>
            <th class="sp-u-numeric sp-table__cell--num">Requests</th>
            <th class="sp-u-numeric sp-table__cell--num">Input</th>
            <th class="sp-u-numeric sp-table__cell--num">Output</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Reasoning tokens, billed inside output">Thinking</th>
            <th class="sp-u-numeric sp-table__cell--num">Total tokens</th>
            <th class="sp-u-numeric sp-table__cell--num" title="Distinct models this person reached">Models</th>
        </tr></thead>
        <tbody>
        {{#each users}}
        <tr>
            <td>
                <span class="sp-user-cell">
                    <span class="sp-avatar sp-avatar-sm">{{initials this.display_name}}</span>
                    <span class="sp-user-cell-text">
                        <span class="sp-user-cell-name">{{this.display_name}}</span>
                        <span class="sp-user-cell-email">{{this.email}}</span>
                    </span>
                </span>
            </td>
            <td>{{this.project}}</td>
            <td class="sp-col-share">
                <span class="sp-share-bar" style="--v:{{this.share_pct}}%" aria-hidden="true"></span>
                <span class="sp-share-bar__value">{{this.share_display}}</span>
            </td>
            <td class="sp-u-numeric">{{formatNumber this.requests}}</td>
            <td class="sp-u-numeric">{{this.input_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.output_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.reasoning_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.total_tokens_display}}</td>
            <td class="sp-u-numeric">{{this.distinct_models}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="Nobody in this scope made a request in this month."}}
    {{/if}}
    </section>

    <p class="sp-report-footer">
        {{scope_name}} · {{month_label}} · generated {{generated_at}}. Token counts are metered per
        request at the gateway.
    </p>
    <script data-cfasync="false" type="module" src="/js/pages/admin-report-print.js"></script>
    {{/inline}}
{{/layout}}
