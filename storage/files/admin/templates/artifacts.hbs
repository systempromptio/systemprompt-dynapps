{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header
        title="Artifacts"
        subtitle="Every tool result the platform ingested, from any client, as one entity: the typed body, where it was seen, how it was joined to the call that produced it, and what the scanners found. Structured results — the ones an MCP server declared as data — are shown by default."}}
      {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/traces">Traces</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/requests">Requests</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/sessions">Sessions</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis">Analysis</a>
      {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Artifact summary">
      {{> components/kpi label="Artifacts" value=(formatNumber stats.artifacts) note="in window"}}
      {{> components/kpi label="Structured" value=(formatNumber stats.structured)
          note="declared as data by a server" hint="Results with structuredContent, an artifact type, or a systemprompt execution key"}}
      {{> components/kpi label="Failed" value=(formatNumber stats.errors) tone="err"
          href=errors_toggle_url active=errors_only note="isError results"}}
      {{> components/kpi label="With findings" value=(formatNumber stats.with_findings) tone="warn"
          note="scanner hits" hint="Secret redactions or safety findings recorded at ingestion"}}
      {{> components/kpi label="Inferred joins" value=(formatNumber stats.inferred) tone="warn"
          note="no exact key" hint="Joined to their execution by session, tool, digest and time rather than by a key"}}
      {{> components/kpi label="Stored" value=stats.bytes_display note="content-addressed bytes"}}
    </section>

    {{#> components/toolbar toolbar_count=count_label}}
      {{#*inline "toolbar_filters"}}
        <form method="get" action="{{filter_ribbon.base_url}}" class="sp-toolbar__filter">
          {{#each filter_ribbon.preserved}}<input type="hidden" name="{{this.name}}" value="{{this.value}}">{{/each}}
          <label class="sp-u-sr-only" for="artifacts-user">User</label>
          <select id="artifacts-user" name="user_id" class="sp-search-input">
            <option value="">All users</option>
            {{#each filter_ribbon.options.users}}
              <option value="{{this.id}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <button type="submit" class="sp-btn sp-btn--sm sp-btn--primary">Apply</button>
        </form>
        {{#if filter_ribbon.chips}}
          <div class="sp-chip-row">
            {{#each filter_ribbon.chips}}
              <span class="sp-chip">{{this.group_label}}: <code class="sp-code-inline">{{this.label}}</code> <a href="{{this.remove_url}}" aria-label="Remove {{this.group_label}} filter">&times;</a></span>
            {{/each}}
          </div>
        {{/if}}
      {{/inline}}
      {{#*inline "toolbar_actions"}}
        {{#if structured_only}}
          <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{all_toggle_url}}" title="Include every result, builtin tool output included">Show all results</a>
        {{else}}
          <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{all_toggle_url}}">Structured only</a>
        {{/if}}
        {{#if errors_only}}
          <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{errors_toggle_url}}">Clear failed filter</a>
        {{else}}
          <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{errors_toggle_url}}">Failed only</a>
        {{/if}}
      {{/inline}}
    {{/components/toolbar}}

    {{#if has_artifacts}}
      {{#> components/table caption="Artifacts in the selected window" pagination=pagination modifier="sp-p-artifacts__table"}}
        <thead><tr>
          <th class="sp-col-date">When</th>
          <th class="sp-col-conversation">Artifact</th>
          <th>Type</th>
          <th title="The skill most recently invoked in the same session before this result">Skill</th>
          <th class="sp-col-owner">User</th>
          <th title="Where the platform saw the result">Source</th>
          <th title="Exact: joined by the client tool_use_id or the server execution id. Inferred: joined by session, tool, digest and time.">Join</th>
          <th class="sp-table__cell--num" title="Scanner findings recorded at ingestion">Findings</th>
          <th class="sp-table__cell--num">Size</th>
          <th class="sp-col-status">State</th>
        </tr></thead>
        <tbody>
        {{#each artifacts}}
        <tr>
          <td class="sp-col-date sp-table__cell--date" title="{{this.created_at}}">{{this.created_relative}}</td>
          <td class="sp-col-conversation sp-table__cell--stacked" title="{{this.artifact_id}}">
            <a href="{{this.detail_url}}" class="sp-u-link-strong">{{this.artifact_title}}</a>
            <span class="sp-table__cell--muted"><code class="sp-code-inline">{{this.tool_name}}</code> · {{this.server_name}}{{#if this.session_url}} · <a href="{{this.session_url}}" title="{{this.session_id}}">session</a>{{/if}}{{#if this.request_url}} · <a href="{{this.request_url}}">request</a>{{/if}}</span>
          </td>
          <td><span class="sp-badge sp-badge--nodot {{#if this.is_structured}}sp-badge--info{{else}}sp-badge--muted{{/if}}">{{this.artifact_type}}</span>{{#if this.has_ui_resource}} <span class="sp-badge sp-badge--nodot sp-badge--ok" title="Carries an MCP Apps ui:// resource">ui</span>{{/if}}</td>
          <td class="sp-table__cell--muted">{{#if this.skill}}<a href="{{this.skill_url}}"><code class="sp-code-inline">{{this.skill}}</code></a>{{else}}&mdash;{{/if}}</td>
          <td class="sp-col-owner sp-table__cell--muted" title="{{this.user_id}}">{{this.user_label}}</td>
          <td class="sp-table__cell--muted" title="{{this.source}}">{{this.source_label}}{{#if this.client_label}} <span class="sp-table__cell--muted">· {{this.client_label}}</span>{{/if}}</td>
          <td><span class="sp-badge sp-badge--{{this.correlation_tone}}">{{this.correlation}}</span></td>
          <td class="sp-table__cell--num">{{#if this.finding_count}}<span class="sp-u-text-warning">{{formatNumber this.finding_count}}</span>{{else}}&mdash;{{/if}}{{#if this.secret_redactions}} <span class="sp-badge sp-badge--err sp-badge--nodot" title="{{this.secret_redactions}} secret span(s) redacted before storage">redacted</span>{{/if}}</td>
          <td class="sp-table__cell--num sp-u-mono">{{this.bytes_display}}</td>
          <td class="sp-col-status"><span class="sp-badge sp-badge--{{this.state_tone}}">{{this.state_label}}</span></td>
        </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
    {{else}}
      {{> components/empty-state
          title="No artifacts in this window"
          message="No tool result was ingested under the selected scope and time range. Widen the range, clear the filters, or show all results to include builtin tool output."}}
    {{/if}}
    {{/inline}}
{{/layout}}
