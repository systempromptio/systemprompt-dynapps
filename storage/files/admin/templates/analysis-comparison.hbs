{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Exactly what changed between two revisions, before anything measures the effect. This is a file comparison, not an evaluation result."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/versions">&larr; Versions</a>{{/inline}}
{{#*inline "header_meta"}}Baseline <a class="sp-u-mono" href="/admin/analysis/revisions/{{comparison.baseline}}" title="{{comparison.baseline}}">{{shortId comparison.baseline 8}}</a> → candidate <a class="sp-u-mono" href="/admin/analysis/revisions/{{comparison.candidate}}" title="{{comparison.candidate}}">{{shortId comparison.candidate 8}}</a>{{/inline}}
{{/components/page-header}}
{{#if comparison.dependencies_changed}}{{> components/notice tone="warn" title="Dependencies changed" message="These revisions do not share their dependencies. Review those revisions before attributing any difference in outcome to this file."}}{{/if}}
{{#if comparison.source_snapshot_changed}}{{> components/notice tone="warn" title="Different source snapshots" message="The two revisions refer to different source snapshots, so some of the difference below did not come from an edit here."}}{{/if}}
<section class="sp-section sp-aflow-block">
{{> components/section title="Changed files" note="Every file whose content or metadata differs. Publication is a separate reviewed action."}}
{{#> components/table caption="Files changed between the two revisions" modifier="sp-analysis-diff-table"}}
<thead><tr><th scope="col">File</th><th scope="col">Change</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
<tbody>
{{#each comparison.changes}}<tr><td class="sp-table__cell--primary sp-aflow-cell-id sp-u-mono" title="{{path}}">{{path}}</td><td>{{> components/badge tone="info" text=kind}}</td><td class="sp-u-mono"{{#if before}} title="{{before.digest}}"{{/if}}>{{#if before}}{{shortId before.digest 12}} <span class="sp-u-text-tertiary">{{formatNumber before.bytes}} B</span>{{else}}<span class="sp-u-text-tertiary">Absent</span>{{/if}}</td><td class="sp-u-mono"{{#if after}} title="{{after.digest}}"{{/if}}>{{#if after}}{{shortId after.digest 12}} <span class="sp-u-text-tertiary">{{formatNumber after.bytes}} B</span>{{else}}<span class="sp-u-text-tertiary">Absent</span>{{/if}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="4">{{> components/empty-state title="No changes" message="These two revisions have identical file content and metadata. There is nothing here to evaluate."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<section class="sp-section sp-aflow-block">
{{> components/section title="Instructions side by side" note="SKILL.md as each revision holds it."}}
<div class="sp-analysis-comparison">
<section><h3 class="sp-section__title">Baseline</h3><pre class="sp-analysis-file-preview"><code>{{before.text}}</code></pre>{{#if before.truncated}}<p class="sp-aflow-help">Preview truncated. Open the revision evidence for the full download.</p>{{/if}}</section>
<section><h3 class="sp-section__title">Candidate</h3><pre class="sp-analysis-file-preview"><code>{{after.text}}</code></pre>{{#if after.truncated}}<p class="sp-aflow-help">Preview truncated. Open the revision evidence for the full download.</p>{{/if}}</section>
</div>
</section>
{{/inline}}{{/layout}}
