{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="A service account. It never signs in; its credentials are issued only to a workflow write-back or farm caller."}}
        {{#*inline "header_actions"}}
            <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="delete-service-account" data-user-id="{{user_id}}"{{#if has_credentials}} disabled title="Remove its credentials first"{{/if}}>Delete account</button>
        {{/inline}}
    {{/components/page-header}}

    <dl class="sp-kv-list">
        <div class="sp-kv-row"><dt>Email</dt><dd class="sp-u-mono">{{email}}</dd></div>
        <div class="sp-kv-row"><dt>Account id</dt><dd class="sp-u-mono">{{user_id}}</dd></div>
        <div class="sp-kv-row"><dt>Created</dt><dd>{{created_at}}</dd></div>
    </dl>

    <section class="sp-section sp-p-service-accounts" aria-label="Machine credentials">
    <h2 class="sp-section__title">Machine credentials</h2>
    {{#if has_credentials}}
    {{#> components/table caption="Machine credentials"}}
      <thead><tr>
        <th scope="col">Provider</th><th scope="col">Kind</th><th scope="col">Identifiers</th>
        <th scope="col">Attached by</th><th scope="col" class="sp-col-date">Attached</th><th scope="col" class="sp-col-date">Rotated</th>
        <th scope="col" class="sp-table__cell--actions"><span class="sp-u-sr-only">Actions</span></th>
      </tr></thead>
      <tbody>
        {{#each credentials}}
        <tr>
          <td class="sp-table__cell--primary sp-u-mono">{{provider}}</td>
          <td>{{kind_label}}</td>
          <td class="sp-u-mono">{{identifiers}}</td>
          <td>{{created_by}}</td>
          <td class="sp-col-date">{{created_at}}</td>
          <td class="sp-col-date">{{#if rotated_at}}{{rotated_at}}{{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}</td>
          <td class="sp-table__cell--actions">
            <button type="button" class="sp-btn sp-btn--xs sp-btn--outline" data-action="rotate-credential" data-provider="{{provider}}">Rotate</button>
            <button type="button" class="sp-btn sp-btn--xs sp-btn--ghost" data-action="remove-credential" data-provider="{{provider}}" data-user-id="{{../user_id}}">Remove</button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state heading="No credentials" message="Attach one per provider this account writes back to."}}
    {{/if}}
    </section>

    <section class="sp-section sp-p-service-accounts__attach" aria-label="Attach a credential">
    <h2 class="sp-section__title">Attach or rotate a credential</h2>
    <p class="sp-p-service-accounts__note">The secret is sealed on save and never shown again. Attaching to a provider that already has a credential rotates it.</p>
    <form class="sp-dialog-form" data-form="attach-credential" data-user-id="{{user_id}}">
        <label for="sa-provider">Provider (MCP server id)</label>
        <input type="text" id="sa-provider" class="sp-search-input" data-field="provider" placeholder="github" autocomplete="off">
        <label for="sa-kind">Kind</label>
        <select id="sa-kind" class="sp-filter-select" data-field="kind">
            {{#each kinds}}<option value="{{value}}">{{label}}</option>{{/each}}
        </select>
        <div data-kind-fields="github_app">
            <label for="sa-app-id">App ID</label>
            <input type="text" id="sa-app-id" class="sp-search-input" data-field="app_id" inputmode="numeric" autocomplete="off">
            <label for="sa-installation-id">Installation ID</label>
            <input type="text" id="sa-installation-id" class="sp-search-input" data-field="installation_id" inputmode="numeric" autocomplete="off">
        </div>
        <div data-kind-fields="salesforce_client_credentials" hidden>
            <label for="sa-instance-url">Instance URL</label>
            <input type="url" id="sa-instance-url" class="sp-search-input" data-field="instance_url" placeholder="https://example.my.salesforce.com" autocomplete="off">
            <label for="sa-consumer-key">Consumer key (client ID)</label>
            <input type="text" id="sa-consumer-key" class="sp-search-input" data-field="consumer_key" autocomplete="off">
        </div>
        <div data-kind-fields="atlassian_api_token" hidden>
            <label for="sa-email">Token owner email</label>
            <input type="email" id="sa-email" class="sp-search-input" data-field="email" autocomplete="off">
        </div>
        <div data-kind-fields="odoo_api_key" hidden>
            <label for="sa-odoo-url">Odoo URL</label>
            <input type="url" id="sa-odoo-url" class="sp-search-input" data-field="url" placeholder="https://odoo.example.com" autocomplete="off">
            <label for="sa-odoo-db">Database</label>
            <input type="text" id="sa-odoo-db" class="sp-search-input" data-field="db" autocomplete="off">
            <label for="sa-odoo-login">Login</label>
            <input type="text" id="sa-odoo-login" class="sp-search-input" data-field="login" autocomplete="off">
        </div>
        <label for="sa-secret">Secret (private key PEM, client secret, API token or API key)</label>
        <textarea id="sa-secret" class="sp-search-input sp-p-service-accounts__secret" data-field="secret" rows="4" autocomplete="off" spellcheck="false"></textarea>
        <menu>
            <button type="button" class="sp-btn sp-btn--primary" data-action="attach-credential">Save credential</button>
        </menu>
    </form>
    </section>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-service-accounts.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
