{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Who reaches what on this instance, and why. The database is what is enforced; services/access-control/rules.yaml is what it is expected to contain. Edit a group's band on its Access tab, a person's overrides on theirs."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{docs_url}}" target="_blank" rel="noopener noreferrer">How it works</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/groups">Group rules</a>
        <a class="sp-btn sp-btn--sm sp-btn--secondary" href="{{sync_url}}">Sync &amp; export</a>
        {{#if can_write}}
        <button type="button" class="sp-btn sp-btn--sm sp-btn--primary" data-action="new-group">+ New group</button>
        {{/if}}
        {{/inline}}
        {{#*inline "header_meta"}}
        <span><strong>{{stats.groups}}</strong> groups</span>
        <span><strong>{{stats.projects}}</strong> projects</span>
        <span><strong>{{stats.users}}</strong> people</span>
        <span>Declared in <code class="sp-code-inline">services/access-control/rules.yaml</code>; enforced from this database</span>
        {{/inline}}
    {{/components/page-header}}

    {{#if declared_unreadable}}
    {{> components/notice tone="err" title="rules.yaml could not be read" message=declared_unreadable}}
    {{/if}}

    {{#if drift}}
    <div class="sp-notice sp-notice--warn sp-ac-drift" role="status">
        <p class="sp-notice__title">Code and database differ</p>
        <p>
            <strong>{{drift.counts.missing_in_db}}</strong> declared in code but missing here ·
            <strong>{{drift.counts.only_in_db}}</strong> only in this database
            ({{drift.counts.only_in_db_dashboard}} from the console, {{drift.counts.only_in_db_stale}} stale) ·
            <strong>{{drift.counts.changed}}</strong> differ ·
            <strong>{{drift.counts.default_changed}}</strong> defaults differ.
            Nothing is changed automatically.
        </p>
        <p><a class="sp-btn sp-btn--sm sp-btn--secondary" href="{{drift.url}}">Review and synchronise</a></p>
    </div>
    {{/if}}

    <details class="sp-ac-explain" data-ac="explain" open>
        <summary>How a decision is made</summary>
        <div class="sp-ac-explain__body">
            <ol class="sp-ac-ladder" aria-label="Precedence ladder, narrowest first">
                <li><span class="sp-ac-ladder__band">person</span><span class="sp-ac-ladder__prec">0</span><span class="sp-ac-ladder__note">an override on one account</span></li>
                <li><span class="sp-ac-ladder__band">project</span><span class="sp-ac-ladder__prec">140</span><span class="sp-ac-ladder__note">work the person is assigned to</span></li>
                <li><span class="sp-ac-ladder__band">group</span><span class="sp-ac-ladder__prec">150</span><span class="sp-ac-ladder__note">the team the directory placed them in</span></li>
                <li><span class="sp-ac-ladder__band">linked account</span><span class="sp-ac-ladder__prec">170</span><span class="sp-ac-ladder__note">an org they have connected</span></li>
                <li><span class="sp-ac-ladder__band">role</span><span class="sp-ac-ladder__prec">200</span><span class="sp-ac-ladder__note">the widest band: user, admin, …</span></li>
            </ol>
            <ul class="sp-ac-explain__rules">
                <li>The <strong>narrowest band in which the person matches any rule decides</strong>; bands where nothing names them are skipped.</li>
                <li>Inside that band a <strong>deny beats an allow</strong>.</li>
                <li>An entity with any rule is <strong>closed</strong> to everyone its rules do not name, unless it is marked <strong>open</strong>.</li>
                <li>An entity with no rule at all inherits from its parent: skill → plugin → marketplace.</li>
            </ul>
            <p class="sp-ac-explain__more"><a href="{{docs_url}}" target="_blank" rel="noopener noreferrer">Worked examples, the file format and the sync loop →</a></p>
        </div>
    </details>

    <section class="sp-kpi-grid" aria-label="Access-control totals">
        {{#each entities.kpis}}
        {{> components/kpi label=label value=value note=note tone=tone}}
        {{/each}}
    </section>

    {{#> components/section title="Entities" count=entities.total note="One row per governed entity. Chips are the subjects each band names; expand a row for the individual rules and the resolver's outcome in plain words."}}
        {{#*inline "section_actions"}}
        {{#if entities.filters_applied}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="{{entities.clear_url}}">Clear filters</a>{{/if}}
        {{/inline}}
    {{/components/section}}

    <form class="sp-toolbar sp-toolbar--fields" method="get" action="/admin/access-control" role="search" aria-label="Filter entities">
        <div class="sp-toolbar__field">
            <label class="sp-toolbar__field-label" for="ac-filter-entity">Entity kind</label>
            <select class="sp-select" id="ac-filter-entity" name="entity_kind">
            {{#each entities.entity_options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </div>
        <div class="sp-toolbar__field">
            <label class="sp-toolbar__field-label" for="ac-filter-band">Band</label>
            <select class="sp-select" id="ac-filter-band" name="band">
            {{#each entities.band_options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </div>
        <div class="sp-toolbar__field">
            <label class="sp-toolbar__field-label" for="ac-filter-state">State</label>
            <select class="sp-select" id="ac-filter-state" name="state">
            {{#each entities.state_options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
            </select>
        </div>
        <div class="sp-toolbar__field">
            <label class="sp-toolbar__field-label" for="ac-filter-expiring">Expiry</label>
            <select class="sp-select" id="ac-filter-expiring" name="expiring">
                <option value="">Any</option>
                <option value="7d"{{#if entities.expiring_only}} selected{{/if}}>Expiring in 7 days</option>
            </select>
        </div>
        <label class="sp-u-sr-only" for="ac-filter-q">Search entities</label>
        <div class="sp-toolbar__search">
            <input class="sp-search-input" id="ac-filter-q" type="search" name="q" value="{{entities.search}}" placeholder="Entity, subject or reason">
        </div>
        <div class="sp-toolbar__actions">
            <button type="submit" class="sp-btn sp-btn--sm sp-btn--secondary">Apply</button>
        </div>
    </form>

    {{#if entities.rows}}
    {{#> components/table caption="Governed entities" modifier="sp-p-ac__entities"}}
        <thead><tr>
            <th class="sp-col-entity">Entity</th>
            <th class="sp-col-default">Default</th>
            <th class="sp-col-reaches">Reaches</th>
            <th class="sp-col-denied">Refused</th>
            <th class="sp-col-why">Why</th>
            <th class="sp-col-state">Code ↔ DB</th>
        </tr></thead>
        <tbody>
        {{#each entities.rows}}
        <tr class="sp-ac-entity" data-entity-type="{{entity_type}}" data-entity-id="{{entity_id}}">
            <td>
                <details class="sp-ac-entity__details">
                    <summary class="sp-ac-entity__summary">
                        <span class="sp-ac-entity__kind">{{entity_type_label}}</span>
                        <span class="sp-u-mono sp-ac-entity__id">{{entity_id}}</span>
                    </summary>
                    <div class="sp-ac-entity__expanded">
                        <p class="sp-ac-entity__resolution">{{resolution}}</p>
                        <table class="sp-ac-rules">
                            <thead><tr><th>Band</th><th>Subject</th><th>Access</th><th>Written by</th><th>Reason</th><th>Expires</th></tr></thead>
                            <tbody>
                            {{#each rules}}
                            <tr>
                                <td><span class="sp-ac-layer-tag">{{band_label}}</span></td>
                                <td class="sp-u-mono">{{subject}}</td>
                                <td>{{> components/badge tone=access_tone text=access}}</td>
                                <td>{{> components/badge tone=source_tone text=source}}</td>
                                <td class="sp-u-text-secondary">{{justification}}</td>
                                <td>{{#if expires_at}}<span title="{{formatDate expires_at}}">{{relativeTime expires_at}}</span>{{#if expires_soon}} {{> components/badge tone="warn" text="soon"}}{{/if}}{{else}}<span class="sp-u-text-tertiary">Never</span>{{/if}}</td>
                            </tr>
                            {{/each}}
                            </tbody>
                        </table>
                    </div>
                </details>
            </td>
            <td>{{#if default_open}}{{> components/badge tone="warn" text="open"}}{{else}}{{> components/badge tone="muted" text="closed"}}{{/if}}</td>
            <td>
                {{#each allow}}
                <span class="sp-ac-band"><span class="sp-ac-band__label">{{label}}</span>{{#each values}}<span class="sp-ac-band__chip">{{this}}</span>{{/each}}</span>
                {{else}}<span class="sp-u-text-tertiary">—</span>{{/each}}
            </td>
            <td>
                {{#each deny}}
                <span class="sp-ac-band sp-ac-band--deny"><span class="sp-ac-band__label">{{label}}</span>{{#each values}}<span class="sp-ac-band__chip">{{this}}</span>{{/each}}</span>
                {{else}}<span class="sp-u-text-tertiary">—</span>{{/each}}
            </td>
            <td class="sp-ac-entity__why">{{#if has_why}}{{why}}{{else}}<span class="sp-u-text-tertiary">No reason recorded</span>{{/if}}{{#if expiring_soon}} {{> components/badge tone="warn" text="expiring"}}{{/if}}</td>
            <td>{{#if in_sync}}{{> components/badge tone=state_tone text=state}}{{else}}<a class="sp-badge sp-badge--{{state_tone}}" href="{{sync_url}}">{{state}} ↗</a>{{/if}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state title="No entity matches" message="No governed entity matches these filters. Clear them to see every entity."}}
    {{/if}}

    {{#if entities.capped}}
    {{> components/notice tone="warn" title="Listing is capped" message="Only the first 1000 rules were read. Narrow the filters to see the rest."}}
    {{/if}}

    {{#> components/section title="Audience grid" note="Every role, group and project against every entity, decided by the same resolver the enforcement point calls. The word in each cell is the band that decided."}}
        {{#*inline "section_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/users">Check one person →</a>
        {{/inline}}
    {{/components/section}}

    {{#if audience.has_rows}}
    <div class="sp-audience-matrix-wrap sp-ac-grid" tabindex="0" role="region" aria-label="Audience grid">
        <table class="sp-audience-matrix sp-table__el">
            <thead>
                <tr>
                    <th scope="col">Entity</th>
                    {{#each audience.columns}}
                    <th scope="col" class="sp-audience-matrix__col"><span class="sp-audience-matrix__label">{{label}}</span> <span class="sp-audience-matrix__kind">{{kind}}</span></th>
                    {{/each}}
                </tr>
            </thead>
            <tbody>
                {{#each audience.rows}}
                <tr class="sp-audience-matrix__row" data-entity-type="{{entity_type}}" data-entity-id="{{entity_id}}">
                    <th scope="row" class="sp-audience-matrix__subject">
                        <span class="sp-audience-matrix__label">{{entity_name}}</span>
                        <span class="sp-audience-matrix__kind">{{entity_type_label}}</span>
                    </th>
                    {{#each cells}}
                    <td class="sp-audience-matrix__cell {{#if allow}}is-allow{{else}}is-deny{{/if}}" title="{{effective}}: {{detail}}">
                        <span class="sp-audience-matrix__layer">{{layer}}</span>
                    </td>
                    {{/each}}
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    {{> components/empty-state message="The grid could not be resolved. Check the server log for the access-control resolver."}}
    {{/if}}

    {{#if can_write}}
    <dialog class="sp-dialog sp-ac-dialog" data-dialog="new-group" aria-labelledby="ac-new-group-title">
        <div class="sp-ac-dialog__header">
            <h2 id="ac-new-group-title">Create group</h2>
            <button type="button" class="sp-ac-dialog__close" data-action="close-dialog" aria-label="Close">&times;</button>
        </div>
        <div class="sp-ac-dialog__body">
            <label class="sp-ac-field">
                <span>Identifier</span>
                <input type="text" data-ac="new-group-id" class="sp-search-input" placeholder="europe-devs" autocomplete="off" maxlength="64">
            </label>
            <label class="sp-ac-field">
                <span>Name</span>
                <input type="text" data-ac="new-group-name" class="sp-search-input" placeholder="Commerce devs" autocomplete="off" maxlength="64">
            </label>
            <label class="sp-ac-field">
                <span>Description</span>
                <input type="text" data-ac="new-group-desc" class="sp-search-input" autocomplete="off">
            </label>
            <p class="sp-ac-form-error" data-ac="new-group-error" hidden></p>
            <p class="sp-ac-modal-hint">
                The group is created in this instance's database. People the directory has not
                placed anywhere stay in <strong>Unassigned</strong>.
            </p>
        </div>
        <div class="sp-ac-dialog__actions">
            <button type="button" class="sp-btn sp-btn--primary" data-action="save-group">Create</button>
            <button type="button" class="sp-btn sp-btn--outline" data-action="close-dialog">Cancel</button>
        </div>
    </dialog>
    {{/if}}

    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-access-control.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
