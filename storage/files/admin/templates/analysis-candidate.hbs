{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="Edit the instructions into a new immutable revision. The active skill and every other file are left exactly as they are."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/revisions/{{baseline}}">&larr; Baseline revision</a>{{/inline}}
{{#*inline "header_meta"}}Baseline <a class="sp-u-mono" href="/admin/analysis/revisions/{{baseline}}" title="{{baseline}}">{{shortId baseline 8}}</a> · supporting files and dependencies are inherited unchanged{{/inline}}
{{/components/page-header}}
<section class="sp-section sp-aflow-block">
<form class="sp-form-section" method="post" action="/admin/analysis/revisions/{{baseline}}/edit">
{{> components/section title="Skill instructions" note="Saving creates a candidate revision and opens the comparison. Nothing is published and no traffic moves."}}
<div class="sp-form-section__body">
<input type="hidden" name="path" value="SKILL.md">
<label class="sp-form-field"><span class="sp-form-label" for="skill-content">SKILL.md</span><textarea class="sp-field-input sp-aflow-code" id="skill-content" name="content" rows="24" required spellcheck="false">
{{content}}</textarea><span class="sp-aflow-help">Only this file changes. Line endings are normalized against the baseline.</span></label>
<label class="sp-form-field"><span class="sp-form-label" for="skill-rationale">What should improve, and why?</span><textarea class="sp-field-input" id="skill-rationale" name="rationale" rows="3" maxlength="4000" required></textarea><span class="sp-aflow-help">Recorded with the revision. It is what a reviewer reads before adopting the change.</span></label>
</div>
<footer class="sp-form-section__foot"><button class="sp-btn sp-btn--primary" type="submit">Save candidate and compare</button><span class="sp-aflow-help">Next: review the file diff, then run it as an experiment.</span></footer>
</form>
</section>
{{/inline}}{{/layout}}
