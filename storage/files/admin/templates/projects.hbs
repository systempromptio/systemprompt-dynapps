{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header title=title subtitle="Work attribution. A project says what people are building; a group says what they may reach."}}

    <section class="sp-kpi-grid" aria-label="Project totals">
        {{#each stats}}
        {{> components/kpi label=label value=value}}
        {{/each}}
    </section>

    <section aria-label="Projects">
    {{#if projects}}
    {{#> components/table}}
        <thead><tr>
            <th>Project</th>
            <th class="sp-u-numeric sp-table__cell--num">Members</th>
            <th class="sp-u-numeric sp-table__cell--num">Groups</th>
            <th class="sp-u-numeric sp-table__cell--num">Requests 30d</th>
            <th class="sp-u-numeric sp-table__cell--num">Cost 30d</th>
        </tr></thead>
        <tbody>
        {{#each projects}}
        <tr data-project-id="{{id}}">
            <td>
                <a href="{{href}}" class="sp-group-cell"><span class="sp-group-cell__name">{{name}}</span></a>
                {{#if description}}<span class="sp-group-cell__desc">{{truncate description 90}}</span>{{/if}}
            </td>
            <td class="sp-u-numeric">
                <span class="sp-group-member-count">{{member_count}}</span>
                <span class="sp-u-text-tertiary sp-u-text-xs">{{active_members_30d}} active</span>
            </td>
            <td class="sp-u-numeric">{{group_count}}</td>
            <td class="sp-u-numeric">{{formatNumber requests_30d}}</td>
            <td class="sp-u-numeric">{{formatUsd cost_30d_microdollars}}</td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{else}}
    {{> components/empty-state message="No projects yet."}}
    {{/if}}
    </section>
    {{/inline}}
{{/layout}}
