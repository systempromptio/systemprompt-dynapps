{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="A frozen matrix of cases, variants and repetitions, run against a capped shared budget. Once a matrix has settled, read its effect on production traffic on Impact."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/analysis/versions">Versions</a> <a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analysis/impact">Impact &rarr;</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid">
{{> components/kpi label="Experiments" value=totals.recorded note="most recent 100 in your scope"}}
{{> components/kpi label="In flight" value=totals.running tone="info" note="queued or running"}}
{{> components/kpi label="Completed" value=totals.completed tone="ok" note="execution finished; quality is a separate judgement"}}
{{> components/kpi label="Executions" value=totals.executions note="cases × variants × repetitions across all matrices"}}
{{> components/kpi label="Settled" value=totals.settled note=(concat totals.reserved " still reserved against caps")}}
</div>
<section class="sp-section sp-aflow-block">
{{> components/section title="Recorded experiments" count=totals.recorded note="Execution completion alone establishes neither quality nor complete accounting. Open an experiment for its per-case evidence."}}
{{#> components/table caption="Recorded experiments in your scope"}}
<thead><tr><th scope="col">Experiment</th><th scope="col">Status</th><th scope="col">Matrix</th><th scope="col" class="sp-table__cell--num">Executions</th><th scope="col" class="sp-table__cell--num">Settled</th><th scope="col" class="sp-table__cell--num">Reserved</th><th scope="col" class="sp-table__cell--num">Cap</th></tr></thead>
<tbody>
{{#each experiments}}<tr><td class="sp-table__cell--primary"><a class="sp-table__link" href="/admin/analysis/evaluations/{{id}}" title="{{id}}">{{name}}</a></td><td>{{> components/badge tone=status_tone text=status_label}}{{#if frozen}} {{> components/badge tone="warn" text="Budget frozen"}}{{/if}}</td><td class="sp-u-num" title="cases × variants × repetitions">{{cases}} × {{variants}} × {{repetitions}}</td><td class="sp-table__cell--num sp-u-num">{{executions}}</td><td class="sp-table__cell--num sp-u-num">{{settled}}</td><td class="sp-table__cell--num sp-u-num">{{reserved}}</td><td class="sp-table__cell--num sp-u-num">{{cap}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="7">{{> components/empty-state title="No experiments yet" message="Launch one from a campaign on Campaigns, or preflight a frozen matrix below."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
<div class="sp-aflow-split">
<section class="sp-section sp-aflow-block">
<form class="sp-form-section" method="post" action="/admin/analysis/evaluations/preflight">
{{> components/section title="Preflight a frozen matrix" note="Preflight is pure: it prices the complete matrix and dispatches nothing. Launching is a second, explicit step."}}
<div class="sp-form-section__body">
<div class="sp-form-grid">
<label class="sp-form-field"><span class="sp-form-label">Shared budget ID</span><input class="sp-field-input" name="budget_id" required maxlength="255" autocomplete="off"><span class="sp-aflow-help">The capped account the matrix reserves against.</span></label>
<label class="sp-form-field"><span class="sp-form-label">Idempotency key</span><input class="sp-field-input" name="idempotency_key" required maxlength="255" autocomplete="off"><span class="sp-aflow-help">Reusing a key returns the first experiment rather than launching a second.</span></label>
</div>
<label class="sp-form-field"><span class="sp-form-label">Frozen experiment specification (JSON)</span><textarea class="sp-field-input sp-aflow-code" name="spec_json" required rows="14" spellcheck="false"></textarea><span class="sp-aflow-help">Cases, variants and repetitions exactly as reviewed. The matrix is never reduced to fit a budget.</span></label>
</div>
<footer class="sp-form-section__foot"><button class="sp-btn sp-btn--primary" type="submit">Calculate complete matrix</button><span class="sp-aflow-help">Next: review the estimate, then launch.</span></footer>
</form>
</section>
<section class="sp-section sp-aflow-block sp-aflow-loop" aria-labelledby="sp-aflow-loop-title">
<h2 class="sp-section__title" id="sp-aflow-loop-title">The improvement loop</h2>
<ol class="sp-aflow-steps">
<li><strong>Observe.</strong> Find frequent skills, expensive conversations and failure patterns on Conversations.</li>
<li><strong>Baseline.</strong> Version the skill, dataset and rubric together on Versions, and agree what success means.</li>
<li><strong>Compare.</strong> Run a fixed-budget matrix over equivalent cases. Compare quality, failures, latency, tokens and cost per successful outcome.</li>
<li><strong>Review.</strong> Require human review before adopting anything, then watch new traffic on Impact for regressions.</li>
</ol>
</section>
</div>
{{/inline}}{{/layout}}
