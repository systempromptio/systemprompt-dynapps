{{#> layout title=title page=page}}{{#*inline "content"}}
{{> components/page-header title=title subtitle="Every generation of every managed resource, with the evidence that published it."}}
{{> analysis-subnav}}

<div class="sp-kpi-grid">
    {{> components/kpi label="Published resources" value=kpis.resources note="with a reviewed generation"}}
    {{> components/kpi label="Latest generation" value=kpis.latest_generation note="highest across the catalog"}}
    {{> components/kpi label="Pending withdrawals" value=kpis.pending_withdrawals tone="warn" note="awaiting a decision below"}}
    {{> components/kpi label="Failed deliveries" value=kpis.failed_deliveries tone="err" note="claims that never distributed"}}
    {{> components/kpi label="Verified receipts" value=kpis.verified_receipts tone="ok" note="full readback from the consumer"}}
</div>

<section class="sp-pub-section">
{{> components/section title="Publication history" count=kpis.resources note="One row per reviewed generation, by resource then newest generation first. A digest or revision is shown short; the full value is in its tooltip."}}
{{#if publications}}
<div class="sp-table"><div class="sp-table__scroll" tabindex="0"><table class="sp-table__el sp-pub-table" data-table="primary">
<caption class="sp-u-sr-only">Every reviewed generation of every managed resource</caption>
    <thead>
        <tr>
            <th scope="col">Resource</th>
            <th scope="col">Generation</th>
            <th scope="col">Action</th>
            <th scope="col">Revision</th>
            <th scope="col">Bundle digest</th>
            <th scope="col">Provenance</th>
            <th scope="col">Distribution</th>
            <th scope="col">Receipts</th>
            <th scope="col">Reviewed by</th>
        </tr>
    </thead>
    <tbody>
        {{#each publications}}
        <tr>
            <td><a href="{{this.resource_href}}" title="{{this.resource_full}}">{{this.resource_key}}</a></td>
            <td class="sp-u-num">{{this.generation}}</td>
            <td>{{> components/badge tone=this.action_tone text=this.action_label}}</td>
            <td>{{#if this.revision_short}}<span class="sp-u-mono" title="{{this.revision_full}}">{{this.revision_short}}</span>{{else}}&mdash;{{/if}}</td>
            <td>{{#if this.digest_short}}<span class="sp-u-mono" title="{{this.digest_full}}">{{this.digest_short}}</span>{{else}}&mdash;{{/if}}</td>
            <td>{{#if this.provenance_short}}<a class="sp-u-mono" href="{{this.provenance_href}}" title="{{this.provenance_full}}">{{this.provenance_short}}</a>{{else}}&mdash;{{/if}}</td>
            <td>{{> components/badge tone=this.distribution_tone text=this.distribution_status}}</td>
            <td class="sp-u-num">{{this.receipts}}</td>
            <td><span class="sp-u-mono" title="{{this.reviewer_full}}">{{this.reviewer_short}}</span>{{#if this.limitations}} <span class="sp-pub-note" title="{{this.limitations}}">limitations</span>{{/if}}</td>
        </tr>
        {{/each}}
    </tbody>
</table></div></div>
{{else}}
{{> components/empty-state title="No reviewed publications" message="A resource appears here once the inventory sync captures a revision and it is adopted, or once a review is recorded below."}}
{{/if}}
</section>

<details class="sp-analysis-definitions">
    <summary>How to read this page</summary>
    <p>Adoption and improvements publish automatically when the inventory sync captures a new revision; withdrawals and rollbacks are reviewed here.</p>
    <p>Approval, marketplace distribution and verified installation are separate states. Publication retains existing access policies and never grants tools or permissions.</p>
</details>

<section class="sp-pub-section">
{{> components/section title="Withdrawal proposals" count=kpis.pending_withdrawals note="Raised when the upstream source no longer carries a resource. Approving one withdraws the published generation."}}
{{#if withdrawals}}
{{#> components/table caption="Upstream withdrawal proposals awaiting or holding a decision" modifier="sp-pub-table"}}
    <thead>
        <tr>
            <th scope="col">Resource</th>
            <th scope="col">Reason</th>
            <th scope="col">Status</th>
            <th scope="col">Raised</th>
            <th scope="col">Decision</th>
        </tr>
    </thead>
    <tbody>
        {{#each withdrawals}}
        <tr>
            <td class="sp-u-mono">{{this.resource_id}}</td>
            <td>{{this.reason}}</td>
            <td>{{#if (eq this.status "pending")}}{{> components/badge tone="warn" text="Pending"}}{{else}}{{#if (eq this.status "approved")}}{{> components/badge tone="ok" text="Approved"}}{{else}}{{> components/badge tone="muted" text="Rejected"}}{{/if}}{{/if}}</td>
            <td>{{formatDate this.created_at}}</td>
            <td>
                {{#if (eq this.status "pending")}}
                {{#if @root.can_manage}}
                <form method="post" action="/admin/analysis/publications/withdrawals" class="sp-inventory-inline">
                    <input type="hidden" name="proposal_id" value="{{this.id}}">
                    <button class="sp-btn sp-btn--xs sp-btn--primary" name="decision" value="approve" type="submit">Approve</button>
                    <button class="sp-btn sp-btn--xs sp-btn--outline" name="decision" value="reject" type="submit">Reject</button>
                </form>
                {{else}}&mdash;{{/if}}
                {{else}}{{this.decided_by}}{{/if}}
            </td>
        </tr>
        {{/each}}
    </tbody>
{{/components/table}}
{{else}}
{{> components/empty-state title="No withdrawal proposals" message="One appears here when an inventory sync finds a published resource missing from its upstream source."}}
{{/if}}
</section>

<section class="sp-pub-section">
{{> components/section title="Distribution deliveries" note="One row per claim the bridge made on the publication outbox. A failed claim is retried, and its error is the reason it has not distributed."}}
{{#if distributions}}
{{#> components/table caption="Distribution claims and their outcome" modifier="sp-pub-table"}}
    <thead>
        <tr>
            <th scope="col">Publication</th>
            <th scope="col">Generation</th>
            <th scope="col">Status</th>
            <th scope="col">Claimed</th>
            <th scope="col">Error</th>
        </tr>
    </thead>
    <tbody>
        {{#each distributions}}
        <tr>
            <td><span class="sp-u-mono" title="{{this.publication_full}}">{{this.publication_short}}</span></td>
            <td class="sp-u-num">{{this.generation}}</td>
            <td>{{> components/badge tone=this.status_tone text=this.status}}</td>
            <td>{{formatDate this.claimed_at}}</td>
            <td>{{#if this.error}}{{this.error}}{{else}}&mdash;{{/if}}</td>
        </tr>
        {{/each}}
    </tbody>
{{/components/table}}
{{else}}
{{> components/empty-state title="No delivery claims" message="A row appears when a bridge claims a published generation from the distribution outbox."}}
{{/if}}
</section>

<section class="sp-pub-section">
{{> components/section title="Installation receipts" count=kpis.verified_receipts note="What a device reported back after installing a generation. Verified means the consumer read every file back and the digests matched."}}
{{#if receipts}}
{{#> components/table caption="Verified installation receipts with their retained evidence" modifier="sp-pub-table"}}
    <thead>
        <tr>
            <th scope="col">Receipt</th>
            <th scope="col">Consumer</th>
            <th scope="col">Device</th>
            <th scope="col">Host</th>
            <th scope="col">Generation</th>
            <th scope="col">Bundle digest</th>
            <th scope="col">Verified</th>
            <th scope="col">Evidence</th>
        </tr>
    </thead>
    <tbody>
        {{#each receipts}}
        <tr>
            <td><span class="sp-u-mono" title="{{this.id_full}}">{{this.id_short}}</span> <span class="sp-pub-meta" title="{{this.installation_full}}">{{this.installation_short}}</span></td>
            <td class="sp-pub-consumer" title="{{this.consumer_id}}">{{#if this.consumer_id}}{{this.consumer_id}}{{else}}&mdash;{{/if}}</td>
            <td>{{#if this.device_short}}<span class="sp-u-mono" title="{{this.device_full}}">{{this.device_short}}</span>{{else}}&mdash;{{/if}}</td>
            <td>{{#if this.host}}{{this.host}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-u-num">{{this.generation}}</td>
            <td><span class="sp-u-mono" title="{{this.digest_full}}">{{this.digest_short}}</span></td>
            <td class="sp-pub-verified" title="{{formatDate this.verified_at}}">{{> components/badge tone=this.verified_tone text=this.verified_label}} <span class="sp-pub-meta">{{relativeTime this.verified_at}}</span></td>
            <td>
                <details class="sp-pub-details">
                    <summary>Files and evidence</summary>
                    <pre class="sp-pub-evidence">{{this.installed_manifest}}</pre>
                    <pre class="sp-pub-evidence">{{this.evidence}}</pre>
                </details>
            </td>
        </tr>
        {{/each}}
    </tbody>
{{/components/table}}
{{else}}
{{> components/empty-state title="No installation receipts" message="A receipt is written when a device installs a distributed generation and reports the files it wrote back."}}
{{/if}}
</section>

{{#if can_manage}}
<details class="sp-analysis-definitions">
    <summary>Record a review manually</summary>
    <form method="post" action="/admin/analysis/publications/review" class="sp-analysis-form">
        <label class="sp-pub-field">Resource ID
            <input name="resource_id" required>
            <span class="sp-pub-field__help">The managed resource id shown against each group above.</span>
        </label>
        <label class="sp-pub-field">Revision ID
            <input name="revision_id">
            <span class="sp-pub-field__help">The captured revision to publish. Leave empty to withdraw.</span>
        </label>
        <label class="sp-pub-field">Action
            <select name="action">
                <option value="initial_adoption">Initial baseline adoption</option>
                <option value="publish_improvement">Publish evaluated improvement</option>
                <option value="withdraw">Withdraw</option>
                <option value="rollback">Rollback as new generation</option>
            </select>
            <span class="sp-pub-field__help">An improvement requires an experiment id inside the evidence below.</span>
        </label>
        <label class="sp-pub-field">Expected generation
            <input type="number" min="0" name="expected_generation" required>
            <span class="sp-pub-field__help">The generation you are publishing on top of. A mismatch is rejected.</span>
        </label>
        <label class="sp-pub-field">Idempotency key
            <input name="operation_key" required>
            <span class="sp-pub-field__help">Replaying the same key never publishes twice.</span>
        </label>
        <label class="sp-pub-field">Comparison evidence JSON
            <textarea name="comparison_evidence" required>{}</textarea>
            <span class="sp-pub-field__help">Retained verbatim. A composed_hash or bundle_content_hash key becomes the provenance link in the table above.</span>
        </label>
        <label class="sp-pub-field">Limitations
            <textarea name="limitations"></textarea>
            <span class="sp-pub-field__help">What this generation is known not to cover. Shown beside the reviewer.</span>
        </label>
        <button class="sp-btn sp-btn--primary" type="submit">Record review and publication</button>
    </form>
</details>
{{/if}}
{{/inline}}{{/layout}}
