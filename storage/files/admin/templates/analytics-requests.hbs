{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title="Inference Requests"
        subtitle="Every /v1/messages call through the gateway. Click any log row for the full chain of custody."}}

    {{> components/time-range time_range}}

    {{#if time_range.auto_widened}}
    <p class="sp-toolbar__notice sp-u-text-muted sp-u-text-xs">
        No inference requests in the last 24h — auto-widened to last {{time_range.auto_widened}}.
    </p>
    {{/if}}

    <nav class="sp-tabs" role="tablist" aria-label="Request views">
        {{#each tabs}}
        <a class="sp-tab{{#if this.is_active}} sp-tab--active{{/if}}" role="tab"
           aria-selected="{{#if this.is_active}}true{{else}}false{{/if}}"
           href="{{this.href}}">{{this.label}}{{#if this.count}}
            <span class="sp-tab-count">{{this.count}}</span>{{/if}}</a>
        {{/each}}
    </nav>

    {{> components/scope-filter scope_filter}}

    {{#if chips}}
    <ul class="sp-filter-ribbon__chips" aria-label="Active filters">
        {{#each chips}}
        <li class="sp-filter-ribbon__chip">
            <span class="sp-filter-ribbon__chip-group">{{this.group_label}}:</span>
            <span class="sp-filter-ribbon__chip-value">{{this.label}}</span>
            <a class="sp-filter-ribbon__chip-remove" href="{{this.remove_url}}"
               aria-label="Remove {{this.group_label}} filter {{this.label}}">&times;</a>
        </li>
        {{/each}}
        <li><a class="sp-filter-ribbon__clear" href="{{clear_url}}">Clear all</a></li>
    </ul>
    {{/if}}

    {{#if is_overview}}
    <section class="sp-requests-section" aria-label="Window health">
        <div class="sp-kpi-grid">
            <div class="sp-kpi">
                <span class="sp-kpi__label">Requests</span>
                <span class="sp-kpi__value">{{stats.total}}</span>
                <span class="sp-kpi__sub">{{stats.requests_per_minute}}/min</span>
            </div>
            <div class="sp-kpi">
                <span class="sp-kpi__label">p50 latency</span>
                <span class="sp-kpi__value">{{stats.p50_latency_ms}} ms</span>
                <span class="sp-kpi__sub">p95 {{stats.p95_latency_ms}} · p99 {{stats.p99_latency_ms}}</span>
            </div>
            <div class="sp-kpi">
                <span class="sp-kpi__label">Total cost</span>
                <span class="sp-kpi__value">{{stats.total_cost_display}}</span>
                <span class="sp-kpi__sub">across the window</span>
            </div>
            <div class="sp-kpi{{#if stats.error_count}} sp-kpi--danger{{/if}}">
                <span class="sp-kpi__label">Errors</span>
                <span class="sp-kpi__value">{{stats.error_count}}</span>
                <span class="sp-kpi__sub">{{stats.error_rate_pct}}% of calls</span>
            </div>
            <div class="sp-kpi{{#if stats.denied_session_count}} sp-kpi--warning{{/if}}">
                <span class="sp-kpi__label">Pre-flight denies</span>
                <span class="sp-kpi__value">{{stats.denied_session_count}}</span>
                <span class="sp-kpi__sub">{{stats.denied_session_rate_pct}}% of sessions</span>
            </div>
        </div>

        <div class="sp-requests-charts">
            <section class="sp-requests-charts__panel">
                {{> components/timeseries-chart traffic_chart}}
            </section>
            <section class="sp-requests-charts__panel">
                {{> components/timeseries-chart cost_chart}}
            </section>
        </div>

        <section class="sp-requests-charts__panel sp-requests-charts__panel--wide">
            <h3 class="sp-requests-charts__title">Latency distribution</h3>
            {{> components/latency-histogram histogram}}
        </section>
    </section>
    {{/if}}

    {{#if is_breakdown}}
    <section class="sp-requests-section" aria-label="{{breakdown.dimension_label}} breakdown">
        {{> components/breakdown-table breakdown}}
    </section>
    {{/if}}

    {{#if is_log}}
    <section class="sp-requests-section" aria-label="Request log">
        <form method="get" action="{{base_url}}" class="sp-toolbar sp-toolbar">
            <input type="hidden" name="tab" value="log">
            <input type="hidden" name="preset" value="{{time_range.preset}}">
            <input type="hidden" name="from" value="{{time_range.from}}">
            <input type="hidden" name="to" value="{{time_range.to}}">
            <div class="sp-toolbar__search">
                <input type="text" name="q" placeholder="Search user / model / trace_id / error..."
                       value="{{search_query}}" class="sp-search-input"
                       aria-label="Search requests">
            </div>
            <button type="submit" class="sp-btn sp-btn--sm">Search</button>
            {{#if has_active_filters}}
            <a href="{{clear_url}}" class="sp-btn sp-btn--sm sp-btn--outline">Clear</a>
            {{/if}}
        </form>

        {{#if has_rows}}
        {{#> components/table}}
            <thead><tr>
                <th class="sp-col-date">Time</th>
                <th>Identity</th>
                <th>Model</th>
                <th class="sp-col-status">Status</th>
                <th class="sp-table__cell--num">Tokens</th>
                <th class="sp-table__cell--num">Cost</th>
                <th class="sp-table__cell--num">Latency</th>
                <th class="sp-col-status">Denies</th>
                <th>trace_id</th>
            </tr></thead>
            <tbody>
            {{#each rows}}
            <tr data-chain-id="{{this.id}}" class="sp-audit-row" tabindex="0"
                role="button" aria-label="Open chain of custody for {{this.id}}">
                <td class="sp-col-date" title="{{this.created_at}}">{{this.created_at_local}}</td>
                <td>
                    <div class="sp-audit-identity">
                        <a href="/admin/user?id={{this.user_id}}">{{truncate this.user_label 16}}</a>
                    </div>
                </td>
                <td>
                    <code class="sp-code-inline">{{this.model}}</code>
                    <span class="sp-u-text-muted sp-u-text-xs">{{this.provider}}</span>
                </td>
                <td class="sp-col-status">
                    {{#if this.is_error}}
                      <span class="sp-badge sp-badge--err" title="{{this.error_message}}">{{this.status}}</span>
                    {{else}}
                      <span class="sp-badge sp-badge--ok">{{this.status}}</span>
                    {{/if}}
                </td>
                <td class="sp-table__cell--num">
                    {{#if this.input_tokens}}{{this.input_tokens}}{{else}}—{{/if}}
                    /
                    {{#if this.output_tokens}}{{this.output_tokens}}{{else}}—{{/if}}
                </td>
                <td class="sp-table__cell--num">{{this.cost_display}}</td>
                <td class="sp-table__cell--num">{{#if this.latency_ms}}{{this.latency_ms}} ms{{else}}—{{/if}}</td>
                <td class="sp-col-status">
                    {{#if this.is_denied_preflight}}
                      <span class="sp-badge sp-badge--err">{{this.deny_count}}</span>
                    {{else}}
                      {{#if this.tool_call_count}}
                        <span class="sp-u-text-muted">{{this.tool_call_count}} tool</span>
                      {{else}}—{{/if}}
                    {{/if}}
                </td>
                <td>
                    {{#if this.trace_id}}
                        <code class="sp-code-inline">{{truncate this.trace_id 8}}</code>
                    {{else}}—{{/if}}
                </td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state
            message="No inference requests match. Widen the time range, clear the filters, or run a demo to populate data."}}
        {{/if}}
    </section>
    {{/if}}

    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-entities.js"></script>
    {{/inline}}
{{/layout}}
