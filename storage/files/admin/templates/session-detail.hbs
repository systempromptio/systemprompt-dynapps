{{#> layout title=title page=page}}
    {{#*inline "content"}}
    <a href="{{back_url}}" class="sp-back-link">&larr; All sessions</a>

    <nav class="sp-breadcrumbs" aria-label="Breadcrumb">
        <a href="/admin/sessions">Sessions</a>
        <span class="sp-breadcrumbs__sep" aria-hidden="true">›</span>
        <span aria-current="page">Session detail</span>
    </nav>
    {{!-- The AI-written title says what the session was actually about, so it
          leads the page rather than sitting in a panel below the fold. --}}
    {{#if header.ai_title}}
    {{> components/page-header title=title subtitle=header.ai_title}}
    {{else}}
    {{> components/page-header
        title=title
        subtitle="One interactive session: every context, trace, and AI request it produced."}}
    {{/if}}

    <section class="sp-trace-detail__summary" aria-label="Session summary">
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Session</span>
        <code class="sp-code-inline" title="{{header.session_id}}">{{header.session_id}}</code>
      </div>
      {{#if header.user_url}}
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">User</span>
        <a href="{{header.user_url}}">{{#if header.display_name}}{{header.display_name}}{{else}}{{header.user_id}}{{/if}}</a>
      </div>
      {{/if}}
      {{#if header.groups_display}}
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Dept</span>
        <span>{{header.groups_display}}</span>
      </div>
      {{/if}}
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Started</span>
        {{!-- The title attribute must be guarded too: strict mode rejects a null
              value inside an attribute just as it does in body text. --}}
        <span {{#if header.started_at}}title="{{header.started_at}}"{{/if}}>{{#if header.started_at_local}}{{header.started_at_local}}{{else}}&mdash;{{/if}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Last activity</span>
        <span {{#if header.last_activity_at}}title="{{header.last_activity_at}}"{{/if}}>{{#if header.last_activity_at_local}}{{header.last_activity_at_local}}{{else}}&mdash;{{/if}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Duration</span>
        <span>{{header.duration_display}}</span>
      </div>
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Status</span>
        <span>{{header.status}}</span>
      </div>
      {{#if header.model}}
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Model</span>
        <span>{{header.model}}</span>
      </div>
      {{/if}}
      {{#if header.plugin_id}}
      <div class="sp-trace-detail__field">
        <span class="sp-trace-detail__label">Plugin</span>
        <span>{{header.plugin_id}}</span>
      </div>
      {{/if}}
    </section>

    <section class="sp-kpi-grid" aria-label="Session KPIs">
      <div class="sp-kpi">
        <span class="sp-kpi__label">Requests</span>
        <span class="sp-kpi__value">{{kpis.request_count}}</span>
      </div>
      <div class="sp-kpi">
        <span class="sp-kpi__label">Contexts</span>
        <span class="sp-kpi__value">{{kpis.context_count}}</span>
      </div>
      <div class="sp-kpi">
        <span class="sp-kpi__label">Traces</span>
        <span class="sp-kpi__value">{{kpis.trace_count}}</span>
      </div>
      <div class="sp-kpi{{#if kpis.error_count}} sp-kpi--danger{{/if}}">
        <span class="sp-kpi__label">Errors</span>
        <span class="sp-kpi__value">{{kpis.error_count}}</span>
      </div>
      <div class="sp-kpi">
        <span class="sp-kpi__label">Tokens</span>
        <span class="sp-kpi__value">{{kpis.total_tokens}}</span>
        <span class="sp-kpi__sub">{{kpis.total_input_tokens}} in / {{kpis.total_output_tokens}} out</span>
      </div>
      <div class="sp-kpi">
        <span class="sp-kpi__label">Cost</span>
        <span class="sp-kpi__value">{{kpis.total_cost_display}}</span>
      </div>
    </section>

    <section class="sp-overview-pane">
      <h3 class="sp-section__title">Contexts in this session ({{kpis.context_count}})</h3>
      {{#if has_contexts}}
      {{#> components/table}}
        <thead><tr>
          <th>Context</th><th>Name</th><th>Requests</th><th>Errors</th><th>Last request</th><th>Model</th><th>Tokens</th><th>Cost</th>
        </tr></thead>
        <tbody>
        {{#each contexts}}
          <tr>
            <td><a href="{{context_url}}" class="sp-code-inline" title="{{context_id}}">{{context_id_short}}</a></td>
            <td>{{name}}</td>
            <td>{{request_count}}</td>
            <td>{{#if error_count}}<span class="sp-u-text-danger">{{error_count}}</span>{{else}}0{{/if}}</td>
            <td>{{#if last_request_at_local}}{{last_request_at_local}}{{else}}—{{/if}}</td>
            <td>{{#if model}}{{model}}{{else}}—{{/if}}</td>
            <td title="{{token_display}}">{{total_tokens}}</td>
            <td>{{cost_display}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state message="No contexts recorded for this session."}}
      {{/if}}
    </section>

    <section class="sp-overview-pane">
      <h3 class="sp-section__title">Traces in this session ({{kpis.trace_count}})</h3>
      {{#if has_traces}}
      {{#> components/table}}
        <thead><tr>
          <th>Trace</th><th>Started</th><th>Duration</th><th>Requests</th><th>Errors</th>
        </tr></thead>
        <tbody>
        {{#each traces}}
          <tr>
            <td><a href="{{trace_url}}" class="sp-code-inline" title="{{trace_id}}">{{trace_id_short}}</a></td>
            <td>{{#if started_at_local}}{{started_at_local}}{{else}}—{{/if}}</td>
            <td>{{duration_display}}</td>
            <td>{{request_count}}</td>
            <td>{{#if error_count}}<span class="sp-u-text-danger">{{error_count}}</span>{{else}}0{{/if}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state message="No traces recorded for this session."}}
      {{/if}}
    </section>

    <section class="sp-overview-pane">
      <h3 class="sp-section__title">Requests in this session ({{kpis.request_count}})</h3>
      {{#if has_requests}}
      {{#> components/table}}
        <thead><tr>
          <th>Request</th><th>Created</th><th>Context</th><th>Trace</th><th>Model</th><th>Status</th><th>Latency</th><th>Cost</th>
        </tr></thead>
        <tbody>
        {{#each requests}}
          <tr>
            <td><a href="{{request_url}}" class="sp-code-inline" title="{{id}}">{{id_short}}</a></td>
            <td>{{created_at_local}}</td>
            <td>{{#if context_url}}<a href="{{context_url}}" class="sp-code-inline">{{context_id_short}}</a>{{else}}—{{/if}}</td>
            <td>{{#if trace_url}}<a href="{{trace_url}}" class="sp-code-inline">{{trace_id_short}}</a>{{else}}—{{/if}}</td>
            <td>{{model}}</td>
            <td>{{#if is_error}}<span class="sp-u-text-danger">{{status}}</span>{{else}}{{status}}{{/if}}</td>
            <td>{{latency_display}}</td>
            <td>{{cost_display}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state message="No requests recorded for this session."}}
      {{/if}}
    </section>

    {{/inline}}
{{/layout}}
