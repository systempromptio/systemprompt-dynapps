{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    {{#> components/page-header title=title
        subtitle="One interactive session: every context, trace, and AI request it produced, and how well it went."}}
      {{#*inline "header_meta"}}
        <code class="sp-code-inline" title="{{header.session_id}}">{{header.session_id}}</code>
        {{#if header.user_url}}
          · <a href="{{header.user_url}}">{{#if header.display_name}}{{header.display_name}}{{else}}{{header.user_id}}{{/if}}</a>
        {{/if}}
        {{#if header.groups_display}} · {{header.groups_display}}{{/if}}
        · {{header.status}}
        {{#if header.model}} · {{header.model}}{{/if}}
        {{#if header.plugin_id}} · {{header.plugin_id}}{{/if}}
        {{#if header.ai_title}} · {{header.ai_title}}{{/if}}
      {{/inline}}
      {{#*inline "header_actions"}}
        {{> components/export-document document_export}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{back_url}}">All sessions</a>
      {{/inline}}
    {{/components/page-header}}

    <section class="sp-kpi-grid" aria-label="Session KPIs">
      {{> components/kpi label="Requests" value=kpis.request_count note="gateway calls"}}
      {{> components/kpi label="Contexts" value=kpis.context_count note="conversations"}}
      {{> components/kpi label="Traces" value=kpis.trace_count note="spans grouped"}}
      {{> components/kpi label="Errors" value=kpis.error_count tone="err" note="failed requests"}}
      {{> components/kpi label="Tool calls" value=kpis.tool_call_count note=(concat kpis.executed_count " executed") hint="Calls the model asked for; executed is how many a hook, the proxy or an in-process server saw run"}}
      {{> components/kpi label="Artifacts" value=kpis.artifact_count href=kpis.artifacts_url note="stored results" hint="Tool results ingested as artifacts for this session"}}
      {{> components/kpi label="Tokens" value=kpis.tokens_display note=kpis.tokens_note}}
      {{> components/kpi label="Cost" value=kpis.total_cost_display note="billed"}}
      {{#if header.started_at_local}}
        {{> components/kpi label="Started" value=header.started_at_local note=header.duration_display}}
      {{else}}
        {{> components/kpi label="Started" value="—" note=header.duration_display}}
      {{/if}}
    </section>

    <section aria-labelledby="contexts-title">
      {{> components/section title="Contexts" count=kpis.context_count note="Conversations this session opened."}}
      {{#if has_contexts}}
      {{#> components/table caption="Contexts in this session"}}
        <thead><tr>
          <th>Context</th><th>Name</th><th class="sp-table__cell--num">Reqs</th>
          <th class="sp-table__cell--num">Errors</th><th class="sp-col-date">Last request</th>
          <th class="sp-col-model">Model</th><th class="sp-table__cell--num">Tokens</th>
          <th class="sp-table__cell--num">Cost</th>
        </tr></thead>
        <tbody>
        {{#each contexts}}
          <tr>
            <td><a href="{{context_url}}" title="{{context_id}}"><code class="sp-code-inline">{{context_id_short}}</code></a></td>
            <td class="sp-u-truncate">{{name}}</td>
            <td class="sp-table__cell--num">{{request_count}}</td>
            <td class="sp-table__cell--num">{{#if error_count}}<span class="sp-badge sp-badge--err">{{error_count}}</span>{{else}}0{{/if}}</td>
            <td class="sp-col-date sp-table__cell--date">{{#if last_request_at_local}}{{last_request_at_local}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-col-model sp-table__cell--mono">{{#if model}}{{model}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-table__cell--num" title="{{token_display}}">{{total_tokens}}</td>
            <td class="sp-table__cell--num sp-u-mono">{{cost_display}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state heading="No contexts" message="This session recorded no conversation contexts."}}
      {{/if}}
    </section>

    <section aria-labelledby="traces-title">
      {{> components/section title="Traces" count=kpis.trace_count note="Spans grouped by trace id."}}
      {{#if has_traces}}
      {{#> components/table caption="Traces in this session"}}
        <thead><tr>
          <th>Trace</th><th class="sp-col-date">Started</th>
          <th class="sp-table__cell--num">Duration</th>
          <th class="sp-table__cell--num">Reqs</th><th class="sp-table__cell--num">Errors</th>
        </tr></thead>
        <tbody>
        {{#each traces}}
          <tr>
            <td><a href="{{trace_url}}" title="{{trace_id}}"><code class="sp-code-inline">{{trace_id_short}}</code></a></td>
            <td class="sp-col-date sp-table__cell--date">{{#if started_at_local}}{{started_at_local}}{{else}}&mdash;{{/if}}</td>
            <td class="sp-table__cell--num">{{duration_display}}</td>
            <td class="sp-table__cell--num">{{request_count}}</td>
            <td class="sp-table__cell--num">{{#if error_count}}<span class="sp-badge sp-badge--err">{{error_count}}</span>{{else}}0{{/if}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state heading="No traces" message="This session produced no governance, tool, or gateway spans."}}
      {{/if}}
    </section>

    <section aria-labelledby="requests-title">
      {{> components/section title="Requests" count=kpis.request_count note="Every gateway call this session issued."}}
      {{#if has_requests}}
      {{#> components/table caption="Requests in this session"}}
        <thead><tr>
          <th>Request</th><th class="sp-col-date">Created</th><th>Context</th><th>Trace</th>
          <th class="sp-col-model">Model</th><th class="sp-col-status">Status</th>
          <th class="sp-table__cell--num">Latency</th><th class="sp-table__cell--num">Cost</th>
        </tr></thead>
        <tbody>
        {{#each requests}}
          <tr>
            <td><a href="{{request_url}}" title="{{id}}"><code class="sp-code-inline">{{id_short}}</code></a></td>
            <td class="sp-col-date sp-table__cell--date">{{created_at_local}}</td>
            <td>{{#if context_url}}<a href="{{context_url}}"><code class="sp-code-inline">{{context_id_short}}</code></a>{{else}}&mdash;{{/if}}</td>
            <td>{{#if trace_url}}<a href="{{trace_url}}"><code class="sp-code-inline">{{trace_id_short}}</code></a>{{else}}&mdash;{{/if}}</td>
            <td class="sp-col-model sp-table__cell--mono">{{model}}</td>
            <td class="sp-col-status">
              {{#if is_rejected}}<span class="sp-badge sp-badge--err">REJECTED</span>
              {{else if is_error}}<span class="sp-badge sp-badge--warn">{{status}}</span>
              {{else}}<span class="sp-badge sp-badge--ok">{{status}}</span>{{/if}}
            </td>
            <td class="sp-table__cell--num">{{latency_display}}</td>
            <td class="sp-table__cell--num sp-u-mono">{{cost_display}}</td>
          </tr>
        {{/each}}
        </tbody>
      {{/components/table}}
      {{else}}
      {{> components/empty-state heading="No requests" message="This session issued no gateway calls."}}
      {{/if}}
    </section>
    {{/inline}}
{{/layout}}
