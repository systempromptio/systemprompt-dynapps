{{#> layout title=title page=page}}
    {{#*inline "content"}}
    {{> components/page-header
        title=label
        subtitle="One person's usage, cost, model mix, and code activity."}}

    <p class="sp-analytics-note">{{email}} · roles: {{roles_display}}</p>

    <p class="sp-analytics-note">
        <a href="/admin/analytics?tab=usage">&larr; All users</a>
        ·
        <a href="{{dashboard_url}}">Dashboard scoped to this user</a>
        ·
        <a href="{{log_url}}">Request log</a>
        ·
        <a href="{{manage_url}}">Manage account</a>
    </p>

    {{> components/time-range time_range}}

    <section aria-label="Usage summary">
        <div class="sp-kpi-grid">
            <div class="sp-kpi">
                <span class="sp-kpi__label">Requests</span>
                <span class="sp-kpi__value">{{kpis.requests}}</span>
                <span class="sp-kpi__delta" data-direction="{{kpis.requests_delta.direction}}" data-tone="{{kpis.requests_delta.tone}}">{{kpis.requests_delta.display}} vs prior period</span>
                <span class="sp-kpi__sub">{{kpis.error_display}} · {{kpis.requests_per_day_display}}/day</span>
            </div>
            <div class="sp-kpi">
                <span class="sp-kpi__label">Spend</span>
                <span class="sp-kpi__value">{{kpis.cost_display}}</span>
                <span class="sp-kpi__delta" data-direction="{{kpis.cost_delta.direction}}" data-tone="{{kpis.cost_delta.tone}}">{{kpis.cost_delta.display}} vs prior period</span>
                <span class="sp-kpi__sub">across the window</span>
            </div>
            <div class="sp-kpi">
                <span class="sp-kpi__label">Tokens</span>
                <span class="sp-kpi__value">{{kpis.tokens_display}}</span>
                <span class="sp-kpi__delta" data-direction="{{kpis.tokens_delta.direction}}" data-tone="{{kpis.tokens_delta.tone}}">{{kpis.tokens_delta.display}} vs prior period</span>
                <span class="sp-kpi__sub">input + output</span>
            </div>
            <div class="sp-kpi">
                <span class="sp-kpi__label">Permission grant rate</span>
                {{#if kpis.grant_has_data}}
                <span class="sp-kpi__value">{{kpis.grant_rate_display}}</span>
                <span class="sp-kpi__sub">permission requests followed by the tool running</span>
                {{else}}
                <span class="sp-kpi__value">&mdash;</span>
                <span class="sp-kpi__sub">no permission requests in this window</span>
                {{/if}}
            </div>
        </div>

        <div class="sp-analytics-grid">
            <section class="sp-analytics-grid__panel">
                {{> components/svg-line-chart trend_chart}}
            </section>
            <section class="sp-analytics-grid__panel">
                {{> components/pie-chart model_pie}}
            </section>
        </div>

        <div class="sp-analytics-grid">
            <section class="sp-analytics-grid__panel">
                {{> components/svg-line-chart code_chart}}
            </section>
        </div>

        <div class="sp-code-frames">
            <div class="sp-code-frame">
                <span class="sp-code-frame__title">AI lines added</span>
                <span class="sp-code-frame__value">{{code_totals.loc_added_ai_display}}</span>
                <span class="sp-code-frame__caption">Applied through Edit/Write tool calls (hook-observed).</span>
            </div>
            <div class="sp-code-frame">
                <span class="sp-code-frame__title">AI lines removed</span>
                <span class="sp-code-frame__value">{{code_totals.loc_removed_ai_display}}</span>
                <span class="sp-code-frame__caption">Replaced through Edit tool calls (hook-observed).</span>
            </div>
            <div class="sp-code-frame">
                <span class="sp-code-frame__title">Committed lines</span>
                <span class="sp-code-frame__value">{{code_totals.committed_display}}</span>
                <span class="sp-code-frame__caption">Git diff totals — AI and manual together. A different frame from AI lines; not comparable line-for-line.</span>
            </div>
            <div class="sp-code-frame">
                <span class="sp-code-frame__title">Commits</span>
                <span class="sp-code-frame__value">{{code_totals.commits_display}}</span>
                <span class="sp-code-frame__caption">Observed via Claude Code Bash calls only.</span>
            </div>
            <div class="sp-code-frame">
                <span class="sp-code-frame__title">AI edit operations</span>
                <span class="sp-code-frame__value">{{code_totals.edit_operations_display}}</span>
                <span class="sp-code-frame__caption">Applied edits — Claude Code emits no accept/reject signal, so there is no acceptance rate to report.</span>
            </div>
        </div>
    </section>

    <section aria-label="Daily records">
        <h2 class="sp-section__title">Daily records</h2>
        <p class="sp-section__sub">From the usage rollup — updated hourly, so today's row may lag.</p>
        {{#if has_daily_rows}}
        {{#> components/table}}
            <thead><tr>
                <th class="sp-col-date">Date</th>
                <th class="sp-table__cell--num">Sessions</th>
                <th class="sp-table__cell--num">Prompts</th>
                <th class="sp-table__cell--num">Tool uses</th>
                <th class="sp-table__cell--num">Requests</th>
                <th class="sp-table__cell--num">AI lines</th>
                <th class="sp-table__cell--num">Commits</th>
                <th class="sp-table__cell--num">Cost</th>
            </tr></thead>
            <tbody>
            {{#each daily_rows}}
            <tr>
                <td class="sp-col-date">{{this.date_display}}</td>
                <td class="sp-table__cell--num">{{this.sessions}}</td>
                <td class="sp-table__cell--num">{{this.prompts}}</td>
                <td class="sp-table__cell--num">{{this.tool_uses}}</td>
                <td class="sp-table__cell--num">{{this.requests}}</td>
                <td class="sp-table__cell--num">{{this.loc_added_display}}</td>
                <td class="sp-table__cell--num">{{this.commits}}</td>
                <td class="sp-table__cell--num">{{this.cost_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state
            message="No rollup rows for this user in this window yet."}}
        {{/if}}
    </section>

    <section aria-label="Session cost history">
        <h2 class="sp-section__title">Recent sessions</h2>
        <p class="sp-section__sub">Client-reported statusline snapshots: cost, context window, and cache reads per session.</p>
        {{#if has_session_rows}}
        {{#> components/table}}
            <thead><tr>
                <th>Session</th>
                <th>Model</th>
                <th class="sp-table__cell--num">Cost</th>
                <th class="sp-table__cell--num">Context</th>
                <th class="sp-table__cell--num">Cache read</th>
                <th class="sp-table__cell--num">Tokens</th>
                <th class="sp-col-date">Updated</th>
            </tr></thead>
            <tbody>
            {{#each session_rows}}
            <tr>
                <td><a href="{{this.session_url}}">{{this.session_id}}</a></td>
                <td>{{this.model}}</td>
                <td class="sp-table__cell--num">{{this.cost_display}}</td>
                <td class="sp-table__cell--num">{{this.context_display}}</td>
                <td class="sp-table__cell--num">{{this.cache_read_display}}</td>
                <td class="sp-table__cell--num">{{this.tokens_display}}</td>
                <td class="sp-col-date">{{this.updated_display}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{> components/empty-state
            message="No client-reported session snapshots for this user yet."}}
        {{/if}}
    </section>
    {{/inline}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "scripts"}}{{/inline}}
{{/layout}}
