{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/back-button href="/admin/mcp" label="MCP servers"}}

    <header class="sp-page-header">
        <div class="sp-page-header__title-group">
            <h1 class="sp-page-header__title"><code class="sp-code-inline">{{id}}</code>
                {{#if enabled}}<span class="sp-badge sp-badge--ok">enabled</span>{{else}}<span class="sp-badge sp-badge--muted">disabled</span>{{/if}}
            </h1>
            {{#if description}}<p class="sp-page-header__subtitle">{{description}}</p>{{/if}}
        </div>
        <div class="sp-page-header__actions">
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{matrix_url}}">Access matrix →</a>
        </div>
    </header>

    <div class="sp-catalog-meta-bar">
        <span class="sp-chip sp-chip--muted">{{server_type}}</span>
        {{#if oauth_required}}<span class="sp-badge sp-badge--warn">OAuth required</span>{{/if}}
        <span class="sp-chip sp-chip--muted">{{assignment_count}} assignment{{#unless (eq assignment_count 1)}}s{{/unless}}</span>
        <code class="sp-code-inline">{{source_path}}</code>
    </div>

    <div class="sp-catalog-detail-grid">
        <section class="sp-catalog-rel-section">
            <h2 class="sp-catalog-rel-section__title">Endpoint</h2>
            <dl class="sp-kv-list">
                <div class="sp-kv-row"><dt>Endpoint</dt><dd><code class="sp-code-inline">{{#if endpoint}}{{endpoint}}{{else}}—{{/if}}</code></dd></div>
                <div class="sp-kv-row"><dt>Port</dt><dd>{{#if port}}{{port}}{{else}}—{{/if}}</dd></div>
                {{#if oauth_required}}
                <div class="sp-kv-row"><dt>Audience</dt><dd><code class="sp-code-inline">{{oauth_audience}}</code></dd></div>
                <div class="sp-kv-row"><dt>Scopes</dt><dd>{{#each oauth_scopes}}<span class="sp-chip sp-chip--tag">{{this}}</span>{{else}}—{{/each}}</dd></div>
                {{/if}}
            </dl>
        </section>

        <section class="sp-catalog-rel-section">
            <h2 class="sp-catalog-rel-section__title">Included by plugins <span class="sp-count-pill">{{included_by_count}}</span></h2>
            {{#if included_by_count}}
            <ul class="sp-rel-list">
                {{#each included_by}}
                <li><a class="sp-rel-link" href="{{url}}"><span class="sp-rel-link__name">{{name}}</span><code class="sp-code-inline">{{id}}</code></a></li>
                {{/each}}
            </ul>
            {{else}}<p class="sp-u-text-tertiary">Not bundled in any plugin. Assign directly through the access matrix.</p>{{/if}}
        </section>
    </div>
    {{/inline}}
{{/layout}}
