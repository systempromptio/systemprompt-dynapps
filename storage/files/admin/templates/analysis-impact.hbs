{{#> layout title=title page=page}}{{#*inline "content"}}
{{#> components/page-header title=title subtitle="What a published revision did to real traffic, grouped by skill so revisions of the same skill sit side by side. When a revision holds up here, publish the next one."}}
{{#*inline "header_actions"}}<a class="sp-btn sp-btn--sm sp-btn--primary" href="/admin/analysis/publications">Publication &rarr;</a>{{/inline}}
{{/components/page-header}}
{{> analysis-subnav}}
<div class="sp-kpi-grid sp-kpi-grid--compact">
{{> components/kpi label="Invocations" value=summary.invocations note="in the selected cohort"}}
{{> components/kpi label="Attributed" value=summary.attributed note=attributed_share}}
{{> components/kpi label="Distinct requests" value=summary.distinct_requests note="deduplicated by request ID"}}
{{> components/kpi label="Accounted" value=summary.accounted_requests note=accounted_share}}
{{> components/kpi label="Request spend" value=deduplicated_cost note="platform requests only; tool charges are separate"}}
</div>
{{#> components/toolbar}}
{{#*inline "toolbar_filters"}}
<form class="sp-toolbar__filter sp-aflow-filter" method="get" action="/admin/analysis/impact">
{{#if query.start}}<input type="hidden" name="start" value="{{query.start}}">{{/if}}{{#if query.end}}<input type="hidden" name="end" value="{{query.end}}">{{/if}}
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="im-skill">Skill</label><input class="sp-search-input" type="text" id="im-skill" name="skill" value="{{query.skill}}" maxlength="255"></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="im-revision">Revision</label><input class="sp-search-input" type="text" id="im-revision" name="revision" value="{{query.revision}}" maxlength="255"></div>
<div class="sp-toolbar__field"><label class="sp-toolbar__field-label" for="im-traffic">Traffic class</label><select class="sp-search-input" id="im-traffic" name="traffic_class"><option value="">All</option><option value="production"{{#if (eq query.traffic_class "production")}} selected{{/if}}>production</option><option value="fixture"{{#if (eq query.traffic_class "fixture")}} selected{{/if}}>fixture</option></select></div>
<button class="sp-btn sp-btn--sm sp-btn--primary" type="submit">Apply cohort</button>
</form>
{{/inline}}
{{/components/toolbar}}
{{> components/section title="Cohorts by skill" count=cohort_pagination.total_rows note="One row per day, revision and traffic class. Fifty rows a page, ordered by skill so a skill's revisions stay together."}}
{{#each cohorts}}
<section class="sp-section sp-aflow-block">
{{> components/section title=skill note=(concat invocations " invocations and " requests " related requests across the days and revisions below")}}
{{#> components/table caption="Daily cohorts for this skill"}}
<thead><tr><th scope="col" class="sp-table__cell--date">Day</th><th scope="col">Revision</th><th scope="col" class="sp-table__cell--num">Gen</th><th scope="col">Traffic</th><th scope="col" class="sp-table__cell--num">Invocations</th><th scope="col" class="sp-table__cell--num">Attributed</th><th scope="col" class="sp-table__cell--num">Requests</th><th scope="col" class="sp-table__cell--num">Failures</th><th scope="col" class="sp-table__cell--num">Quality</th><th scope="col" class="sp-table__cell--num">Latency</th><th scope="col" class="sp-table__cell--num">Cost</th></tr></thead>
<tbody>
{{#each rows}}<tr><td class="sp-table__cell--primary sp-table__cell--date">{{row.cohort_day}}</td><td class="sp-u-mono"{{#if row.revision_id}} title="{{row.revision_id}}"{{/if}}>{{#if revision}}{{revision}}{{else}}<span class="sp-u-text-tertiary">unknown</span>{{/if}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.publication_generation}}{{row.publication_generation}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td><td>{{> components/badge tone="muted" text=row.traffic_class}}</td><td class="sp-table__cell--num sp-u-num">{{row.invocations}}</td><td class="sp-table__cell--num sp-u-num">{{row.attributed}}</td><td class="sp-table__cell--num sp-u-num" title="{{row.accounted_requests}} accounted · {{formatNumber row.tokens}} tokens">{{row.requests}}</td><td class="sp-table__cell--num sp-u-num">{{#if row.failures}}<span class="sp-u-text-danger">{{row.failures}}</span>{{else}}0{{/if}}</td><td class="sp-table__cell--num sp-u-num" title="{{row.successful_sessions}} of {{row.assessed_sessions}} assessed sessions succeeded">{{quality}}</td><td class="sp-table__cell--num sp-u-num">{{latency}}</td><td class="sp-table__cell--num sp-u-num">{{cost}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
{{else}}
{{> components/empty-state title="No invocations in this cohort" message="No skill was invoked in this window under these filters. Widen the cohort, or publish a revision on Publication so its traffic can be attributed."}}
{{/each}}
<div class="sp-table sp-aflow-pager">{{> components/pagination cohort_pagination}}</div>
<section class="sp-section sp-aflow-block">
{{> components/section title="Invocation evidence" count=evidence_pagination.total_rows note="Each invocation linked to its conversation and the requests and tool calls charged against it. Fifty a page, newest first."}}
{{#> components/table caption="Invocation, conversation and request evidence" pagination=evidence_pagination}}
<thead><tr><th scope="col">Invocation</th><th scope="col">Skill</th><th scope="col">Revision</th><th scope="col">Attribution</th><th scope="col">Conversation</th><th scope="col" class="sp-table__cell--num">Requests</th><th scope="col" class="sp-table__cell--num">Tools</th></tr></thead>
<tbody>
{{#each invocations}}<tr><td class="sp-table__cell--primary sp-u-mono" title="{{row.invocation_id}}">{{shortId row.invocation_id 8}}</td><td class="sp-aflow-cell-id" title="{{row.skill}}">{{row.skill}}</td><td class="sp-u-mono"{{#if row.revision_id}} title="{{row.revision_id}}"{{/if}}>{{#if revision}}{{revision}}{{else}}<span class="sp-u-text-tertiary">unknown</span>{{/if}}</td><td>{{> components/badge tone=attribution_tone text=row.attribution_status}} {{> components/badge tone="muted" text=row.traffic_class}}</td><td><a class="sp-table__link sp-u-mono" href="/admin/sessions/{{row.session_id}}" title="{{row.session_id}}">{{shortId row.session_id 8}}</a></td><td class="sp-table__cell--num sp-u-num"{{#if requests}} title="{{requests}}"{{/if}}>{{row.accounted_count}} / {{row.request_count}}</td><td class="sp-table__cell--num sp-u-num">{{row.tool_count}}</td></tr>
{{else}}<tr class="sp-table__empty"><td colspan="7">{{> components/empty-state title="No invocation evidence" message="No invocation was recorded in this window under these filters."}}</td></tr>{{/each}}
</tbody>
{{/components/table}}
</section>
{{> components/notice tone="info" title="Association, not causation" message="Before and after cohorts are associations. Related conversation cost overlaps when several skills run in one conversation, so cohort costs must never be summed across skills."}}
{{/inline}}{{/layout}}
