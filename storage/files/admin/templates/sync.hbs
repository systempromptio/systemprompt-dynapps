{{#> layout title=title page=page}}
    {{#*inline "head_extra"}}{{/inline}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}
    {{#> components/page-header title=title subtitle="Where declarations come from, what they project into, and the difference. Code is what the instance is expected to hold; the database is what is enforced. Nothing here happens on its own — choose a direction."}}
        {{#*inline "header_actions"}}
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{docs_url}}" target="_blank" rel="noopener noreferrer">How sync works</a>
        <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{access_control_url}}">Access control</a>
        {{/inline}}
        {{#*inline "header_meta"}}
        <span>Release <strong>v{{sources.base.version}}</strong></span>
        {{#if base_tree_hash}}<span>Tree <span class="sp-sync-hash" title="{{base_tree_hash.full}}">{{base_tree_hash.short}}</span></span>{{/if}}
        {{#if composed_hash}}<span>Composition <span class="sp-sync-hash" title="{{composed_hash.full}}">{{composed_hash.short}}</span></span>{{/if}}
        <span>Provenance <strong>{{sources.base.provenance}}</strong></span>
        {{/inline}}
    {{/components/page-header}}

    {{#if sources_unreadable}}
    {{> components/notice tone="err" title="Sources could not be read" message=sources_unreadable}}
    {{/if}}
    {{#if sources.base.provenance_error}}
    {{> components/notice tone="warn" title="Serving a fallback tree" message=sources.base.provenance_error}}
    {{/if}}
    {{#if sources.restart_pending}}
    {{> components/notice tone="warn" title="Reconcile pending" message="The composition was recomposed but has not been projected into the authz tables. Press Import to reconcile it in place — no restart is involved."}}
    {{/if}}

    {{#> components/section title="Sources" note="Every place a declaration comes from, with the hash it declares. A digest is code: the instance never rewrites its own profile."}}
        {{#*inline "section_actions"}}
        {{#if can_write}}<button type="button" class="sp-btn sp-btn--sm sp-btn--secondary" data-action="refresh-sources">Import sources</button>{{/if}}
        {{/inline}}
    {{/components/section}}

    {{#> components/table caption="Sources and their hashes" modifier="sp-sync-sources"}}
        <thead><tr>
            <th>Source</th>
            <th>Pinned</th>
            <th>Active</th>
            <th>Version</th>
            <th>Content hash</th>
            <th>Fetched</th>
            <th>Owns</th>
            <th>State</th>
        </tr></thead>
        <tbody>
        <tr data-source="base">
            <td><strong>base</strong> <span class="sp-u-text-tertiary">this repository</span><br><span class="sp-u-mono sp-u-text-tertiary">{{sources.base.tree_path}}</span></td>
            <td class="sp-u-text-tertiary">release v{{sources.base.version}}</td>
            <td class="sp-u-text-tertiary">{{sources.base.provenance}}</td>
            <td class="sp-u-mono">{{sources.base.version}}</td>
            <td>{{#if base_tree_hash}}<span class="sp-sync-hash" title="{{base_tree_hash.full}}">{{base_tree_hash.short}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td class="sp-u-text-tertiary">baked into the image</td>
            <td class="sp-sync-sources__owns">everything not owned by a bundle, every entitlement</td>
            <td>{{> components/badge tone="ok" text="code"}}</td>
        </tr>
        {{#each sources.bundles}}
        <tr data-source="{{name}}">
            <td><strong>{{name}}</strong> <span class="sp-u-text-tertiary">{{transport}}</span><br><span class="sp-u-mono sp-u-text-tertiary">{{reference}}</span></td>
            <td>{{#if pinned_digest}}<span class="sp-sync-hash" title="{{pinned_digest}}">{{truncate pinned_digest 19}}</span>{{else}}<span class="sp-u-text-tertiary">tag</span>{{/if}}</td>
            <td>{{#if active_digest}}<span class="sp-sync-hash" title="{{active_digest}}">{{truncate active_digest 19}}</span>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td class="sp-u-mono">{{default version "—"}}</td>
            <td>{{#if content_hash}}<span class="sp-sync-hash" title="{{content_hash}}">{{truncate content_hash 12}}</span><br><a class="sp-sync-sources__versions" href="/admin/analysis/versions?hash={{content_hash}}">Versions</a>{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
            <td>{{#if fetched_at}}{{relativeTime fetched_at}}{{else}}<span class="sp-u-text-tertiary">never</span>{{/if}}</td>
            <td class="sp-sync-sources__owns">{{owns.summary}}{{#if owns.marketplaces}}<br>{{#each owns.marketplaces}}<span class="sp-u-mono">{{this}}</span> {{/each}}{{/if}}</td>
            <td>
                <div class="sp-sync-sources__badges">
                {{#each badges}}<span title="{{detail}}">{{> components/badge tone=tone text=text}}</span>{{/each}}
                </div>
                <details>
                    <summary class="sp-u-text-tertiary">how to pin</summary>
                    <pre class="sp-sync-pin">{{pin_command}}
owner key for rules.yaml: {{owner_key}}</pre>
                </details>
            </td>
        </tr>
        {{/each}}
        </tbody>
    {{/components/table}}
    {{#unless sources.bundles}}
    <p class="sp-u-text-tertiary">No remote bundles are pinned in this profile's <code class="sp-code-inline">services.sources</code>; the instance serves the baked tree alone.</p>
    {{/unless}}
    {{#if sources.refresh_hint}}
    <details>
        <summary class="sp-u-text-tertiary">Refresh from a terminal</summary>
        <pre class="sp-sync-pin">{{sources.refresh_hint}}</pre>
    </details>
    {{/if}}

    {{#each planes}}
    <section class="sp-sync-plane" data-plane="{{id}}" aria-labelledby="plane-{{id}}">
        <div class="sp-sync-plane__head">
            <h2 id="plane-{{id}}">{{label}}</h2>
            <div class="sp-sync-plane__meta">
                <span><code class="sp-code-inline">services/{{source_file}}</code> → <code class="sp-code-inline">{{projection}}</code></span>
                <span><strong>{{declared_count}}</strong> declared · <strong>{{in_db}}</strong> in this database</span>
                {{#if declared_hash}}<span>declared <span class="sp-sync-hash" title="{{declared_hash.full}}">{{declared_hash.short}}</span></span>{{/if}}
                {{#if applied}}
                <span>last applied <span class="sp-sync-hash" title="{{applied.hash.full}}">{{applied.hash.short}}</span> by <strong>{{applied.by}}</strong> {{relativeTime applied.at}} ({{applied.mode}})</span>
                {{#if applied.declared_changed}}{{> components/badge tone="warn" text="declaration changed since last apply"}}{{/if}}
                {{else}}
                <span class="sp-u-text-tertiary">never applied from code on this database</span>
                {{/if}}
            </div>
        </div>

        {{#if unreadable}}
        {{> components/notice tone="err" title="The declaration could not be read" message=unreadable}}
        {{/if}}

        <div class="sp-kpi-grid" aria-label="{{label}} drift totals">
            {{#each kpis}}
            {{> components/kpi label=label value=value note=note tone=tone}}
            {{/each}}
        </div>

        {{#if is_clean}}
        {{> components/notice tone="ok" title="In step" message="The declaration and this database hold the same rows. Export if you want the file regenerated from the database anyway."}}
        {{/if}}

        <div class="sp-sync-actions" aria-label="Synchronise {{label}}">
            <article class="sp-sync-card">
                <h3>Insert only</h3>
                <p>Add every row the file declares that the database lacks. Touch nothing else — rows that differ or exist only here stay as they are.</p>
                <p class="sp-sync-card__count">{{actions.insert}} rows, {{actions.insert_entities}} entities</p>
                {{#if ../can_write}}<button type="button" class="sp-btn sp-btn--secondary" data-action="sync" data-plane="{{id}}" data-mode="insert_only" data-count="{{actions.insert}}">Insert only</button>{{/if}}
            </article>
            <article class="sp-sync-card sp-sync-card--danger">
                <h3>Overwrite from code</h3>
                <p>Make the database equal the file for every entity the file names: insert what is missing, correct what differs, and <strong>delete</strong> rows on those entities that the file does not declare. Entities the file does not mention, and every per-person override, are left alone.</p>
                <p class="sp-sync-card__count">+{{actions.insert}} · ~{{actions.update}} · −{{actions.delete}} ({{actions.delete_console}} written from the console)</p>
                {{#if ../can_write}}<button type="button" class="sp-btn sp-btn--primary" data-action="sync" data-plane="{{id}}" data-mode="overwrite" data-count="{{actions.delete}}" data-dashboard="{{actions.delete_console}}">Overwrite from code</button>{{/if}}
            </article>
            <article class="sp-sync-card">
                <h3>Export from dashboard</h3>
                <p>Render this database as <code class="sp-code-inline">{{source_file}}</code>. Commit it in the source repository and the code is back in step with what the console decided.</p>
                <p class="sp-sync-card__count">{{in_db}} rows</p>
                <button type="button" class="sp-btn sp-btn--outline" data-action="export" data-plane="{{id}}" data-file="{{source_file}}">Export</button>
            </article>
        </div>

        {{#> components/section title="Differences" count=row_count note="Each line is one disagreement between the file and this database, and which action would resolve it."}}
            {{#*inline "section_actions"}}
            {{#if entity_filter}}<a class="sp-btn sp-btn--sm sp-btn--outline" href="/admin/sync">Show all entities</a>{{/if}}
            {{/inline}}
        {{/components/section}}

        {{#if rows}}
        {{#> components/table caption="Differences between the declaration and the database" modifier="sp-p-ac__diff"}}
            <thead><tr>
                <th>Difference</th>
                <th>Entity</th>
                <th>Band · subject</th>
                <th>In code</th>
                <th>In this database</th>
                <th>Written by</th>
                <th>Insert only</th>
                <th>Overwrite</th>
            </tr></thead>
            <tbody>
            {{#each rows}}
            <tr data-diff="{{kind}}" data-entity-type="{{entity_type}}" data-entity-id="{{entity_id}}">
                <td>{{> components/badge tone=kind_tone text=kind_label}}</td>
                <td><span class="sp-ac-entity__kind">{{entity_type_label}}</span> <span class="sp-u-mono">{{entity_id}}</span></td>
                <td><span class="sp-ac-layer-tag">{{band_label}}</span> <span class="sp-u-mono">{{subject}}</span></td>
                <td class="sp-u-text-secondary">{{in_code}}</td>
                <td class="sp-u-text-secondary">{{in_db}}</td>
                <td>{{#if origin}}{{> components/badge tone=origin_tone text=origin}}{{else}}<span class="sp-u-text-tertiary">—</span>{{/if}}</td>
                <td>{{#if insert_applies}}inserted{{else}}<span class="sp-u-text-tertiary">no change</span>{{/if}}</td>
                <td>{{#if overwrite_applies}}{{overwrite_effect}}{{else}}<span class="sp-u-text-tertiary">{{overwrite_effect}}</span>{{/if}}</td>
            </tr>
            {{/each}}
            </tbody>
        {{/components/table}}
        {{else}}
        {{#unless is_clean}}
        {{> components/empty-state title="Nothing to show" message="No difference matches this entity."}}
        {{/unless}}
        {{/if}}
    </section>
    {{/each}}

    <dialog class="sp-dialog sp-ac-dialog" data-dialog="confirm" aria-labelledby="sync-confirm-title">
        <div class="sp-ac-dialog__header">
            <h2 id="sync-confirm-title" data-sync="confirm-title">Confirm</h2>
            <button type="button" class="sp-ac-dialog__close" data-action="close-dialog" aria-label="Close">&times;</button>
        </div>
        <div class="sp-ac-dialog__body">
            <p data-sync="confirm-body"></p>
            <p class="sp-ac-modal-hint">The change is recorded in the activity log with your name, the plane and the counts, and the sync state records the declared hash you applied.</p>
        </div>
        <div class="sp-ac-dialog__actions">
            <button type="button" class="sp-btn sp-btn--primary" data-action="confirm-sync">Apply</button>
            <button type="button" class="sp-btn sp-btn--outline" data-action="close-dialog">Cancel</button>
        </div>
    </dialog>

    <dialog class="sp-dialog sp-ac-dialog" data-dialog="export" aria-labelledby="sync-export-title">
        <div class="sp-ac-dialog__header">
            <h2 id="sync-export-title" data-sync="export-title">This database as its declaration</h2>
            <button type="button" class="sp-ac-dialog__close" data-action="close-dialog" aria-label="Close">&times;</button>
        </div>
        <div class="sp-ac-dialog__body">
            <p class="sp-ac-modal-hint">
                Replace the file in the source repository with this, commit, and redeploy.
                Lines starting <code class="sp-code-inline"># NOTE</code> name what could not be expressed and must be resolved by hand.
            </p>
            <pre class="sp-ac-yaml-pre" data-sync="export-content"><span class="sp-loading">Loading…</span></pre>
        </div>
        <div class="sp-ac-dialog__actions">
            <button type="button" class="sp-btn sp-btn--secondary" data-action="copy-export">Copy</button>
            <a class="sp-btn sp-btn--secondary" data-sync="export-download" href="#" download>Download</a>
            <button type="button" class="sp-btn sp-btn--outline" data-action="close-dialog">Close</button>
        </div>
    </dialog>

    <dialog class="sp-dialog sp-ac-dialog" data-dialog="refresh" aria-labelledby="sync-refresh-title">
        <div class="sp-ac-dialog__header">
            <h2 id="sync-refresh-title">Import sources</h2>
            <button type="button" class="sp-ac-dialog__close" data-action="close-dialog" aria-label="Close">&times;</button>
        </div>
        <div class="sp-ac-dialog__body">
            <p data-sync="refresh-body">Re-fetch every pinned source, verify it, and recompose. If the composition changed, its entitlements are projected and the skill inventory refreshed in place — the running process serves the new tree without a restart. The profile's pins are never rewritten.</p>
            <pre class="sp-ac-yaml-pre" data-sync="refresh-result" hidden></pre>
        </div>
        <div class="sp-ac-dialog__actions">
            <button type="button" class="sp-btn sp-btn--primary" data-action="confirm-refresh">Import</button>
            <button type="button" class="sp-btn sp-btn--outline" data-action="close-dialog">Close</button>
        </div>
    </dialog>

    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-sync.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
