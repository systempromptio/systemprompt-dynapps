{{#> layout page_title=title page_id=page}}
    {{#*inline "content"}}
    {{> components/breadcrumbs crumbs=breadcrumbs}}

    <div class="sp-p-doc" data-drive-document="{{document_api}}" data-document-api="{{document_api}}" data-documents-api="{{documents_api}}" data-revisions-api="{{revisions_api}}" data-presence-api="{{presence_api}}" data-preview-api="{{preview_url}}" data-projection-api="{{projection_api}}" data-edits-api="{{edits_api}}" data-people-api="{{people_api}}" data-content-url="{{content_url}}" data-user-id="{{user_id}}" data-my-access="{{my_access}}" data-can-edit="{{can_edit}}" data-can-share="{{can_share}}">

    <header class="sp-p-doc__head">
        <div class="sp-p-doc__ident">
            <span class="sp-p-doc__badge" data-slot="doc-badge">…</span>
            <label class="sp-u-sr-only" for="doc-name">Document name</label>
            <input class="sp-p-doc__name" id="doc-name" data-slot="doc-name" maxlength="200" autocomplete="off" spellcheck="false">
            <span class="sp-p-doc__status" data-slot="doc-status" data-field="save" aria-live="polite">Loading…</span>
        </div>
        <div class="sp-p-doc__actions">
            <div class="sp-p-doc__editors" data-slot="doc-editors" aria-label="People in this document"></div>
            <div class="sp-p-doc__modes" role="group" aria-label="Mode">
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="doc-edit" aria-pressed="true">Edit</button>
                <button type="button" class="sp-btn sp-btn--sm sp-btn--outline" data-action="doc-preview" aria-pressed="false">Preview</button>
            </div>
            <a class="sp-btn sp-btn--sm sp-btn--outline" href="{{content_url}}" download>Download</a>
            <button type="button" class="sp-btn sp-btn--sm sp-btn--ghost" data-action="doc-rail" aria-pressed="true" aria-controls="doc-rail">Details</button>
        </div>
    </header>

    <div class="sp-p-doc__body">
        <section class="sp-p-doc__stage" aria-label="Document">
            <p class="sp-p-doc__banner" data-slot="doc-banner" hidden>
                <span data-slot="doc-banner-text"></span>
                <button type="button" class="sp-btn sp-btn--xs sp-btn--outline" data-action="doc-current">Back to current</button>
            </p>
            <div class="sp-p-doc__desk">
                <div class="sp-p-doc__canvas" data-slot="doc-canvas"></div>
                <iframe class="sp-p-doc__frame" sandbox title="Document preview" data-slot="doc-frame" hidden></iframe>
            </div>
            <p class="sp-p-doc__hint" data-slot="doc-hint"></p>
        </section>

        <aside class="sp-p-doc__rail" id="doc-rail" aria-label="Document details">
            <section class="sp-p-doc__card" aria-labelledby="doc-details-title">
                <h2 class="sp-p-doc__card-title" id="doc-details-title">Details</h2>
                <dl class="sp-p-doc__facts">
                    <div><dt>Owner</dt><dd data-field="owner">—</dd></div>
                    <div><dt>Location</dt><dd data-field="folder">—</dd></div>
                    <div><dt>Created</dt><dd data-field="created">—</dd></div>
                    <div><dt>Updated</dt><dd data-field="updated">—</dd></div>
                    <div><dt>Template</dt><dd data-field="template">—</dd></div>
                    <div><dt>Document id</dt><dd class="sp-u-mono" data-field="id">{{document_id}}</dd></div>
                </dl>
            </section>
            <section class="sp-p-doc__card" aria-labelledby="doc-activity-title">
                <h2 class="sp-p-doc__card-title" id="doc-activity-title">Activity</h2>
                <ol class="sp-p-doc__feed" data-slot="doc-activity"></ol>
            </section>
            <section class="sp-p-doc__card" aria-labelledby="doc-sharing-title">
                <h2 class="sp-p-doc__card-title" id="doc-sharing-title">Sharing</h2>
                <div class="sp-ws__pane" data-pane-mount="sharing"></div>
            </section>
            <section class="sp-p-doc__card" aria-labelledby="doc-comments-title">
                <h2 class="sp-p-doc__card-title" id="doc-comments-title">Comments</h2>
                <div class="sp-ws__pane" data-pane-mount="comments"></div>
            </section>
            <section class="sp-p-doc__card" aria-labelledby="doc-proposals-title">
                <h2 class="sp-p-doc__card-title" id="doc-proposals-title">Proposals</h2>
                <div class="sp-ws__pane" data-pane-mount="proposals"></div>
            </section>
        </aside>
    </div>
    </div>

    <template data-template="doc-activity-item">
      <li class="sp-p-doc__event">
        <span class="sp-p-doc__avatar" data-field="initials"></span>
        <span class="sp-p-doc__event-body">
          <span class="sp-p-doc__event-who" data-field="who"></span>
          <span class="sp-p-doc__event-what" data-field="what"></span>
          <span class="sp-p-doc__event-when" data-field="when"></span>
        </span>
        <button type="button" class="sp-btn sp-btn--xs sp-btn--ghost" data-action="doc-revision">View</button>
      </li>
    </template>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/pages/admin-drive-document.js?v={{css_version}}"></script>
    {{/inline}}
{{/layout}}
