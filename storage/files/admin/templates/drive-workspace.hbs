{{#> workspace-layout page_title=title page_id=page}}
    {{#*inline "content"}}
    <div class="sp-ws" data-ws-root data-doc-stream="/api/v1/stream/agui" data-document-api="{{document_api}}" data-documents-api="{{documents_api}}" data-base-url="{{base_url}}" data-blocks-url="{{blocks_url}}" data-content-url="{{content_url}}" data-preview-api="{{preview_url}}" data-revisions-api="{{revisions_api}}" data-presence-api="{{presence_api}}" data-projection-api="{{projection_api}}" data-people-api="{{people_api}}" data-access-api="{{access_api}}" data-user-id="{{user_id}}" data-my-access="{{my_access}}" data-can-edit="{{can_edit}}" data-can-share="{{can_share}}">
    <header class="sp-ws__bar">
        <a class="sp-ws__home" href="{{base_url}}" aria-label="Back to Drive" title="Drive">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>
        </a>
        <div class="sp-ws__title">
            <button class="sp-ws__name" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="ws-name-menu" data-action="ws-name-menu">
                <span data-field="name">Loading…</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4z"/></svg>
            </button>
            <ul class="sp-ws__menu" id="ws-name-menu" role="menu" aria-label="Document" data-slot="ws-menu" hidden></ul>
        </div>
        <span class="sp-ws__badge sp-ws__format" data-field="format"></span>
        <span class="sp-ws__save" data-field="save" role="status" aria-live="polite">Saved</span>
        <span class="sp-ws__spacer"></span>
        <ul class="sp-ws__presence" data-slot="ws-presence" aria-label="People in this document"></ul>
        <button class="sp-btn sp-btn--sm sp-btn--ghost" type="button" data-command="comments" aria-pressed="false">Comments</button>
        <button class="sp-btn sp-btn--sm sp-btn--outline sp-ws__present" type="button" data-command="present" hidden>Present</button>
        <button class="sp-btn sp-btn--sm sp-btn--ghost" type="button" data-command="details" aria-pressed="false">Details</button>
        <button class="sp-btn sp-btn--sm sp-btn--primary" type="button" data-command="share">Share</button>
        {{> components/notification-bell}}
    </header>
    <div class="sp-ws__revoked" data-slot="ws-revoked" role="alert" hidden>
        Your access to this document was removed. <a href="{{base_url}}">Back to Drive</a>
    </div>
    <div class="sp-ws__body" data-slot="ws-body">
        <nav class="sp-ws__rail" aria-label="Document navigation">
            <h2 class="sp-ws__rail-title" data-field="rail-title">Outline</h2>
            <ol class="sp-ws__outline" data-slot="ws-outline"></ol>
            <p class="sp-ws__muted" data-slot="ws-outline-empty" hidden>Nothing to navigate yet.</p>
        </nav>
        <main class="sp-ws__canvas" id="main" data-slot="ws-editor">
            <iframe class="sp-ws__paper" sandbox title="Document" data-slot="ws-paper"></iframe>
        </main>
        {{> workspace/drawer}}
    </div>
    {{> workspace/palette}}
    {{> workspace/rows}}
    </div>
    {{/inline}}
    {{#*inline "scripts"}}
    <script data-cfasync="false" type="module" src="/js/workspace/shell.js?v={{css_version}}"></script>
    {{/inline}}
{{/workspace-layout}}
