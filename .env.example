# At least one of these is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required on first boot: the administrator `admin setup` creates.
SYSTEMPROMPT_ADMIN_EMAIL=

# Optional — auto-generated on first boot if left blank.
JWT_SECRET=

# Optional — defaults shown.
HTTP_PORT=8080
PG_PORT=5432
POSTGRES_PASSWORD=systemprompt

# Which published image to run (docs/install/docker.md). `latest` follows main;
# pin a release with its version, e.g. 0.42.0.
SYSTEMPROMPT_TAG=latest

# Public URL the gateway is reached at (sets api_external_url + CORS). Leave
# blank on a laptop; set it on a server, e.g. https://gateway.example.com
EXTERNAL_URL=

# Remote Postgres instead of the bundled container: set this and start only
# the app service (`docker compose up -d app`).
# DATABASE_URL=postgres://user:pass@db-host:5432/systemprompt
