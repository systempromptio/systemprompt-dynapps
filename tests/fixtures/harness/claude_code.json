{
  "client": "claude-code",
  "inbound": "anthropic.messages",
  "headers": {
    "anthropic-version": "2023-06-01",
    "anthropic-beta": "claude-code-20250219,interleaved-thinking-2025-05-14,context-management-2025-06-27,fine-grained-tool-streaming-2025-05-14",
    "user-agent": "claude-cli/2.1.283 (external, cli)",
    "x-app": "cli"
  },
  "body": {
    "model": "claude-sonnet-4-5",
    "max_tokens": 32000,
    "stream": false,
    "system": [
      {"type": "text", "text": "You are Claude Code, Anthropic's official CLI for Claude."},
      {"type": "text", "text": "Working directory: /workspace/sample", "cache_control": {"type": "ephemeral"}}
    ],
    "thinking": {"type": "enabled", "budget_tokens": 8000},
    "context_management": {"edits": [{"type": "clear_tool_uses_20250919"}]},
    "metadata": {"user_id": "user_0000_account__session_00000000-0000-4000-8000-000000000001"},
    "tools": [
      {"name": "Bash", "description": "Run a shell command", "input_schema": {"type": "object", "properties": {"command": {"type": "string"}}, "required": ["command"]}},
      {"name": "Read", "description": "Read a file", "input_schema": {"type": "object", "properties": {"file_path": {"type": "string"}}, "required": ["file_path"]}}
    ],
    "messages": [
      {"role": "user", "content": [{"type": "text", "text": "<system-reminder>environment block</system-reminder>"}, {"type": "text", "text": "Which files are in src?"}]},
      {"role": "assistant", "content": [
        {"type": "thinking", "thinking": "List the directory first.", "signature": "sig_fixture_one"},
        {"type": "tool_use", "id": "toolu_01", "name": "Bash", "input": {"command": "ls src"}}
      ]},
      {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_01", "content": "lib.rs\nmain.rs"}]},
      {"role": "assistant", "content": [
        {"type": "text", "text": "Reading both."},
        {"type": "tool_use", "id": "toolu_02", "name": "Read", "input": {"file_path": "src/lib.rs"}},
        {"type": "tool_use", "id": "toolu_03", "name": "Read", "input": {"file_path": "src/main.rs"}}
      ]},
      {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "toolu_02", "content": [{"type": "text", "text": "pub fn lib() {}"}]},
        {"type": "tool_result", "tool_use_id": "toolu_03", "content": [{"type": "text", "text": "fn main() {}"}]},
        {"type": "text", "text": "Summarise them.", "cache_control": {"type": "ephemeral"}}
      ]}
    ]
  }
}
