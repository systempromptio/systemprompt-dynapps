{
  "db_name": "PostgreSQL",
  "query": "SELECT id, session_id, user_id, host, criterion, attempt, status, score_source, score, model, provider,\n                  input_tokens, output_tokens, cost_microdollars, latency_ms, error, created_at,\n                  count(*) OVER () AS \"total!\"\n             FROM evaluation_runs\n            WHERE ($1::text IS NULL OR criterion = $1)\n              AND ($2::text IS NULL OR status = $2)\n              AND ($3::text IS NULL OR host = $3)\n              AND ($4::text IS NULL OR session_id = $4)\n            ORDER BY created_at DESC, id\n            LIMIT $5 OFFSET $6",
