  "query": "SELECT\n                u.id AS \"user_id!: UserId\",\n                COALESCE(u.display_name, u.full_name, u.name) AS display_name,\n                u.email AS \"email?: Email\"\n            FROM users u\n            WHERE u.id = ANY($1) AND u.account_kind <> 'service'",
