  "db_name": "PostgreSQL",
  "query": "-- The model calls of one farm task: every ai_requests row of its gateway\n-- session ($1 = usage.gateway_session_id), oldest first, at most $2.\nSELECT id,\n       created_at,\n       model,\n       status,\n       request_kind,\n       input_tokens,\n       output_tokens,\n       cache_read_tokens,\n       cache_creation_tokens,\n       cost_microdollars,\n       latency_ms\nFROM ai_requests\nWHERE session_id = $1\nORDER BY created_at, id\nLIMIT $2\n",
