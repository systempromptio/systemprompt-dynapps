  "db_name": "PostgreSQL",
  "query": "SELECT id, thread_id, role, info, parts, seq, created_at, completed_at\n             FROM dynwork_chat_messages\n             WHERE thread_id = $1\n               AND ($2::text IS NULL OR seq < (\n                   SELECT seq FROM dynwork_chat_messages WHERE thread_id = $1 AND id = $2))\n             ORDER BY seq DESC\n             LIMIT $3",
