  "query": "SELECT id, policy, tool_name, user_id AS \"user_id!: UserId\", reason,\n                  trace_id, created_at\n           FROM governance_decisions\n           WHERE decision = 'warn' AND created_at >= $1 AND created_at < $2\n           ORDER BY created_at DESC\n           LIMIT $3",
