  "query": "SELECT\n             c.user_id AS \"user_id!: UserId\",\n             u.email AS \"email?\",\n             u.display_name AS \"display_name?\",\n             c.credential,\n             c.label,\n             c.created_at,\n             c.verified_at,\n             c.last_used_at\n           FROM user_provider_credentials c\n           LEFT JOIN users u ON u.id = c.user_id\n           ORDER BY u.email NULLS LAST, c.credential",
