  "query": "WITH pending AS (SELECT id FROM feedback_ingestion_outbox WHERE pending AND next_attempt<=clock_timestamp() AND (lease_until IS NULL OR lease_until<=clock_timestamp()) ORDER BY next_attempt,id LIMIT $1 FOR UPDATE SKIP LOCKED) UPDATE feedback_ingestion_outbox q SET lease_token=$2,lease_until=clock_timestamp()+interval '60 seconds',attempts=q.attempts+1 FROM pending WHERE q.id=pending.id RETURNING q.id,q.revision,q.lease_until",
