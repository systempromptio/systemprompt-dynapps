<?xml version="1.0" encoding="UTF-8"?>
<!--
  Admin-owned policy, deployed to every org after install (scripts/install.sh
  does it; it lives outside force-app because policies are not packageable).
  AllSelfAuthorized: a login in this org IS the entitlement — anyone without a
  user here is refused by Salesforce at consent, and the hosted MCP server
  enforces each user's own object permissions. Tighten to
  AdminApprovedPreAuthorized in Setup if an org wants an explicit allow-list.
-->
<ExtlClntAppOauthConfigurablePolicies xmlns="http://soap.sforce.com/2006/04/metadata">
    <externalClientApplication>Systemprompt</externalClientApplication>
    <ipRelaxationPolicyType>Enforce</ipRelaxationPolicyType>
    <isClientCredentialsFlowEnabled>false</isClientCredentialsFlowEnabled>
    <isGuestCodeCredFlowEnabled>false</isGuestCodeCredFlowEnabled>
    <isTokenExchangeFlowEnabled>false</isTokenExchangeFlowEnabled>
    <label>Systemprompt_oauthPlcy</label>
    <permittedUsersPolicyType>AllSelfAuthorized</permittedUsersPolicyType>
    <refreshTokenPolicyType>SpecificLifetime</refreshTokenPolicyType>
    <refreshTokenValidityPeriod>90</refreshTokenValidityPeriod>
    <refreshTokenValidityUnit>Days</refreshTokenValidityUnit>
    <requiredSessionLevel>STANDARD</requiredSessionLevel>
</ExtlClntAppOauthConfigurablePolicies>
