# template-version: 0.66.0
# Dynapps profile template for self-hosted, multi-node deployments.
# Rendered by deploy/self-host/render-profile.sh; @TOKENS@ are substituted.
# Every node runs this exact file. The provider catalog and gateway routes are
# not here: they ship inside the image (services/ai/providers.yaml,
# services/ai/gateway.yaml), so this file carries only what differs per
# deployment. The template-version line pins it to the image release.

name: self-host
display_name: Self-hosted
target: local
site:
  name: Dynapps
  github_link: null
database:
  type: postgres
  external_db_access: false
  # Nodes never migrate on boot: with three nodes sharing one primary, the
  # schema moves forward once, from one place, before any node runs the new
  # image. Run the one-shot step first (README.md §5 and §6):
  #   docker compose -f docker-compose.node.yml run --rm app migrate
  # (inside a container: systemprompt infra db migrate --profile self-host).
  # A node that boots against a schema it does not match refuses to start and
  # names the pending migration and that command.
  migrate_on_boot: false
server:
  host: 0.0.0.0
  port: 8080
  # Prometheus /metrics listener (gateway_overhead_seconds,
  # gateway_upstream_duration_seconds and the rest). Same host, separate port,
  # no auth: the compose files expose it on the internal network only, never
  # publish it. Remove the line to turn the listener off.
  metrics_port: 9090
  api_server_url: @EXTERNAL_URL@
  api_internal_url: http://localhost:8080
  api_external_url: @EXTERNAL_URL@
  use_https: true
  cors_allowed_origins:
  - @EXTERNAL_URL@
  - https://claude.ai
  content_negotiation:
    enabled: false
    markdown_suffix: .md
  security_headers:
    enabled: true
    hsts: max-age=63072000; includeSubDomains; preload
    frame_options: DENY
    content_type_options: nosniff
    referrer_policy: strict-origin-when-cross-origin
    permissions_policy: camera=(), microphone=(), geolocation=()
    content_security_policy: null
  instance_id: null
  # all: gateway, admin console, MCP, scheduler — the launch topology runs
  # every node the same. `gateway` serves only /v1, the bridge, OAuth and
  # health and runs no workers; `admin` is everything except the gateway.
  role: all
  # Concurrent requests one node accepts; past it the node answers 503 with
  # Retry-After: 1 and /readyz reports `saturated`, so the balancer moves
  # traffic instead of the node queueing until it falls over. Sized for the
  # 2 vCPU / 4 GB floor with long-lived streams; raise it with the node.
  max_in_flight: 512
  max_concurrent_streams: 256
  trusted_proxies:
@TRUSTED_PROXIES@
paths:
  system: /app
  services: /app/services
  bin: /app/bin
  web_path: /app/web
  storage: /app/storage
  geoip_database: null
# Uploaded and generated files. `local` writes under paths.storage/files on
# each node. To keep them in a Cloud Storage bucket every node sees, replace
# this block with (the identity needs roles/storage.objectAdmin on the bucket):
#   storage:
#     backend: gcs
#     bucket: <bucket>
#     prefix: dynapps/files          # optional
#     credentials: workload_identity # or { secret: GCS_SERVICE_ACCOUNT_KEY }
# paths.storage is still required with gcs: the gateway journal, exports and
# scratch space stay on the node's disk.
storage:
  backend: local
# Composed services bundles are cached here; with a read-only root it is a
# per-node volume (README.md, Read-only root filesystem).
services:
  cache_dir: /app/services-cache
security:
  jwt_issuer: @EXTERNAL_URL@
  jwt_access_token_expiration: 2592000
  jwt_refresh_token_expiration: 15552000
  jwt_audiences:
  - web
  - api
  - a2a
  - mcp
  allowed_resource_audiences:
  - hook
  allow_registration: false
  signing_key_path: signing_key.pem
  id_jag_ttl_secs: 300
rate_limits:
  # Requests per second per client address, one bucket per route group. Every
  # knob below names the group it governs; nothing here is a global cap.
  disabled: false
  # /api/v1/core/oauth (public), /auth/link-passkey, /api/public/gateway
  oauth_public_per_second: 10
  # /api/v1/core/oauth (authenticated), /api/v1/core/users
  oauth_auth_per_second: 10
  # /api/v1/core/contexts, /api/v1/webhook
  contexts_per_second: 100
  # /api/v1/core/tasks
  tasks_per_second: 50
  # /api/v1/core/artifacts
  artifacts_per_second: 50
  # /api/v1/agents/registry — discovery only, so listing agents cannot spend
  # the execution budget below.
  agent_registry_per_second: 50
  # /api/v1/agents execution, plus the Slack and Teams inbound mounts
  agents_per_second: 20
  # /api/v1/mcp/registry — the MCP server catalog, discovery only
  mcp_registry_per_second: 50
  # /api/v1/mcp — MCP tool calls, the busiest protocol group
  mcp_per_second: 200
  # /api/v1/stream — long-lived SSE connections, so a connection budget
  stream_per_second: 100
  # /api/v1/content, /api/v1/sync, /api/v1/marketplace, /api/v1/analytics,
  # /track/engagement
  content_per_second: 50
  # The /v1 gateway: /v1/messages and /v1/chat/completions. Bucketed by client
  # address, not by user, so size it for a network rather than for a person.
  gateway_per_second: 100
  # /v1/auth/bridge/*, deliberately its own budget: sign-in must stay
  # reachable on an instance whose inference traffic is saturating its own.
  bridge_auth_per_second: 20
  burst_multiplier: 3
system_admin:
  username: admin
  email: @ADMIN_EMAIL@
runtime:
  environment: production
  log_level: normal
  output_format: json
  no_color: true
  non_interactive: true
secrets:
  secrets_path: ./secrets.json
  validation: strict
  source: file
extensions:
  disabled: []
# The installation's authz hook runs in-process (registered by the binary), so
# no node posts its decisions to /api/public/govern/authz over HTTP.
governance:
  authz:
    hook:
      mode: extension
      url: null
      timeout_ms: 500
      acknowledgement: null
# Retention windows for the tables that grow with traffic, applied nightly by
# database_cleanup. Named explicitly so a default change in the image never
# silently changes what this deployment keeps; every key is optional.
retention:
  logs_days: 14
  analytics_events_days: 30
  ai_request_messages_days: 30
  ai_request_payload_raw_days: 7
  governance_decisions_days: 180
  mcp_tool_executions_days: 180
  outbox_processed_days: 7
