# Core's mock inference server (crates/tests/mock-inference, its own cargo
# workspace) as a small image for the load-test rig. Build context is that
# crate directory in the sibling core checkout:
#   docker build -f deploy/loadtest/kind/Dockerfile.mock \
#     -t astound-loadtest/mock-inference:local ../systemprompt-core/crates/tests/mock-inference
FROM rust:1.90-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked && strip target/release/mock-inference

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/mock-inference /usr/local/bin/mock-inference
USER 65532
EXPOSE 9100
ENTRYPOINT ["/usr/local/bin/mock-inference"]
