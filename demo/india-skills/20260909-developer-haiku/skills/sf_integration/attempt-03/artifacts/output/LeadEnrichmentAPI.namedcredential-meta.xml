<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <awsAccessKey>false</awsAccessKey>
    <awsAccessSecret>false</awsAccessSecret>
    <awsAssumeRoleArn/>
    <awsExternalId/>
    <awsRegion/>
    <awsStsArnFormat/>
    <awsStsAssumeRoleSessionDuration/>
    <label>Lead Enrichment API</label>
    <oauthClientCredentialFlow>false</oauthClientCredentialFlow>
    <oauthScope/>
    <oauthTokenEndpoint/>
    <password>{!$Credential.LeadEnrichmentPassword}</password>
    <principalType>PerUser</principalType>
    <privateKeyFile/>
    <protocol>Password</protocol>
    <url>https://enrichment-api.example.com</url>
    <username>{!$Credential.LeadEnrichmentUsername}</username>
</NamedCredential>
