{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkedIn Content Manager Template Placeholders",
  "description": "Schema de templates para gestión de contenido LinkedIn. Los templates son ejemplos visuales sin placeholders dinámicos.",
  "templates": {
    "post-preview-card.html": {
      "description": "Componente visual para previsualizar posts de LinkedIn antes de publicar. Template de ejemplo con datos hardcodeados.",
      "placeholders": {},
      "notes": "Este template no usa placeholders dinámicos. Es un componente visual de referencia para crear previews de posts.",
      "structure": {
        "funnel_badge": {
          "description": "Badge que indica la fase del funnel",
          "values": ["TOFU", "MOFU", "BOFU"],
          "css_classes": ["tofu", "mofu", "bofu"]
        },
        "visual_placeholder": {
          "description": "Área para describir el visual del post",
          "fields": ["visual_type", "dimensions", "tool"]
        },
        "post_content": {
          "description": "Contenido del post",
          "fields": ["hook", "body_text", "cta"]
        },
        "post_footer": {
          "description": "Metadata del post",
          "fields": ["engagement_estimate", "post_type"]
        },
        "comment_preview": {
          "description": "Preview del primer comentario (opcional)",
          "fields": ["comment_label", "comment_text"]
        }
      },
      "css_reference": {
        "funnel_colors": {
          "tofu": "#8AC2DB",
          "mofu": "#6B68FA",
          "bofu": "#E5B92B"
        },
        "engagement_levels": {
          "high": "#10B981 (verde)",
          "medium": "#F59E0B (amarillo)",
          "low": "#EF4444 (rojo)"
        }
      }
    },
    "weekly-linkedin-report.html": {
      "description": "Reporte semanal de contenido LinkedIn con dashboard bento, posts planificados, series y rendimiento.",
      "placeholders": {},
      "notes": "Template de ejemplo con datos de muestra. Usar como referencia visual para crear reportes semanales.",
      "structure": {
        "header": {
          "description": "Cabecera con título, fechas y stats globales",
          "fields": ["week_dates", "total_posts", "funnel_mix", "active_series"]
        },
        "funnel_mix_card": {
          "description": "Barra visual de distribución TOFU/MOFU/BOFU",
          "fields": ["tofu_count", "mofu_count", "bofu_count"]
        },
        "week_schedule": {
          "description": "Vista de calendario semanal (Lun-Vie)",
          "fields": ["day_slots con fecha, día y funnel"]
        },
        "post_cards": {
          "description": "Cards individuales por post planificado",
          "fields": ["funnel_badge", "day_label", "visual_placeholder", "post_preview", "post_type", "engagement_badge"]
        },
        "series_card": {
          "description": "Progreso de series activas",
          "fields": ["series_name", "progress_bar", "timeline_steps"]
        },
        "performance_card": {
          "description": "Métricas de semana anterior",
          "fields": ["posts con impresiones, engagement, clics"]
        },
        "ideas_bank": {
          "description": "Ideas para próximas semanas",
          "fields": ["idea_chips con funnel y título"]
        },
        "notes_card": {
          "description": "Notas y recordatorios",
          "fields": ["bullet_list de notas"]
        }
      },
      "data_example": {
        "week": "10-14 Feb 2025",
        "posts": 5,
        "mix": "2/2/1",
        "series": 1
      }
    },
    "content-calendar.html": {
      "description": "Calendario mensual de contenido estilo Kanban con posts por día y series activas.",
      "placeholders": {},
      "notes": "Template de ejemplo con datos de muestra. Calendario visual para planificación mensual.",
      "structure": {
        "header": {
          "description": "Cabecera con navegación de mes y leyenda de colores",
          "fields": ["current_month", "nav_buttons", "legend_items"]
        },
        "calendar_grid": {
          "description": "Grid 7 columnas (Lun-Dom) con celdas por día",
          "fields": ["day_number", "post_entries", "other_month_flag", "weekend_flag", "today_flag"]
        },
        "post_entry": {
          "description": "Entrada de post en una celda",
          "fields": ["funnel_class", "post_funnel", "post_title", "post_type", "published_flag"]
        },
        "calendar_footer": {
          "description": "Stats del mes",
          "fields": ["total_planned", "total_published", "funnel_breakdown", "active_series"]
        },
        "series_section": {
          "description": "Timeline de series activas",
          "fields": ["series_name", "timeline_steps con semana, funnel, fecha, estado"]
        }
      },
      "css_reference": {
        "post_entry_classes": {
          "tofu": "border-left azul cielo",
          "mofu": "border-left lila",
          "bofu": "border-left amarillo",
          "published": "opacity 0.7 + dot verde"
        },
        "calendar_cell_classes": {
          "other-month": "Día de mes anterior/siguiente",
          "weekend": "Sábado/Domingo",
          "today": "Día actual resaltado"
        }
      }
    }
  },
  "scripts": {
    "discover_content.py": {
      "description": "Escanea fuentes de contenido para inspiración de posts",
      "arguments": {
        "--sources": "all, odoo, reddit, internal (separados por coma)",
        "--days": "Número de días hacia atrás a escanear (default: 7)",
        "--output": "Formato de salida: text, json, html"
      },
      "sources": {
        "odoo": ["Odoo News RSS", "Odoo Blog RSS"],
        "reddit": "r/Odoo new posts",
        "internal": ["Casos de éxito", "Episodios podcast", "Actualizaciones"]
      },
      "output": "Lista de contenido categorizado por relevancia y fuente"
    }
  },
  "content_strategy": {
    "funnel_phases": {
      "TOFU": {
        "color": "#8AC2DB",
        "objective": "Awareness, alcance máximo",
        "formats": ["Opinión", "Carousel", "Quote", "Píldora educativa"],
        "cta": "Pregunta abierta, invitar a comentar"
      },
      "MOFU": {
        "color": "#6B68FA",
        "objective": "Consideración, engagement, credibilidad",
        "formats": ["Caso de éxito", "Behind scenes", "Promo podcast", "Cultura"],
        "cta": "Link en comentarios, invitar a seguir"
      },
      "BOFU": {
        "color": "#E5B92B",
        "objective": "Decisión, conversión, leads",
        "formats": ["Diagnóstico", "Evento", "Demo", "Resultados ROI"],
        "cta": "Link a Calendly, landing, registro"
      }
    },
    "weekly_distribution": {
      "recommended": "5 posts/semana",
      "mix": {
        "TOFU": "40% (2 posts)",
        "MOFU": "40% (2 posts)",
        "BOFU": "20% (1 post)"
      }
    },
    "series_pattern": {
      "description": "Serie de 3 semanas para nurturing",
      "weeks": [
        {"week": 1, "funnel": "TOFU", "goal": "Introducir problema/tema"},
        {"week": 2, "funnel": "MOFU", "goal": "Mostrar solución con caso real"},
        {"week": 3, "funnel": "BOFU", "goal": "CTA a diagnóstico/demo"}
      ]
    }
  }
}
