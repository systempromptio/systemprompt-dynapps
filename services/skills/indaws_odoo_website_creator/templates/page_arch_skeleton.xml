<!--
  page_arch_skeleton.xml — Minimal valid QWeb `arch` for an Odoo website page view.

  This is the value of the `arch` field of the `ir.ui.view` record (type='qweb') that a
  `website.page` points to via `view_id`. The `t-name` MUST equal the view `key`.

  Placeholders (replace before pushing):
    {{VIEW_KEY}}   e.g. "website.page_mi_landing"  (must match the ir.ui.view `key`)
    {{PAGE_NAME}}  human label, e.g. "Mi Landing"
    {{SECTIONS}}   the snippet sections (see snippet-catalog.md / builder-safe-transformations.md)

  The two non-negotiable wrappers:
    1. <t t-call="website.layout">  → injects the theme header + footer.
    2. <div id="wrap" class="oe_structure"> → the editable drop zone the Website Builder needs.
  Without both, the page renders but is NOT editable block-by-block in the builder.
-->
<t t-name="{{VIEW_KEY}}" name="{{PAGE_NAME}}">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty">
            <!-- {{SECTIONS}} — each block is a <section class="s_… pt40 pb40"
                 data-snippet="s_…" data-name="…"> with container/row/col Bootstrap grid. -->
        </div>
    </t>
</t>
