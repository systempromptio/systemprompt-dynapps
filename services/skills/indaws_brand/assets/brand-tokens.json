{
  "brand": "Indaws",
  "colors": {
    "warm_yellow": {
      "hex": "#E5B92B",
      "rgb": [229, 185, 43],
      "pantone": "123 C",
      "css_var": "--indaws-warm-yellow",
      "use": "Accents, CTAs, highlights"
    },
    "blue_lilac": {
      "hex": "#6B68FA",
      "rgb": [107, 104, 250],
      "pantone": "2725 C",
      "css_var": "--indaws-blue-lilac",
      "use": "Digital, titles, innovation"
    },
    "blue_space": {
      "hex": "#1C265D",
      "rgb": [28, 38, 93],
      "pantone": "289 C",
      "css_var": "--indaws-blue-space",
      "use": "Dark backgrounds, body text, formal"
    },
    "light_sky": {
      "hex": "#8AC2DB",
      "rgb": [138, 194, 219],
      "pantone": null,
      "css_var": "--indaws-light-sky",
      "use": "Support, light backgrounds"
    }
  },
  "gradients": {
    "blue": {
      "value": "linear-gradient(135deg, #6B68FA 0%, #8AC2DB 100%)",
      "from": "blue_lilac",
      "to": "light_sky"
    },
    "yellow": {
      "value": "linear-gradient(135deg, #8AC2DB 0%, #E5B92B 100%)",
      "from": "light_sky",
      "to": "warm_yellow"
    },
    "rule": "Always dark to light. NEVER light-to-dark."
  },
  "typography": {
    "font_family": "Montserrat",
    "fallback": "Verdana, sans-serif",
    "weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    },
    "elements": {
      "h1_h2": { "weight": 700, "transform": "uppercase", "color": "blue_lilac" },
      "h3_h4": { "weight": 600, "transform": "none", "color": "blue_space" },
      "body": { "weight": 400, "transform": "none", "color": "blue_space" },
      "cta": { "weight": 700, "transform": "uppercase", "color": "blue_space", "bg": "warm_yellow" }
    }
  },
  "logo": {
    "preferred": "Full logotype (text + symbol)",
    "isotype_for": "avatars, favicons, decorative elements",
    "placement": "4 corners or absolute center ONLY",
    "clear_space": "Width of letter N",
    "min_digital_logo": "70px",
    "min_digital_isotype": "20px",
    "min_print_logo": "24mm",
    "min_print_isotype": "6mm",
    "prohibitions": ["stretching", "shadows", "recoloring"]
  },
  "hard_rules": {
    "zero_emojis": true,
    "address": "professional tu (NEVER usted)",
    "gradient_direction": "dark to light only",
    "logo_placement": "4 corners or absolute center only"
  }
}
