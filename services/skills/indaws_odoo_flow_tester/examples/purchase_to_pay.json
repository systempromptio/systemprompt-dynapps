{
  "flow_id": "CHAIN_PURCHASE_TO_PAY",
  "flow_name": "Compra nacional completa",
  "description": "Crear orden de compra, confirmar, recibir mercancia, crear factura proveedor, publicar y pagar",
  "odoo_version": "18.0",
  "environment": "staging",
  "data": {
    "supplier_name": "Suministros Industriales Martinez S.L.",
    "product_name": "Tornillo Hexagonal M10x50 Inox",
    "qty": 500,
    "price_unit": 0.45
  },
  "preconditions": [
    {
      "model": "res.partner",
      "domain": [["name", "ilike", "Suministros Industriales Martinez"], ["supplier_rank", ">", 0]],
      "fields": ["id", "name"],
      "save_as": "supplier_id",
      "min_records": 1
    },
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Tornillo Hexagonal M10"], ["purchase_ok", "=", true]],
      "fields": ["id", "name", "standard_price"],
      "save_as": "product_id",
      "min_records": 1
    },
    {
      "model": "account.journal",
      "domain": [["type", "=", "purchase"]],
      "fields": ["id", "name"],
      "save_as": "purchase_journal_id",
      "min_records": 1
    },
    {
      "model": "account.journal",
      "domain": [["type", "=", "bank"]],
      "fields": ["id", "name"],
      "save_as": "bank_journal_id",
      "min_records": 1
    }
  ],
  "steps": [
    {
      "step": 1,
      "name": "Crear orden de compra",
      "action": "create",
      "model": "purchase.order",
      "values": {
        "partner_id": "{pre.supplier_id}",
        "partner_ref": "{data.test_prefix}",
        "order_line": [[0, 0, {
          "product_id": "{pre.product_id}",
          "product_qty": "{data.qty}",
          "price_unit": "{data.price_unit}"
        }]]
      },
      "save_as": "purchase_order_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 2,
      "name": "Confirmar orden de compra",
      "action": "execute",
      "model": "purchase.order",
      "method": "button_confirm",
      "ids": ["{result.purchase_order_id}"],
      "verify": {"field": "state", "expected": "purchase"}
    },
    {
      "step": 3,
      "name": "Detectar albaran de recepcion",
      "action": "search",
      "model": "stock.picking",
      "domain": [["origin", "=", "{result.purchase_order_name}"], ["picking_type_code", "=", "incoming"]],
      "fields": ["id", "name", "state", "move_ids", "move_line_ids"],
      "save_as": "picking_id",
      "verify": {"field": "state", "expected_any": ["confirmed", "assigned"]}
    },
    {
      "step": 3.1,
      "name": "Reservar stock de recepcion",
      "action": "execute",
      "model": "stock.picking",
      "method": "action_assign",
      "ids": ["{result.picking_id}"],
      "verify": {"field": "state", "expected": "assigned"}
    },
    {
      "step": 3.2,
      "name": "Establecer cantidades recibidas (move_line_ids.quantity + move_ids.picked)",
      "action": "multi_update",
      "operations": [
        {
          "model": "stock.move.line",
          "ids": ["{result.picking_move_line_ids}"],
          "values": {"quantity": "{data.qty}"}
        },
        {
          "model": "stock.move",
          "ids": ["{result.picking_move_ids}"],
          "values": {"picked": true}
        }
      ],
      "note": "En Odoo 18: campo 'quantity' en stock.move.line (NO 'qty_done'). Campo 'picked' en stock.move indica procesado."
    },
    {
      "step": 4,
      "name": "Validar recepcion de mercancia",
      "action": "execute",
      "model": "stock.picking",
      "method": "button_validate",
      "ids": ["{result.picking_id}"],
      "context": {"skip_backorder": true, "picking_ids_not_to_backorder": ["{result.picking_id}"]},
      "verify": {"field": "state", "expected": "done"}
    },
    {
      "step": 4.1,
      "name": "Establecer cantidades recibidas en lineas de OC",
      "action": "update",
      "model": "purchase.order.line",
      "ids": ["{result.purchase_order_line_id}"],
      "values": {"qty_received": "{data.qty}"},
      "note": "Normalmente se actualiza automaticamente al validar el picking, pero se puede forzar via API"
    },
    {
      "step": 5,
      "name": "Crear factura de proveedor desde OC",
      "action": "execute",
      "model": "purchase.order",
      "method": "action_create_invoice",
      "ids": ["{result.purchase_order_id}"],
      "note": "Metodo publico de purchase.order (a diferencia de sale.order que usa _create_invoices). Requiere qty_to_invoice > 0.",
      "detect_cascade": {
        "model": "account.move",
        "domain": [["ref", "=", "{result.purchase_order_name}"], ["move_type", "=", "in_invoice"]],
        "save_as": "invoice_id"
      },
      "verify": {"field": "state", "expected": "draft", "model": "account.move", "id": "{result.invoice_id}"}
    },
    {
      "step": 6,
      "name": "Publicar factura de proveedor",
      "action": "execute",
      "model": "account.move",
      "method": "action_post",
      "ids": ["{result.invoice_id}"],
      "verify": {"field": "state", "expected": "posted"}
    },
    {
      "step": 7,
      "name": "Crear pago a proveedor",
      "action": "create",
      "model": "account.payment",
      "values": {
        "payment_type": "outbound",
        "partner_type": "supplier",
        "partner_id": "{pre.supplier_id}",
        "amount": "{result.purchase_order_amount_total}",
        "journal_id": "{pre.bank_journal_id}",
        "ref": "{data.test_prefix}",
        "date": "{today}"
      },
      "save_as": "payment_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 8,
      "name": "Confirmar pago a proveedor",
      "action": "execute",
      "model": "account.payment",
      "method": "action_post",
      "ids": ["{result.payment_id}"],
      "verify": {"field": "state", "expected_any": ["in_process", "paid"]}
    }
  ],
  "revert": [
    {"step": 8, "action": "execute", "model": "account.payment", "method": "action_cancel", "ids": ["{result.payment_id}"]},
    {"step": 7, "action": "delete", "model": "account.payment", "ids": ["{result.payment_id}"]},
    {"step": 6, "action": "execute", "model": "account.move", "method": "button_draft", "ids": ["{result.invoice_id}"]},
    {"step": 5, "action": "execute", "model": "account.move", "method": "button_cancel", "ids": ["{result.invoice_id}"]},
    {"step": 5, "action": "delete", "model": "account.move", "ids": ["{result.invoice_id}"]},
    {"step": 4, "action": "return_picking", "model": "stock.picking", "ids": ["{result.picking_id}"]},
    {"step": 2, "action": "execute", "model": "purchase.order", "method": "button_cancel", "ids": ["{result.purchase_order_id}"]},
    {"step": 1, "action": "delete", "model": "purchase.order", "ids": ["{result.purchase_order_id}"]}
  ]
}
