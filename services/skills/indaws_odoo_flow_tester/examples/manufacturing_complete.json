{
  "flow_id": "CHAIN_MRP_COMPLETE",
  "flow_name": "Fabricacion completa con entrega",
  "description": "Verificar BoM, crear orden de fabricacion, reservar componentes, producir, marcar como hecho y entregar producto terminado",
  "odoo_version": "18.0",
  "environment": "staging",
  "data": {
    "product_name": "Silla Ergonomica Pro X200",
    "product_qty": 10,
    "component_1_name": "Estructura Acero Cromado",
    "component_1_qty": 10,
    "component_2_name": "Asiento Tapizado Negro",
    "component_2_qty": 10,
    "component_3_name": "Ruedas Silenciosas Pack 5",
    "component_3_qty": 10
  },
  "preconditions": [
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Silla Ergonomica Pro"], ["type", "=", "product"]],
      "fields": ["id", "name", "type"],
      "save_as": "finished_product_id",
      "min_records": 1
    },
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Estructura Acero"], ["type", "=", "product"]],
      "fields": ["id", "name"],
      "save_as": "component_1_id",
      "min_records": 1
    },
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Asiento Tapizado"], ["type", "=", "product"]],
      "fields": ["id", "name"],
      "save_as": "component_2_id",
      "min_records": 1
    },
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Ruedas Silenciosas"], ["type", "=", "product"]],
      "fields": ["id", "name"],
      "save_as": "component_3_id",
      "min_records": 1
    },
    {
      "model": "mrp.bom",
      "domain": [["product_tmpl_id.name", "ilike", "Silla Ergonomica Pro"]],
      "fields": ["id", "product_tmpl_id", "bom_line_ids"],
      "save_as": "bom_id",
      "min_records": 1,
      "note": "Si no existe BoM, se creara una en el paso 1"
    },
    {
      "model": "stock.warehouse",
      "domain": [["active", "=", true]],
      "fields": ["id", "name", "lot_stock_id"],
      "save_as": "warehouse_id",
      "min_records": 1
    },
    {
      "model": "stock.location",
      "domain": [["usage", "=", "production"]],
      "fields": ["id", "name"],
      "save_as": "production_location_id",
      "min_records": 1
    }
  ],
  "steps": [
    {
      "step": 1,
      "name": "Verificar o crear lista de materiales",
      "action": "search",
      "model": "mrp.bom",
      "domain": [["product_tmpl_id.name", "ilike", "Silla Ergonomica Pro"]],
      "fields": ["id", "product_tmpl_id", "bom_line_ids"],
      "save_as": "bom_id",
      "fallback_create": {
        "model": "mrp.bom",
        "values": {
          "product_tmpl_id": "{pre.finished_product_id.product_tmpl_id}",
          "product_qty": 1,
          "code": "{data.test_prefix}",
          "bom_line_ids": [
            [0, 0, {"product_id": "{pre.component_1_id}", "product_qty": 1}],
            [0, 0, {"product_id": "{pre.component_2_id}", "product_qty": 1}],
            [0, 0, {"product_id": "{pre.component_3_id}", "product_qty": 1}]
          ]
        }
      }
    },
    {
      "step": 2,
      "name": "Crear orden de fabricacion",
      "action": "create",
      "model": "mrp.production",
      "values": {
        "product_id": "{pre.finished_product_id}",
        "bom_id": "{result.bom_id}",
        "product_qty": "{data.product_qty}",
        "product_uom_id": "{pre.finished_product_id.uom_id}",
        "origin": "{data.test_prefix}"
      },
      "save_as": "production_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 3,
      "name": "Confirmar orden de fabricacion",
      "action": "execute",
      "model": "mrp.production",
      "method": "action_confirm",
      "ids": ["{result.production_id}"],
      "verify": {"field": "state", "expected": "confirmed"}
    },
    {
      "step": 4,
      "name": "Reservar componentes",
      "action": "execute",
      "model": "mrp.production",
      "method": "action_assign",
      "ids": ["{result.production_id}"],
      "verify": {"field": "reservation_state", "expected": "assigned"},
      "note": "Si no hay stock suficiente, reservation_state sera 'waiting' o 'confirmed'. El test puede continuar igualmente"
    },
    {
      "step": 5,
      "name": "Detectar movimientos de componentes",
      "action": "search",
      "model": "stock.move",
      "domain": [["raw_material_production_id", "=", "{result.production_id}"]],
      "fields": ["id", "product_id", "product_uom_qty", "state"],
      "save_as": "raw_move_ids",
      "verify": {"field": "count", "expected_min": 1}
    },
    {
      "step": 6,
      "name": "Registrar cantidad producida",
      "action": "update",
      "model": "mrp.production",
      "ids": ["{result.production_id}"],
      "values": {
        "qty_producing": "{data.product_qty}"
      },
      "verify": {"field": "qty_producing", "expected": "{data.product_qty}"}
    },
    {
      "step": 7,
      "name": "Marcar fabricacion como terminada",
      "action": "execute",
      "model": "mrp.production",
      "method": "button_mark_done",
      "ids": ["{result.production_id}"],
      "context": {"skip_backorder": true},
      "verify": {"field": "state", "expected": "done"}
    },
    {
      "step": 8,
      "name": "Verificar stock del producto terminado",
      "action": "execute",
      "model": "product.product",
      "method": "read",
      "ids": ["{pre.finished_product_id}"],
      "fields": ["qty_available"],
      "verify": {"field": "qty_available", "expected_min": "{data.product_qty}"},
      "note": "El stock del producto terminado debe haber aumentado en la cantidad producida"
    }
  ],
  "revert": [
    {
      "step": 8,
      "note": "Verificacion de stock — no requiere reversion"
    },
    {
      "step": 7,
      "action": "scrap",
      "model": "stock.scrap",
      "note": "MO done es PUNTO DE NO RETORNO. Para revertir stock, crear scrap del producto terminado",
      "values": {
        "product_id": "{pre.finished_product_id}",
        "scrap_qty": "{data.product_qty}",
        "production_id": "{result.production_id}"
      },
      "post_action": {
        "action": "execute",
        "model": "stock.scrap",
        "method": "action_validate"
      }
    },
    {
      "step": 2,
      "note": "Si MO esta en done, no se puede cancelar ni eliminar. El scrap del paso anterior compensa el stock"
    },
    {
      "step": 1,
      "action": "delete",
      "model": "mrp.bom",
      "ids": ["{result.bom_id}"],
      "condition": "only_if_created_during_test",
      "note": "Solo eliminar la BoM si fue creada durante el test (fallback_create)"
    }
  ]
}
