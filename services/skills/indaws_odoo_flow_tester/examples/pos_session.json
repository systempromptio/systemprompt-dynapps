{
  "flow_id": "CHAIN_POS_SESSION",
  "flow_name": "Sesion de punto de venta completa",
  "description": "Abrir sesion POS, crear pedido con pago, validar pedido, cerrar sesion y verificar asientos contables generados",
  "odoo_version": "18.0",
  "environment": "staging",
  "data": {
    "product_name": "Camiseta Algod\u00f3n Org\u00e1nico",
    "qty": 2,
    "price_unit": 29.90
  },
  "preconditions": [
    {
      "model": "pos.config",
      "domain": [["active", "=", true]],
      "fields": ["id", "name", "journal_id", "picking_type_id", "payment_method_ids"],
      "save_as": "config_id",
      "min_records": 1
    },
    {
      "model": "pos.payment.method",
      "domain": [],
      "fields": ["id", "name", "journal_id"],
      "save_as": "payment_method_id",
      "min_records": 1,
      "note": "Metodo de pago (Efectivo o Banco) asignado al punto de venta"
    },
    {
      "model": "product.product",
      "domain": [["available_in_pos", "=", true], ["sale_ok", "=", true], ["active", "=", true]],
      "fields": ["id", "name", "list_price"],
      "save_as": "product_id",
      "min_records": 1
    }
  ],
  "steps": [
    {
      "step": 1,
      "name": "Abrir sesion POS",
      "action": "execute",
      "model": "pos.config",
      "method": "open_ui",
      "ids": ["{pre.config_id}"],
      "detect_cascade": {
        "model": "pos.session",
        "domain": [["config_id", "=", "{pre.config_id}"], ["state", "=", "opened"]],
        "save_as": "session_id"
      },
      "note": "open_ui crea una pos.session si no existe una abierta para este config, y devuelve la accion de abrir la UI del POS"
    },
    {
      "step": 2,
      "name": "Crear pedido POS",
      "action": "create",
      "model": "pos.order",
      "values": {
        "session_id": "{result.session_id}",
        "lines": [[0, 0, {
          "product_id": "{pre.product_id}",
          "qty": "{data.qty}",
          "price_unit": "{data.price_unit}",
          "price_subtotal": "{calc.qty * price_unit}",
          "price_subtotal_incl": "{calc.qty * price_unit}"
        }]]
      },
      "save_as": "pos_order_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 3,
      "name": "Registrar pago del pedido POS",
      "action": "create",
      "model": "pos.payment",
      "values": {
        "pos_order_id": "{result.pos_order_id}",
        "payment_method_id": "{pre.payment_method_id}",
        "amount": "{result.pos_order_amount_total}"
      },
      "save_as": "pos_payment_id",
      "note": "El pago POS registra el cobro en el metodo de pago configurado"
    },
    {
      "step": 4,
      "name": "Validar pedido POS (marcar como pagado)",
      "action": "execute",
      "model": "pos.order",
      "method": "action_pos_order_paid",
      "ids": ["{result.pos_order_id}"],
      "verify": {"field": "state", "expected": "paid"}
    },
    {
      "step": 5,
      "name": "Cerrar sesion POS",
      "action": "execute",
      "model": "pos.session",
      "method": "action_pos_session_closing_control",
      "ids": ["{result.session_id}"],
      "verify": {"field": "state", "expected": "closed"},
      "note": "El cierre de sesion genera automaticamente los asientos contables de la sesion"
    },
    {
      "step": 6,
      "name": "Verificar asientos contables generados",
      "action": "search",
      "model": "account.move",
      "domain": [["ref", "like", "{result.session_name}"]],
      "fields": ["id", "name", "state", "ref", "amount_total"],
      "save_as": "session_move_ids",
      "verify": {"field": "state", "expected": "posted"},
      "note": "Los asientos se generan y publican automaticamente al cerrar la sesion"
    }
  ],
  "revert": [
    {
      "step": 6,
      "action": "noop",
      "note": "Asientos contables posted — si no tienen hash se pueden: button_draft -> button_cancel -> delete. Si tienen hash -> PUNTO DE NO RETORNO"
    },
    {
      "step": 5,
      "action": "noop",
      "note": "PUNTO DE NO RETORNO: Una sesion POS cerrada NO se puede reabrir"
    },
    {
      "step": 4,
      "action": "noop",
      "note": "Pedido pagado — solo se puede revertir con un refund POS. Crear pos.order con cantidades negativas referenciando el pedido original"
    },
    {
      "step": 3,
      "action": "noop",
      "note": "Pago incluido en el pedido — se revierte con el refund"
    },
    {
      "step": 2,
      "action": "delete",
      "model": "pos.order",
      "ids": ["{result.pos_order_id}"],
      "note": "Solo si state=='draft' (antes de pagar). Si ya pagado, usar refund"
    },
    {
      "step": 1,
      "action": "delete",
      "model": "pos.session",
      "ids": ["{result.session_id}"],
      "note": "Solo si state=='new_session' (nunca fue abierta). Si opened/closed, no se puede eliminar"
    }
  ]
}
