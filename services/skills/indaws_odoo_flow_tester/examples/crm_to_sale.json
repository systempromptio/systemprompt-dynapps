{
  "flow_id": "CHAIN_CRM_TO_CASH",
  "flow_name": "Oportunidad CRM hasta cobro completo",
  "description": "Crear oportunidad en CRM, avanzar por pipeline, generar presupuesto, confirmar venta, entregar, facturar y cobrar",
  "odoo_version": "18.0",
  "environment": "staging",
  "data": {
    "lead_name": "Proyecto renovacion oficinas",
    "expected_revenue": 15000.00,
    "partner_name": "Inversiones Levante S.A.",
    "product_name": "Servicio de Consultoria IT",
    "qty": 40,
    "price_unit": 375.00
  },
  "preconditions": [
    {
      "model": "res.partner",
      "domain": [["name", "ilike", "Inversiones Levante"], ["customer_rank", ">", 0]],
      "fields": ["id", "name"],
      "save_as": "partner_id",
      "min_records": 1
    },
    {
      "model": "product.product",
      "domain": [["name", "ilike", "Consultoria IT"], ["sale_ok", "=", true]],
      "fields": ["id", "name", "list_price"],
      "save_as": "product_id",
      "min_records": 1
    },
    {
      "model": "crm.stage",
      "domain": [],
      "fields": ["id", "name", "sequence"],
      "save_as": "crm_stages",
      "min_records": 3,
      "order": "sequence asc",
      "note": "Se necesitan al menos 3 stages para simular avance por pipeline"
    },
    {
      "model": "crm.team",
      "domain": [],
      "fields": ["id", "name"],
      "save_as": "sales_team_id",
      "min_records": 1
    },
    {
      "model": "account.journal",
      "domain": [["type", "=", "sale"]],
      "fields": ["id", "name"],
      "save_as": "sale_journal_id",
      "min_records": 1
    },
    {
      "model": "account.journal",
      "domain": [["type", "=", "bank"]],
      "fields": ["id", "name"],
      "save_as": "bank_journal_id",
      "min_records": 1
    }
  ],
  "steps": [
    {
      "step": 1,
      "name": "Crear oportunidad en CRM",
      "action": "create",
      "model": "crm.lead",
      "values": {
        "name": "{data.test_prefix} {data.lead_name}",
        "partner_id": "{pre.partner_id}",
        "expected_revenue": "{data.expected_revenue}",
        "team_id": "{pre.sales_team_id}",
        "type": "opportunity",
        "stage_id": "{pre.crm_stages[0].id}"
      },
      "save_as": "lead_id",
      "verify": {"field": "type", "expected": "opportunity"}
    },
    {
      "step": 2,
      "name": "Avanzar oportunidad a segunda etapa",
      "action": "update",
      "model": "crm.lead",
      "ids": ["{result.lead_id}"],
      "values": {
        "stage_id": "{pre.crm_stages[1].id}"
      },
      "verify": {"field": "stage_id", "expected": "{pre.crm_stages[1].id}"}
    },
    {
      "step": 3,
      "name": "Avanzar oportunidad a tercera etapa (propuesta)",
      "action": "update",
      "model": "crm.lead",
      "ids": ["{result.lead_id}"],
      "values": {
        "stage_id": "{pre.crm_stages[2].id}"
      },
      "verify": {"field": "stage_id", "expected": "{pre.crm_stages[2].id}"}
    },
    {
      "step": 4,
      "name": "Crear presupuesto desde oportunidad",
      "action": "create",
      "model": "sale.order",
      "values": {
        "partner_id": "{pre.partner_id}",
        "opportunity_id": "{result.lead_id}",
        "client_order_ref": "{data.test_prefix}",
        "order_line": [[0, 0, {
          "product_id": "{pre.product_id}",
          "product_uom_qty": "{data.qty}",
          "price_unit": "{data.price_unit}"
        }]]
      },
      "save_as": "sale_order_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 5,
      "name": "Confirmar pedido de venta",
      "action": "execute",
      "model": "sale.order",
      "method": "action_confirm",
      "ids": ["{result.sale_order_id}"],
      "verify": {"field": "state", "expected": "sale"}
    },
    {
      "step": 6,
      "name": "Detectar albaran de salida",
      "action": "search",
      "model": "stock.picking",
      "domain": [["origin", "=", "{result.sale_order_name}"], ["picking_type_code", "=", "outgoing"]],
      "fields": ["id", "name", "state"],
      "save_as": "picking_id",
      "verify": {"field": "state", "expected": "assigned"},
      "optional": true,
      "note": "Solo aplica si el producto es almacenable. Servicios no generan picking"
    },
    {
      "step": 7,
      "name": "Validar albaran",
      "action": "execute",
      "model": "stock.picking",
      "method": "button_validate",
      "ids": ["{result.picking_id}"],
      "context": {"skip_backorder": true, "picking_ids_not_to_backorder": ["{result.picking_id}"]},
      "verify": {"field": "state", "expected": "done"},
      "depends_on": "picking_id",
      "skip_if_missing": true
    },
    {
      "step": 8,
      "name": "Crear factura desde pedido",
      "action": "execute",
      "model": "sale.order",
      "method": "_create_invoices",
      "ids": ["{result.sale_order_id}"],
      "detect_cascade": {
        "model": "account.move",
        "domain": [["invoice_origin", "=", "{result.sale_order_name}"]],
        "save_as": "invoice_id"
      }
    },
    {
      "step": 9,
      "name": "Publicar factura",
      "action": "execute",
      "model": "account.move",
      "method": "action_post",
      "ids": ["{result.invoice_id}"],
      "verify": {"field": "state", "expected": "posted"}
    },
    {
      "step": 10,
      "name": "Crear pago del cliente",
      "action": "create",
      "model": "account.payment",
      "values": {
        "payment_type": "inbound",
        "partner_type": "customer",
        "partner_id": "{pre.partner_id}",
        "amount": "{result.sale_order_amount_total}",
        "journal_id": "{pre.bank_journal_id}",
        "ref": "{data.test_prefix}",
        "date": "{today}"
      },
      "save_as": "payment_id",
      "verify": {"field": "state", "expected": "draft"}
    },
    {
      "step": 11,
      "name": "Confirmar pago",
      "action": "execute",
      "model": "account.payment",
      "method": "action_post",
      "ids": ["{result.payment_id}"],
      "verify": {"field": "state", "expected_any": ["in_process", "paid"]}
    },
    {
      "step": 12,
      "name": "Marcar oportunidad como ganada",
      "action": "execute",
      "model": "crm.lead",
      "method": "action_set_won_rainbowman",
      "ids": ["{result.lead_id}"],
      "verify": {"field": "probability", "expected": 100}
    }
  ],
  "revert": [
    {"step": 12, "action": "execute", "model": "crm.lead", "method": "toggle_active", "ids": ["{result.lead_id}"], "note": "Reactivar si se archivo al ganar"},
    {"step": 11, "action": "execute", "model": "account.payment", "method": "action_cancel", "ids": ["{result.payment_id}"]},
    {"step": 10, "action": "delete", "model": "account.payment", "ids": ["{result.payment_id}"]},
    {"step": 9, "action": "execute", "model": "account.move", "method": "button_draft", "ids": ["{result.invoice_id}"]},
    {"step": 8, "action": "execute", "model": "account.move", "method": "button_cancel", "ids": ["{result.invoice_id}"]},
    {"step": 8, "action": "delete", "model": "account.move", "ids": ["{result.invoice_id}"]},
    {"step": 7, "action": "return_picking", "model": "stock.picking", "ids": ["{result.picking_id}"], "skip_if_missing": true},
    {"step": 5, "action": "execute", "model": "sale.order", "method": "action_cancel", "ids": ["{result.sale_order_id}"], "context": {"disable_cancel_warning": true}},
    {"step": 4, "action": "delete", "model": "sale.order", "ids": ["{result.sale_order_id}"]},
    {"step": 1, "action": "delete", "model": "crm.lead", "ids": ["{result.lead_id}"]}
  ]
}
