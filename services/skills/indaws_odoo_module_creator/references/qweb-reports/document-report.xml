<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Paper Format (optional — remove if A4 default is OK) -->
    <record id="paperformat_MODELNAME" model="report.paperformat">
        <field name="name">REPORT FORMAT NAME</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- 2. Report Action -->
    <record id="action_report_MODELNAME" model="ir.actions.report">
        <field name="name">REPORT TITLE</field>
        <field name="model">MODEL.NAME</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">MODULE_NAME.report_MODELNAME_document</field>
        <field name="report_file">MODULE_NAME.report_MODELNAME_document</field>
        <field name="binding_model_id" ref="MODULE.model_MODEL_NAME"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_MODELNAME"/>
        <field name="print_report_name">'Document - %s' % object.name</field>
    </record>

    <!-- 3. QWeb Template -->
    <template id="report_MODELNAME_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- === TITLE (v18+ style) === -->
                        <!-- For v14-v17, replace with: <h2><span t-field="doc.name"/></h2> -->
                        <t t-set="layout_document_title">
                            DOCUMENT TYPE <span t-field="doc.name"/>
                        </t>

                        <!-- === ADDRESSES === -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <div t-field="doc.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": true}'/>
                            </div>
                            <!-- Uncomment for shipping address:
                            <div class="col-6" t-if="doc.partner_shipping_id != doc.partner_id">
                                <strong>Delivery Address:</strong>
                                <div t-field="doc.partner_shipping_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": true}'/>
                            </div>
                            -->
                        </div>

                        <!-- === INFO BLOCK === -->
                        <div id="informations" class="row mt-4 mb-4">
                            <div class="col-auto" name="date">
                                <strong>Date:</strong>
                                <p t-field="doc.date_order" t-options='{"widget": "date"}'/>
                            </div>
                            <div class="col-auto" t-if="doc.origin" name="origin">
                                <strong>Source:</strong>
                                <p t-field="doc.origin"/>
                            </div>
                            <div class="col-auto" t-if="doc.user_id" name="salesperson">
                                <strong>Salesperson:</strong>
                                <p t-field="doc.user_id"/>
                            </div>
                        </div>

                        <!-- === LINE TABLE === -->
                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-start">Description</th>
                                    <th name="th_quantity" class="text-end">Quantity</th>
                                    <th name="th_uom" class="text-end">UoM</th>
                                    <th name="th_priceunit" class="text-end">Unit Price</th>
                                    <th name="th_subtotal" class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <!-- Section headers -->
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr>
                                            <td colspan="99">
                                                <strong t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Note lines -->
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr>
                                            <td colspan="99">
                                                <em t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Regular lines -->
                                    <t t-else="">
                                        <tr>
                                            <td name="td_description">
                                                <span t-field="line.name"/>
                                            </td>
                                            <td name="td_quantity" class="text-end">
                                                <span t-field="line.product_uom_qty"/>
                                            </td>
                                            <td name="td_uom" class="text-end">
                                                <span t-field="line.product_uom" groups="uom.group_uom"/>
                                            </td>
                                            <td name="td_priceunit" class="text-end">
                                                <span t-field="line.price_unit"
                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td name="td_subtotal" class="text-end">
                                                <span t-field="line.price_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- === TOTALS === -->
                        <div name="total_summary" class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Subtotal</strong></td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_untaxed"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Taxes</td>
                                        <td class="text-end">
                                            <span t-field="doc.amount_tax"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <strong>
                                                <span t-field="doc.amount_total"
                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- === NOTES === -->
                        <div t-if="doc.note" name="document_note" class="mt-4">
                            <span t-field="doc.note"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
