<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format for labels (example: 3 columns on A4) -->
    <record id="paperformat_labels" model="report.paperformat">
        <field name="name">Label Format (3 columns)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_labels" model="ir.actions.report">
        <field name="name">Print Labels</field>
        <field name="model">MODEL.NAME</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">MODULE_NAME.report_labels</field>
        <field name="report_file">MODULE_NAME.report_labels</field>
        <field name="binding_model_id" ref="MODULE.model_MODEL_NAME"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_labels"/>
    </record>

    <!-- QWeb Template — Labels use minimal_layout (no header/footer) -->
    <template id="report_labels">
        <t t-call="web.html_container">
            <t t-call="web.minimal_layout">
                <div class="page">
                    <style>
                        .label-container {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 2mm;
                        }
                        .label-item {
                            width: 62mm;
                            height: 30mm;
                            border: 1px solid #ccc;
                            padding: 2mm;
                            font-size: 8pt;
                            page-break-inside: avoid;
                            overflow: hidden;
                        }
                        .label-item .label-name {
                            font-weight: bold;
                            font-size: 9pt;
                            margin-bottom: 1mm;
                        }
                        .label-item .label-ref {
                            font-family: monospace;
                            font-size: 7pt;
                            color: #666;
                        }
                        .label-item .label-barcode {
                            text-align: center;
                            margin-top: 2mm;
                        }
                        .label-item .label-barcode img {
                            height: 12mm;
                        }
                    </style>

                    <div class="label-container">
                        <t t-foreach="docs" t-as="doc">
                            <div class="label-item">
                                <div class="label-name" t-field="doc.name"/>
                                <div class="label-ref">
                                    Ref: <span t-field="doc.default_code"/>
                                </div>
                                <div class="label-barcode" t-if="doc.barcode">
                                    <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=200&amp;height=40' % doc.barcode"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
