<!--
    Example XML configuration for loading a generated template into Odoo.

    This file shows:
    1. Custom docx.variable records (helper functions for the template)
    2. The docx.template record
    3. The ir.actions.report record
    4. Optional docx.parameter records

    Include this in your module's data/ directory and add to __manifest__.py 'data' list.
    Variables should be loaded BEFORE the template and report action.
-->
<odoo>

    <!-- ===================================================================
         1. CUSTOM VARIABLES (docx.variable)
         These inject functions/values into the template rendering context.
         Each MUST set a variable named 'value'.
         =================================================================== -->

    <!-- Global variable: Format full address from partner -->
    <record id="docx_variable_full_address" model="docx.variable">
        <field name="name">full_address</field>
        <!-- model_id omitted = global, available to ALL templates -->
        <field name="description">FUNCTION: Format complete address from a partner record, joining non-empty parts with newline.</field>
        <field name="python_code">
def full_address(partner, separator='\n'):
    parts = []
    if partner.street:
        parts.append(partner.street)
    if partner.street2:
        parts.append(partner.street2)
    city_line = ' '.join(filter(None, [partner.zip, partner.city]))
    if city_line:
        parts.append(city_line)
    if partner.state_id:
        parts.append(partner.state_id.name)
    if partner.country_id:
        parts.append(partner.country_id.name)
    return separator.join(parts)
value = full_address
        </field>
    </record>

    <!-- Global variable: Format phone number -->
    <record id="docx_variable_fmt_phone" model="docx.variable">
        <field name="name">fmt_phone</field>
        <field name="description">FUNCTION: Format Spanish phone number with spaces (e.g., 612 345 678).</field>
        <field name="python_code">
def fmt_phone(val):
    if not val:
        return ''
    clean = ''.join(c for c in str(val) if c.isdigit() or c == '+')
    if clean.startswith('+34'):
        clean = clean[3:]
    if len(clean) == 9:
        return '{} {} {}'.format(clean[:3], clean[3:6], clean[6:])
    return clean
value = fmt_phone
        </field>
    </record>

    <!-- Model-specific variable: Group sale order lines by section -->
    <record id="docx_variable_sale_grouped_lines" model="docx.variable">
        <field name="name">grouped_lines</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="description">FUNCTION: Group sale order lines by section headers. Returns list of dicts with 'name' and 'lines' keys.</field>
        <field name="python_code">
def grouped_lines(order):
    groups = []
    current = {'name': '', 'lines': [], 'notes': []}
    for line in order.order_line:
        if line.display_type == 'line_section':
            if current['lines']:
                groups.append(current)
            current = {'name': line.name, 'lines': [], 'notes': []}
        elif line.display_type == 'line_note':
            current['notes'].append(line.name)
        else:
            current['lines'].append(line)
    if current['lines']:
        groups.append(current)
    return groups
value = grouped_lines
        </field>
    </record>

    <!-- Model-specific variable: Sale order state label in Spanish -->
    <record id="docx_variable_sale_state_label" model="docx.variable">
        <field name="name">state_label</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="description">FUNCTION: Return human-readable state label in Spanish for sale.order.</field>
        <field name="python_code">
_LABELS = {
    'draft': 'Presupuesto',
    'sent': 'Presupuesto enviado',
    'sale': 'Pedido de venta',
    'done': 'Bloqueado',
    'cancel': 'Cancelado',
}
def state_label(state):
    return _LABELS.get(state, state or '')
value = state_label
        </field>
    </record>

    <!-- Model-specific variable: Line statistics summary -->
    <record id="docx_variable_sale_line_stats" model="docx.variable">
        <field name="name">line_stats</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="description">FUNCTION: Compute summary statistics for order lines (count, total_qty, has_discount).</field>
        <field name="python_code">
def line_stats(order):
    lines = order.order_line.filtered(lambda l: not l.display_type)
    return {
        'count': len(lines),
        'total_qty': sum(lines.mapped('product_uom_qty')),
        'has_discount': any(lines.mapped('discount')),
        'product_count': len(set(lines.mapped('product_id.id'))),
    }
value = line_stats
        </field>
    </record>

    <!-- ===================================================================
         2. DOCX TEMPLATE CONFIGURATION
         =================================================================== -->

    <record id="docx_template_sale_order_custom" model="docx.template">
        <field name="name">Custom Sale Order Template</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <!-- Language expression: eval'd to determine header/footer language variant -->
        <field name="lang">doc.partner_id.lang or 'es_ES'</field>
        <field name="docx_attachment_pos">bottom</field>
    </record>

    <!-- Header file: upload the generated .docx template here -->
    <!--
    <record id="docx_file_template_sale_header_es" model="docx.file.template">
        <field name="template_id" ref="docx_template_sale_order_custom"/>
        <field name="position">header</field>
        <field name="lang">es_ES</field>
        <field name="filename">template_sale_order.docx</field>
        <field name="file" type="base64"
               file="your_module/static/templates/template_sale_order.docx"/>
    </record>
    -->

    <!-- ===================================================================
         3. REPORT ACTION
         =================================================================== -->

    <record id="action_report_sale_order_docx" model="ir.actions.report">
        <field name="name">Sale Order (DOCX)</field>
        <field name="model">sale.order</field>
        <field name="report_type">docx</field>
        <field name="report_name">your_module.report_sale_order_docx</field>
        <field name="report_file">your_module.report_sale_order_docx</field>
        <field name="print_report_name">'SO_%s' % doc.name</field>
        <field name="docx_template_id" ref="docx_template_sale_order_custom"/>
        <field name="docx_output_filetype">pdf</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ===================================================================
         4. PARAMETERS (optional static config values)
         Accessed in template by name: {% if show_discount %}
         =================================================================== -->

    <record id="docx_param_show_discount" model="docx.parameter">
        <field name="name">show_discount</field>
        <field name="template_id" ref="docx_template_sale_order_custom"/>
        <field name="ttype">boolean</field>
        <field name="value_boolean" eval="True"/>
    </record>

    <record id="docx_param_show_images" model="docx.parameter">
        <field name="name">show_images</field>
        <field name="template_id" ref="docx_template_sale_order_custom"/>
        <field name="ttype">boolean</field>
        <field name="value_boolean" eval="False"/>
    </record>

    <record id="docx_param_footer_text" model="docx.parameter">
        <field name="name">footer_text</field>
        <field name="template_id" ref="docx_template_sale_order_custom"/>
        <field name="ttype">text</field>
        <field name="value_text">Gracias por confiar en nosotros.</field>
    </record>

</odoo>
