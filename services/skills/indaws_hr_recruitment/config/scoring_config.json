{
  "_description": "Configuracion de scoring de candidatos para hr-recruitment. Los pesos deben sumar 1.0. Las escalas definen los rangos de puntuacion por dimension.",
  "_version": "1.0.0",
  "_last_updated": "2026-03-08",
  "_approved_by": "RRHH Indaws",

  "weights": {
    "experience_match": 0.30,
    "skills_match": 0.25,
    "culture_fit": 0.20,
    "education": 0.15,
    "availability": 0.10
  },

  "classification": {
    "recommended": {
      "min_score": 75,
      "label": "Recomendado",
      "description": "Candidato fuerte, alineado con el perfil"
    },
    "consider": {
      "min_score": 50,
      "label": "Considerar",
      "description": "Candidato con potencial, requiere evaluacion adicional"
    },
    "not_recommended": {
      "min_score": 0,
      "label": "No recomendado",
      "description": "Desalineamiento significativo con el perfil"
    }
  },

  "experience_match": {
    "description": "Alineacion de la experiencia profesional con los requisitos del puesto",
    "scoring_rules": {
      "years_in_role": {
        "exceeds_by_2_plus": 100,
        "meets_requirement": 80,
        "within_1_year": 60,
        "within_2_years": 40,
        "below_minimum": 20
      },
      "industry_relevance": {
        "same_industry_erp_odoo": 100,
        "related_industry_tech": 75,
        "transferable_skills": 50,
        "different_industry": 25
      }
    }
  },

  "skills_match": {
    "description": "Match de competencias tecnicas y funcionales con el perfil del puesto",
    "scoring_rules": {
      "required_skills_met_pct": {
        "100_pct": 100,
        "75_to_99_pct": 80,
        "50_to_74_pct": 60,
        "25_to_49_pct": 40,
        "below_25_pct": 20
      },
      "bonus_skills": {
        "per_nice_to_have_skill": 5,
        "max_bonus": 20
      }
    }
  },

  "culture_fit": {
    "description": "Alineacion con los valores y cultura de Indaws",
    "scoring_rules": {
      "interview_scorecard_avg": {
        "4_of_4": 100,
        "3_of_4": 75,
        "2_of_4": 50,
        "1_of_4": 25
      },
      "dimensions": [
        "alineacion_valores",
        "motivacion_sector",
        "expectativas_realistas",
        "encaje_equipo"
      ]
    }
  },

  "education": {
    "description": "Nivel de formacion y certificaciones relevantes",
    "scoring_rules": {
      "degree_match": {
        "exact_match_required": 100,
        "related_degree": 75,
        "any_degree": 50,
        "no_degree_but_experience": 40,
        "no_degree_no_experience": 10
      },
      "certifications_bonus": {
        "odoo_certified": 15,
        "relevant_industry_cert": 10,
        "per_additional_cert": 5,
        "max_bonus": 25
      }
    }
  },

  "availability": {
    "description": "Disponibilidad temporal para incorporarse",
    "scoring_rules": {
      "start_date": {
        "immediate": 100,
        "within_2_weeks": 90,
        "within_1_month": 75,
        "within_2_months": 50,
        "more_than_2_months": 25
      },
      "location_flexibility": {
        "matches_requirement": 100,
        "willing_to_relocate": 75,
        "remote_only_when_office_preferred": 50,
        "no_flexibility": 25
      }
    }
  },

  "thresholds": {
    "auto_reject_below": 30,
    "fast_track_above": 85,
    "requires_additional_interview_below": 60
  }
}
