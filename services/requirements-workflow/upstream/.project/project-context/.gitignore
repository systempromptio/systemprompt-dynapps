# Project Context engine — what is (and isn't) committed.
#
# Committed & shared via git (hand-authored project memory):
#   inbox/meeting_notes/**  and  inbox/adrs/**  — the source docs themselves,
#   plus their .dates.json manifests (so the team shares identical LLM-derived
#   dates instead of re-running the model per clone).
#
# Everything below is regenerated locally by `npm run sync` / `npm run index`
# and must never be committed.

# Private, local-only sources: any file/dir whose name starts with `ignore`
# stays on the author's machine and is never committed or shared via git.
# Convention for keeping internal material (e.g. internal meeting notes) OUT of
# the shared RAG corpus — prefix the filename with `ignore`
# (e.g. `inbox/meeting_notes/ignore-internal-sync.md`).
ignore*
Ignore*
IGNORE*

# Dependencies
node_modules/

# Vector index (LanceDB, binary) — rebuilt from inbox by the indexer
.index/

# Atlassian incremental-sync cursor
.atlassian_sync_state.json

# Synced live from Atlassian (regenerated by `npm run sync`).
# Escape hatch: any filename containing `gitkeep` is kept in git, so a source
# with no Confluence/Jira page can be committed by hand (e.g. a legacy
# `ISD-store-locator.gitkeep.md`). This also keeps the `.gitkeep` dir markers.
inbox/confluence/*
inbox/jira/*
!inbox/confluence/*gitkeep*
!inbox/jira/*gitkeep*

# Materialized from the code repo's openspec/ tree (regenerated by the indexer)
inbox/specs/*
inbox/openspec_archive/*
!inbox/specs/.gitkeep
!inbox/openspec_archive/.gitkeep

# Text extracted from binary sources (PDF/DOCX) — rebuilt on index
inbox/**/*_normalized.txt
