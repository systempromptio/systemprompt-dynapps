# ─────────────────────────────────────────────────────────────────────────────
# Credentials — fill these in YOUR .env (this file is safe to commit; .env is not)
# ─────────────────────────────────────────────────────────────────────────────

# Get your Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Shared Bedrock API key (starts with ABSK...) — AWS console → Bedrock → API keys.
# Used by both Project Context and OpenSpec eval.
AWS_BEARER_TOKEN_BEDROCK=

# ─────────────────────────────────────────────────────────────────────────────
# Project defaults — populated during onboarding, shared via version control
# ─────────────────────────────────────────────────────────────────────────────

PROJECT_NAME={{PROJECT_NAME}}

# ── Atlassian ─────────────────────────────────────────────────────────────────
ATLASSIAN_BASE_URL={{ATLASSIAN_BASE_URL}}
JIRA_PROJECT_KEY={{JIRA_PROJECT_KEY}}
JIRA_BOARD_ID={{JIRA_BOARD_ID}}
CONFLUENCE_SPACE_KEY={{CONFLUENCE_SPACE_KEY}}

# Confluence parent pages for typed publishing (publish.mjs --type=fsd|isd).
# Discover page IDs from the URL: /wiki/spaces/<KEY>/pages/<ID>/...
CONFLUENCE_FSD_PARENT_ID=
CONFLUENCE_ISD_PARENT_ID=

# "Linked Jira Tickets" — the FSD/ISD page shows the Stories that link back to it,
# and create-stories creates those Confluence-content links. Discover both once:
#   node .cursor/skills/operate/atlassian/scripts/jira.mjs link-config <linked-issue-key>
# CONFLUENCE_APP_ID: the Confluence app id used in the remote-link globalId + macro JQL.
# CONFLUENCE_CLOUD_ID: the site cloudId that binds the page's Jira Issues macro.
CONFLUENCE_APP_ID=
CONFLUENCE_CLOUD_ID=

# Optional Jira automation config. Custom-field and option IDs are instance-specific —
# discover them via the Jira field metadata API during onboarding. Leave blank if unused.
# Sprint field defaults to the Jira Cloud standard; override only if your instance differs.
JIRA_SPRINT_FIELD_ID=customfield_10020
JIRA_EPIC_LINK_FIELD_ID=customfield_10014
# "Environment" select field id — surfaced in Jira exports if the project uses one.
JIRA_ENV_FIELD_ID=
# Assignee aliases -> accountId, e.g. {"FE":"<accountId>","BE":"<accountId>"}
JIRA_ASSIGNEE_MAP=
# Estimate custom fields id -> label (order preserved), e.g. {"customfield_10535":"FE","customfield_10504":"Total"}
JIRA_ESTIMATE_FIELDS=
# Extra text/option fields to surface in exports, id -> label
JIRA_EXTRA_FIELDS=

# ── Code repository ───────────────────────────────────────────────────────────
GITHUB_REPO={{GITHUB_REPO}}
# Active project code path, relative to the project root (where .cursor/ lives). "." = repo root.
# openspec/ lives here; init and /project-sync copy the schema/scaffold to <PROJECT_CODE_PATH>/openspec.
PROJECT_CODE_PATH={{PROJECT_CODE_PATH}}

# Legacy codebase (reference-only clone at project root, gitignored in the storefront repo).
# SSH first, HTTPS fallback. Leave blank if there is no legacy codebase to reference.
LEGACY_REPO={{LEGACY_REPO}}
LEGACY_BRANCH={{LEGACY_BRANCH}}

# ── SFCC (leave blank if not applicable) ──────────────────────────────────────
SFCC_SITE_ID={{SFCC_SITE_ID}}
SFCC_SITE_PREFIX={{SFCC_SITE_PREFIX}}

# ── Storefront Next SCAPI credentials (used to generate base-sf-next/.env) ────
# These populate base-sf-next/.env on every init/repair run so the reference
# clone boots against the real backend instead of the zzrf-001 demo org.
# Leave blank to keep the demo backend from .env.default.
SCAPI_CLIENT_ID={{SCAPI_CLIENT_ID}}
SCAPI_ORG_ID={{SCAPI_ORG_ID}}
SCAPI_SHORT_CODE={{SCAPI_SHORT_CODE}}
# MRT project slug and target environment for `pnpm push` in base-sf-next/.
MRT_PROJECT={{MRT_PROJECT}}
MRT_TARGET={{MRT_TARGET}}

# ── Project Context Bedrock ────────────────────────────────────────────────────
# Keep project-context in Frankfurt by default. Its retrieval/rerank stack can
# depend on Bedrock models that are available in eu-central-1 but not every EU region.
PROJECT_CONTEXT_BEDROCK_REGION=eu-central-1
# Optional: extra JQL for the Jira sync (project filter is added automatically). Leave blank to pull all issues.
JIRA_JQL=
# Include Confluence/Jira comments in the indexed documents (true/false).
ATLASSIAN_INCLUDE_COMMENTS=true

# ── OpenSpec Eval Bedrock ──────────────────────────────────────────────────────
# Eval is standalone and does not use the project-context reranker. It reuses
# AWS_BEARER_TOKEN_BEDROCK; model/region/max-token settings live in
# .project/eval/config.yaml because model availability depends on the chosen
# region and the tested generator/judge pair should be versioned with the eval.
