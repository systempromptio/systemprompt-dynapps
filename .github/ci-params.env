# The only CI file that differs between systemprompt-astound and
# systemprompt-dynapps. Every shared workflow, action, script and ci.just
# recipe reads its brand values from here; scripts/ci-sync-check.sh proves the
# rest are byte-identical. KEY=value, no quoting, no interpolation.
CI_REPO_NAME=systemprompt-dynapps
CI_GITHUB_REPO=systempromptio/systemprompt-dynapps
CI_IMAGE=ghcr.io/systempromptio/systemprompt-dynapps
CI_BRIDGE_PREFIX=dynapps-bridge
# Name of the repository secret holding the base-bundle signing seed.
CI_BUNDLE_SIGNING_SECRET_NAME=DYNAPPS_BUNDLE_SIGNING_SEED
CI_PRODUCT_NAME=Dynapps gateway
CI_BRIDGE_DISPLAY_NAME=Dynapps Bridge
CI_HOMEPAGE=https://www.dynapps.es
CI_RELEASE_GATE_EMAIL=ed@systemprompt.io
CI_RUNNER_IMAGE=false
# Server binaries the image ships in /app/bin (space-separated).
CI_SERVER_BINS=systemprompt systemprompt-mcp-agent systemprompt-mcp-agent-farm systemprompt-farm-worker
